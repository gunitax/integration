
// Загрузка товаров из сообщений топика Kafka в справочник Товары.
// Идентификация товара: по артикулу, при пустом артикуле - по штрихкоду.
//
#Область ПрограммныйИнтерфейс

// Читает порцию сообщений топика и записывает товары в справочник Товары.
// Смещения фиксируются в брокере только если вся порция обработана без ошибок.
//
// Параметры:
//  Адрес  - Строка - адреса брокеров Kafka, например "localhost:9092"
//  Группа - Строка - имя группы получателей
//  Топик  - Строка - имя топика, например "goods"
//
// Возвращаемое значение:
//  Структура - итоги: Прочитано, Создано, Обновлено, Пропущено, Ошибок
//
Функция ЗагрузитьТовары(Знач Адрес, Знач Группа, Знач Топик) Экспорт

	Итоги = Новый Структура("Прочитано, Создано, Обновлено, Пропущено, Ошибок", 0, 0, 0, 0, 0);

	Получатель = ИТШ_Шина.НовыйПолучатель(Адрес, Группа, Топик);
	Сообщения = ИТШ_Шина.ПрочитатьПул(Получатель);

	Для Каждого Сообщение Из Сообщения Цикл

		Итоги.Прочитано = Итоги.Прочитано + 1;

		Попытка
			ЗаписатьТовар(ТоварИзСообщения(Сообщение), Итоги);
		Исключение
			Итоги.Ошибок = Итоги.Ошибок + 1;
			ЗаписьЖурналаРегистрации("ИмпортТоваровИзШины.ЗагрузкаТоваров",
				УровеньЖурналаРегистрации.Ошибка,, , ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Если Итоги.Ошибок = 0 Тогда
		ИТШ_Шина.ЗафиксироватьСмещения(Получатель);
	КонецЕсли;

	Возврат Итоги;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТоварИзСообщения(Знач Сообщение)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Сообщение.Value);
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "Неверный формат тела сообщения";
	КонецЕсли;

	Возврат Данные;

КонецФункции

Процедура ЗаписатьТовар(Знач Данные, Знач Итоги)

	Артикул = СократитьСтроку(Данные.Артикул, 15);
	Штрихкод = СократитьСтроку(Данные.Штрихкод, 20);
	Наименование = СократитьСтроку(Данные.Наименование, 50);

	// Идентификация: артикул, затем штрихкод, затем наименование (идемпотентность обмена)
	ТоварСсылка = ТоварПоИдентификатору(Артикул, Штрихкод, Наименование);

	Если ТоварСсылка = Неопределено Тогда
		Если ПустаяСтрока(Наименование) Тогда
			Итоги.Пропущено = Итоги.Пропущено + 1;
			Возврат;
		КонецЕсли;
		Товар = Справочники.Товары.СоздатьЭлемент();
		Товар.Артикул = Артикул;
		Товар.Вид = Перечисления.ВидыТоваров.Товар;
		Итоги.Создано = Итоги.Создано + 1;
	Иначе
		Товар = ТоварСсылка.ПолучитьОбъект();
		Итоги.Обновлено = Итоги.Обновлено + 1;
	КонецЕсли;

	Товар.Наименование = Наименование;
	Товар.Штрихкод = Штрихкод;
	Товар.Описание = СтрокаИлиПусто(Данные.Описание);
	Товар.Записать();

КонецПроцедуры

Функция ТоварПоИдентификатору(Знач Артикул, Знач Штрихкод, Знач Наименование)

	Если Не ПустаяСтрока(Артикул) Тогда
		Возврат ТоварПоРеквизиту("Артикул", Артикул);
	ИначеЕсли Не ПустаяСтрока(Штрихкод) Тогда
		Возврат ТоварПоРеквизиту("Штрихкод", Штрихкод);
	ИначеЕсли Не ПустаяСтрока(Наименование) Тогда
		Возврат ТоварПоРеквизиту("Наименование", Наименование);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ТоварПоРеквизиту(Знач ИмяРеквизита, Знач Значение)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Товары.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Товары КАК Товары
		|ГДЕ
		|	Товары.%1 = &Значение", ИмяРеквизита);
	Запрос.УстановитьПараметр("Значение", Значение);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СократитьСтроку(Знач Значение, Знач Длина)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Значение = "";
	КонецЕсли;

	Возврат Лев(Значение, Длина);

КонецФункции

Функция СтрокаИлиПусто(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти
