
// HTTP-сервис состояния справочника Товары для сверки с базой-источником.
// GET /v1/goods возвращает JSON-массив элементов: {Артикул, Наименование, Штрихкод, Описание}.
//
Функция GoodsGET(Запрос)

	ЗапросТоваров = Новый Запрос;
	ЗапросТоваров.Текст =
	"ВЫБРАТЬ
	|	Товары.Артикул КАК Артикул,
	|	Товары.Наименование КАК Наименование,
	|	Товары.Штрихкод КАК Штрихкод,
	|	Товары.Описание КАК Описание
	|ИЗ
	|	Справочник.Товары КАК Товары
	|ГДЕ
	|	НЕ Товары.ЭтоГруппа
	|	И НЕ Товары.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Наименование";

	Выборка = ЗапросТоваров.Выполнить().Выбрать();

	ТоварыJSON = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Товар = Новый Структура;
		Товар.Вставить("Артикул", Выборка.Артикул);
		Товар.Вставить("Наименование", Выборка.Наименование);
		Товар.Вставить("Штрихкод", Выборка.Штрихкод);
		Товар.Вставить("Описание", Выборка.Описание);
		ТоварыJSON.Добавить(Товар);
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТоварыJSON);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8");

	Возврат Ответ;

КонецФункции

// GET /v1/orders: состояние заказов для сверки с базой-источником.
// Возвращает JSON-массив записей шапка+строка: заказ без строк - запись
// с НомерСтроки=0 и пустыми товарными полями.
//
Функция ЗаказыGET(Запрос)

	Попытка
		ЗаказыJSON = ЗаказыПоЗапросу();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ЗаказыJSON);

		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), "UTF-8");

		Возврат Ответ;
	Исключение
		ЗаписьЖурналаРегистрации("ИмпортТоваровИзШины.Заказы",
			УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());

		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки(), "UTF-8");

		Возврат Ответ;
	КонецПопытки;

КонецФункции

Функция ЗаказыПоЗапросу()

	ЗапросЗаказов = Новый Запрос;
	ЗапросЗаказов.Текст =
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка,
	|	Заказы.Номер КАК Номер,
	|	Заказы.Дата КАК Дата,
	|	Заказы.Организация.Наименование КАК Организация,
	|	Заказы.Покупатель.Наименование КАК Покупатель,
	|	Заказы.Валюта.Код КАК ВалютаКод,
	|	Заказы.Сумма КАК СуммаДокумента,
	|	0 КАК НомерСтроки,
	|	"""" КАК Номенклатура,
	|	"""" КАК Артикул,
	|	0 КАК Количество,
	|	0 КАК Цена,
	|	0 КАК СуммаСтроки
	|ИЗ
	|	Документ.Заказ КАК Заказы
	|ГДЕ
	|	НЕ Заказы.ПометкаУдаления
	|	И НЕ Заказы.Ссылка В
	|		(ВЫБРАТЬ
	|			Строки.Ссылка
	|		ИЗ
	|			Документ.Заказ.Товары КАК Строки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Товары.Ссылка,
	|	Товары.Ссылка.Номер,
	|	Товары.Ссылка.Дата,
	|	Товары.Ссылка.Организация.Наименование,
	|	Товары.Ссылка.Покупатель.Наименование,
	|	Товары.Ссылка.Валюта.Код,
	|	Товары.Ссылка.Сумма,
	|	Товары.НомерСтроки,
	|	Товары.Товар.Наименование,
	|	Товары.Товар.Артикул,
	|	Товары.Количество,
	|	Товары.Цена,
	|	Товары.Сумма
	|ИЗ
	|	Документ.Заказ.Товары КАК Товары
	|ГДЕ
	|	НЕ Товары.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер,
	|	НомерСтроки";

	Выборка = ЗапросЗаказов.Выполнить().Выбрать();

	ЗаказыJSON = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Номер", Выборка.Номер);
		Запись.Вставить("Дата", XMLСтрока(Выборка.Дата));
		Запись.Вставить("Организация", Выборка.Организация);
		Запись.Вставить("Покупатель", Выборка.Покупатель);
		Запись.Вставить("ВалютаКод", Выборка.ВалютаКод);
		Запись.Вставить("СуммаДокумента", Выборка.СуммаДокумента);
		Запись.Вставить("НомерСтроки", Выборка.НомерСтроки);
		Запись.Вставить("Номенклатура", Выборка.Номенклатура);
		Запись.Вставить("Артикул", Выборка.Артикул);
		Запись.Вставить("Количество", Выборка.Количество);
		Запись.Вставить("Цена", Выборка.Цена);
		Запись.Вставить("СуммаСтроки", Выборка.СуммаСтроки);
		ЗаказыJSON.Добавить(Запись);
	КонецЦикла;

	Возврат ЗаказыJSON;

КонецФункции
