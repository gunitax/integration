
// Обертка внешней компоненты librdkafka: чтение сообщений из топика Kafka.
// Компонента подключается из общих макетов расширения ИСШ_librdkafka_*.
//
#Область ПрограммныйИнтерфейс

// Создает получателя сообщений: подключает внешнюю компоненту, инициализирует
// и подписывает получателя на топик.
//
// Параметры:
//  Адрес  - Строка - адреса брокеров Kafka, например "localhost:9092"
//  Группа - Строка - имя группы получателей
//  Топик  - Строка - имя топика, например "invoices"
//
// Возвращаемое значение:
//  Произвольный - объект внешней компоненты AddIn.librdkafka.KafkaConsumer
//
Функция НовыйПолучатель(Знач Адрес, Знач Группа, Знач Топик) Экспорт

	ПодключитьВнешнююКомпонентуШины();

	Получатель = Новый("AddIn.librdkafka.KafkaConsumer");

	// Коммит смещений - только после успешной обработки порции
	Если Получатель.SetGlobalConf("enable.auto.commit", "false") <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "установки глобального параметра получателя");
	КонецЕсли;
	// Новая группа читает топик с начала
	Если Получатель.SetTopicConf("auto.offset.reset", "earliest") <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "установки параметра топика");
	КонецЕсли;

	Если Получатель.Initialize(Адрес, Группа) <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "инициализации получателя");
	КонецЕсли;

	Если Получатель.ClearSubscribeList() <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "очистки списка подписок");
	КонецЕсли;
	Если Получатель.AddTopicToSubscribeList(Топик) <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "добавления топика в список подписок");
	КонецЕсли;
	Если Получатель.Subscribe() <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "подписки на топик");
	КонецЕсли;

	Возврат Получатель;

КонецФункции

// Читает порцию сообщений топика в массив. Смещения не фиксируются -
// вызвать ЗафиксироватьСмещения после успешной обработки.
//
// Параметры:
//  Получатель - Произвольный - объект компоненты из НовыйПолучатель
//
// Возвращаемое значение:
//  Массив - структуры сообщений: Key, Value, Offset, Partition, Timestamp, Topic
//
Функция ПрочитатьПул(Знач Получатель) Экспорт

	Сообщения = Новый Массив;

	ЧтениеУспешно = (Получатель.ConsumePool(5000, 1000, 1) = 1);
	ОписаниеОшибки = "";
	Если Не ЧтениеУспешно Тогда
		ОписаниеОшибки = Получатель.ОписанниеОшибки;
	КонецЕсли;

	// Таймаут чтения и полный пул - не ошибки
	Таймаут = (ОписаниеОшибки = "Local: Timed out") Или (ОписаниеОшибки = "Local queue is full");
	Успешно = (Таймаут Или ЧтениеУспешно) И Не Получатель.FatalError;
	Если Не Успешно Тогда
		ВызватьИсключение СтрШаблон("Ошибка чтения сообщений Kafka: %1", ОписаниеОшибки);
	КонецЕсли;

	Если Получатель.GetMessagePoolLength() = 0 Тогда
		Возврат Сообщения;
	КонецЕсли;

	СообщенияJSON = Получатель.ReceiveJSONMessages(Ложь);
	Если СообщенияJSON = Неопределено Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "чтения сообщений из пула");
	КонецЕсли;

	Если Получатель.ClearMessagePool() <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "очистки пула сообщений");
	КонецЕсли;

	Возврат МассивИзJSON(СообщенияJSON);

КонецФункции

// Фиксирует прочитанные смещения разделов в брокере.
//
// Параметры:
//  Получатель - Произвольный - объект компоненты из НовыйПолучатель
//
Процедура ЗафиксироватьСмещения(Знач Получатель) Экспорт

	Если Получатель.Commit() <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Получатель, "фиксации смещений");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодключитьВнешнююКомпонентуШины()

	СистемнаяИнформация = Новый СистемнаяИнформация;

	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		МакетКомпоненты = "ОбщийМакет.ИСШ_librdkafka_win32";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.ИСШ_librdkafka_win64";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда
		МакетКомпоненты = "ОбщийМакет.ИСШ_librdkafka_linux32";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.ИСШ_librdkafka_linux64";
	Иначе
		ВызватьИсключение "Не поддерживаемая архитектура платформы";
	КонецЕсли;

	Если Не ПодключитьВнешнююКомпоненту(МакетКомпоненты, "librdkafka", ТипВнешнейКомпоненты.Native) Тогда
		ВызватьИсключение "Ошибка подключения внешней компоненты librdkafka";
	КонецЕсли;

КонецПроцедуры

Функция ТекстОшибкиВК(Знач Получатель, Знач Действие)

	Возврат СтрШаблон("Ошибка %1: %2", Действие, Получатель.ErrorDescription);

КонецФункции

Функция МассивИзJSON(Знач СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Обертка = Новый Массив;
		Обертка.Добавить(Результат);
		Результат = Обертка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
