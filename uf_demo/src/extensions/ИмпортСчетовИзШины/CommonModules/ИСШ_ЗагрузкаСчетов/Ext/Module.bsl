
// Загрузка счетов из сообщений топика Kafka в документы Заказ.
// Заказ идентифицируется парой Номер + Дата - повторная загрузка обновляет его.
// Сопоставление справочников - по правилам R-5 спецификации: организация и
// покупатель по строгому полному наименованию, валюта по коду (затем по
// наименованию), товар по артикулу (затем штрихкод, затем наименованию).
// Новые элементы справочников никогда не создаются; ненайденный элемент -
// пропуск счёта с записью в протокол. Смещения фиксируются только если
// порция обработана без ошибок.
//
#Область ПрограммныйИнтерфейс

// Читает одну порцию сообщений топика и записывает заказы.
// Офсеты фиксируются в брокере только если вся порция обработана без ошибок.
//
// Параметры:
//  Адрес  - Строка - адреса брокеров Kafka, например "localhost:9092"
//  Группа - Строка - имя группы получателей
//  Топик  - Строка - имя топика, например "invoices"
//
// Возвращаемое значение:
//  Структура - итоги: Прочитано, Создано, Обновлено, Пропущено, Ошибок (Числа),
//              Протокол (Массив строк "счёт: описание")
//
Функция ЗагрузитьСчета(Знач Адрес, Знач Группа, Знач Топик) Экспорт

	Итоги = Новый Структура("Прочитано, Создано, Обновлено, Пропущено, Ошибок, Протокол",
		0, 0, 0, 0, 0, Новый Массив);

	Получатель = ИСШ_Шина.НовыйПолучатель(Адрес, Группа, Топик);
	Сообщения = ИСШ_Шина.ПрочитатьПул(Получатель);

	Склад = СкладДляЗаказов();

	Для Каждого Сообщение Из Сообщения Цикл

		Итоги.Прочитано = Итоги.Прочитано + 1;

		Попытка
			ОбработатьСообщение(Сообщение, Склад, Итоги);
		Исключение
			Итоги.Ошибок = Итоги.Ошибок + 1;
			Итоги.Протокол.Добавить("ошибка порции: " + ОписаниеОшибки());
			ЗаписьЖурналаРегистрации("ИмпортСчетовИзШины.ЗагрузкаСчетов",
				УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Если Итоги.Ошибок = 0 Тогда
		ИСШ_Шина.ЗафиксироватьСмещения(Получатель);
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ИмпортСчетовИзШины.ЗагрузкаСчетов",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Прочитано: %1, создано: %2, обновлено: %3, пропущено: %4, ошибок: %5",
			Итоги.Прочитано, Итоги.Создано, Итоги.Обновлено, Итоги.Пропущено, Итоги.Ошибок));

	Возврат Итоги;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьСообщение(Знач Сообщение, Знач Склад, Знач Итоги)

	Разбор = РазобратьТело(Сообщение.Value);
	Если Разбор = Неопределено Тогда
		Пропустить(Итоги, "", "невалидный формат тела сообщения");
		Возврат;
	КонецЕсли;

	ИмяСчёта = СтрШаблон("%1 от %2", Разбор.Номер, Формат(Разбор.Дата, "ДЛ=DD.MM.YYYY"));

	Если Разбор.Товары.Количество() = 0 Тогда
		Пропустить(Итоги, ИмяСчёта, "счёт без товарных строк");
		Возврат;
	КонецЕсли;

	// Все ненайденные элементы - отдельными строками протокола; документ
	// пропускается целиком, справочники не меняются
	НенайденныеЭлементы = Новый Массив;

	Организация = ЭлементПоНаименованию("Организации", Разбор.Организация);
	Если Организация = Неопределено Тогда
		НенайденныеЭлементы.Добавить("организация не найдена: " + Разбор.Организация);
	КонецЕсли;

	Покупатель = ЭлементПоНаименованию("Контрагенты", Разбор.Покупатель);
	Если Покупатель = Неопределено Тогда
		НенайденныеЭлементы.Добавить("покупатель не найден: " + Разбор.Покупатель);
	КонецЕсли;

	Валюта = ВалютаПоКодуИНаименованию(Разбор.КодВалюты, Разбор.НаименованиеВалюты);
	Если Валюта = Неопределено Тогда
		НенайденныеЭлементы.Добавить("валюта не найдена: " + Разбор.КодВалюты);
	КонецЕсли;

	СтрокиТоваров = Новый Массив;
	СуммаЗаказа = 0;

	Для Каждого СтрокаДанные Из Разбор.Товары Цикл

		Товар = ТоварИзСтроки(СтрокаДанные);
		Если Товар = Неопределено Тогда
			НенайденныеЭлементы.Добавить("товар не найден: " + ПредставлениеСтрокиТовара(СтрокаДанные));
			Продолжить;
		КонецЕсли;

		Количество = Проверенноечисло(СтрокаДанные, "Количество", ИмяСчёта, 9999999999);
		Цена = Проверенноечисло(СтрокаДанные, "Цена", ИмяСчёта, 99999999.99);
		Сумма = Проверенноечисло(СтрокаДанные, "Сумма", ИмяСчёта, 99999999.99);

		// Дробное количество усекается до целого - разрядность поля 10,0
		Если Количество <> Цел(Количество) Тогда
			Итоги.Протокол.Добавить(СтрШаблон("%1: количество %2 усечено до %3",
				ИмяСчёта, Количество, Цел(Количество)));
			Количество = Цел(Количество);
		КонецЕсли;

		СуммаЗаказа = СуммаЗаказа + Сумма;
		СтрокиТоваров.Добавить(Новый Структура("Товар, Количество, Цена, Сумма",
			Товар, Количество, Цена, Сумма));

	КонецЦикла;

	Если НенайденныеЭлементы.Количество() > 0 Тогда
		Для Каждого ЭлементПротокола Из НенайденныеЭлементы Цикл
			Итоги.Протокол.Добавить(СтрШаблон("%1: %2", ИмяСчёта, ЭлементПротокола));
		КонецЦикла;
		Итоги.Пропущено = Итоги.Пропущено + 1;
		Возврат;
	КонецЕсли;

	Если СуммаЗаказа > 99999999.99 Тогда
		ВызватьИсключение СтрШаблон("%1: сумма заказа %2 вне разрядности 10,2",
			ИмяСчёта, СуммаЗаказа);
	КонецЕсли;

	// Номер заказа 9 символов; длинный номер обрезается справа - значащая
	// часть типовых номеров с префиксами ("00-00000001") сохраняется
	НомерЗаказа = Прав(Разбор.Номер, 9);
	Если СтрДлина(Разбор.Номер) > 9 Тогда
		Итоги.Протокол.Добавить(СтрШаблон("%1: номер счёта обрезан до 9 символов (%2)",
			ИмяСчёта, НомерЗаказа));
	КонецЕсли;

	Существующий = ЗаказПоНомеруИДате(НомерЗаказа, Разбор.Дата);
	Если Существующий <> Неопределено И Существующий.ПометкаУдаления Тогда
		Пропустить(Итоги, ИмяСчёта, "заказ помечен на удаление");
		Возврат;
	КонецЕсли;

	ЗаписатьЗаказ(Существующий, НомерЗаказа, Разбор.Дата, Организация, Покупатель,
		Валюта, Склад, СтрокиТоваров, СуммаЗаказа);

	Если Существующий = Неопределено Тогда
		Итоги.Создано = Итоги.Создано + 1;
	Иначе
		Итоги.Обновлено = Итоги.Обновлено + 1;
	КонецЕсли;

КонецПроцедуры

// Разбирает тело сообщения в структуру; Неопределено при невалидном формате.
//
Функция РазобратьТело(Знач ТелоJSON)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Номер = Свойство(Данные, "Номер");
	ДатаСтрока = Свойство(Данные, "Дата");
	Если ТипЗнч(Номер) <> Тип("Строка") ИЛИ ПустаяСтрока(Номер)
		ИЛИ ТипЗнч(ДатаСтрока) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Дата = XMLЗначение(Тип("Дата"), ДатаСтрока);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Организация = Свойство(Свойство(Данные, "Организация"), "Наименование");
	Покупатель = Свойство(Свойство(Данные, "Покупатель"), "Наименование");
	КодВалюты = Свойство(Свойство(Данные, "Валюта"), "Код");
	НаименованиеВалюты = Свойство(Свойство(Данные, "Валюта"), "Наименование");

	Если ТипЗнч(Организация) <> Тип("Строка") ИЛИ ПустаяСтрока(Организация)
		ИЛИ ТипЗнч(Покупатель) <> Тип("Строка") ИЛИ ПустаяСтрока(Покупатель)
		ИЛИ ТипЗнч(КодВалюты) <> Тип("Строка") ИЛИ ПустаяСтрока(КодВалюты) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Товары = Свойство(Данные, "Товары");
	Если ТипЗнч(Товары) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Номер, Дата, Организация, Покупатель, КодВалюты, НаименованиеВалюты, Товары",
		Номер, Дата, Организация, Покупатель, КодВалюты, НаименованиеВалюты, Товары);

КонецФункции

// Число-реквизит строки товара: должно быть числом в заданной разрядности,
// иначе - ошибка порции (документ не записывается, смещения не коммитятся).
//
Функция Проверенноечисло(Знач СтрокаДанные, Знач ИмяСвойства, Знач ИмяСчёта, Знач Максимум)

	Значение = Свойство(СтрокаДанные, ИмяСвойства);
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение СтрШаблон("%1: строка товара без числа %2",
			ИмяСчёта, ИмяСвойства);
	КонецЕсли;
	Если Значение < 0 ИЛИ Значение > Максимум Тогда
		ВызватьИсключение СтрШаблон("%1: %2 %3 вне разрядности поля",
			ИмяСчёта, ИмяСвойства, Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Сопоставляет строку сообщения с товаром приёмника: артикул (обрезка 15),
// затем штрихкод (обрезка 20), затем строгое полное наименование.
//
Функция ТоварИзСтроки(Знач СтрокаДанные)

	Артикул = Лев(СтрокаИлиПусто(Свойство(СтрокаДанные, "Артикул")), 15);
	Штрихкод = Лев(СтрокаИлиПусто(Свойство(СтрокаДанные, "Штрихкод")), 20);
	Наименование = СтрокаИлиПусто(Свойство(СтрокаДанные, "Наименование"));

	Если Не ПустаяСтрока(Артикул) Тогда
		Возврат ЭлементПоПолю("Товары", "Артикул", Артикул);
	ИначеЕсли Не ПустаяСтрока(Штрихкод) Тогда
		Возврат ЭлементПоПолю("Товары", "Штрихкод", Штрихкод);
	ИначеЕсли Не ПустаяСтрока(Наименование) Тогда
		Возврат ЭлементПоПолю("Товары", "Наименование", Наименование);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Ссылка непомеченного элемента справочника по полю; Неопределено, если нет.
//
Функция ЭлементПоПолю(Знач ИмяСправочника, Знач ИмяПоля, Знач Значение)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	Т.%2 = &Значение
	|	И НЕ Т.ПометкаУдаления", ИмяСправочника, ИмяПоля);
	Запрос.УстановитьПараметр("Значение", Значение);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Строгое полное наименование: без обрезки, длиннее поля - не найдено.
//
Функция ЭлементПоНаименованию(Знач ИмяСправочника, Знач Наименование)

	Возврат ЭлементПоПолю(ИмяСправочника, "Наименование", Наименование);

КонецФункции

// Валюта по коду (3), при отсутствии - по строгому полному наименованию.
//
Функция ВалютаПоКодуИНаименованию(Знач КодВалюты, Знач НаименованиеВалюты)

	Ссылка = ЭлементПоПолю("Валюты", "Код", СокрЛП(КодВалюты));
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат ЭлементПоНаименованию("Валюты", НаименованиеВалюты);

КонецФункции

// Первый по наименованию непомеченный используемый склад приёмника.
//
Функция СкладДляЗаказов()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И НЕ Склады.НеИспользовать
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В приёмнике нет непомеченного используемого склада";
	КонецЕсли;

	Возврат Выборка.Ссылка;

КонецФункции

// Заказ по паре Номер + Дата; Неопределено, если не найден.
//
Функция ЗаказПоНомеруИДате(Знач Номер, Знач Дата)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Заказ КАК Заказы
	|ГДЕ
	|	Заказы.Номер = &Номер
	|	И Заказы.Дата = &Дата");
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.УстановитьПараметр("Дата", Дата);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Записывает заказ в транзакции: шапка из сообщения, товарные строки -
// полной заменой набора. Заказ никогда не проводится.
//
Процедура ЗаписатьЗаказ(Знач Существующий, Знач Номер, Знач Дата,
	Знач Организация, Знач Покупатель, Знач Валюта, Знач Склад,
	Знач СтрокиТоваров, Знач СуммаЗаказа)

	НачатьТранзакцию();

	Попытка

		Если Существующий = Неопределено Тогда
			Объект = Документы.Заказ.СоздатьДокумент();
		Иначе
			Объект = Существующий.ПолучитьОбъект();
		КонецЕсли;

		Объект.Номер = Номер;
		Объект.Дата = Дата;
		Объект.Организация = Организация;
		Объект.Покупатель = Покупатель;
		Объект.Валюта = Валюта;
		Объект.Склад = Склад;
		Объект.СостояниеЗаказа = Перечисления.СостоянияЗаказов.Открыт;
		Объект.Сумма = СуммаЗаказа;

		// Полная замена строк приводит заказ в соответствие со счётом источника
		Объект.Товары.Очистить();
		Для Каждого СтрокаДанные Из СтрокиТоваров Цикл
			СтрокаТовары = Объект.Товары.Добавить();
			СтрокаТовары.Товар = СтрокаДанные.Товар;
			СтрокаТовары.Количество = СтрокаДанные.Количество;
			СтрокаТовары.Цена = СтрокаДанные.Цена;
			СтрокаТовары.Сумма = СтрокаДанные.Сумма;
		КонецЦикла;

		Объект.Записать(РежимЗаписиДокумента.Запись);

		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура Пропустить(Знач Итоги, Знач ИмяСчёта, Знач Описание)

	Итоги.Пропущено = Итоги.Пропущено + 1;
	Если ПустаяСтрока(ИмяСчёта) Тогда
		Итоги.Протокол.Добавить(Описание);
	Иначе
		Итоги.Протокол.Добавить(СтрШаблон("%1: %2", ИмяСчёта, Описание));
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеСтрокиТовара(Знач СтрокаДанные)

	Возврат СтрШаблон("%1 (%2)",
		СтрокаИлиПусто(Свойство(СтрокаДанные, "Наименование")),
		СтрокаИлиПусто(Свойство(СтрокаДанные, "Артикул")));

КонецФункции

Функция Свойство(Знач Данные, Знач ИмяСвойства)

	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство(ИмяСвойства, Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция СтрокаИлиПусто(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти
