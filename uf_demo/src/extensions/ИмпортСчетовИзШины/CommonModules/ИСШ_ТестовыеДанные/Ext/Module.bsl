
// Служебные данные Vanessa-фич обмена счетами (features/scheta).
// Готовит эталонные данные приёмника и счёт-образец в источнике через COM.
// Используется только тестами; в обмене не участвует.
//
#Область ПрограммныйИнтерфейс

// Возвращает первый непомеченный используемый склад приёмника.
// Если складов нет - создает "Основной склад" (склад обязателен для заказа,
// обмен новые склады не создает - это данные тестовой среды).
//
// Возвращаемое значение:
//  СправочникСсылка.Склады
//
Функция СкладПриемника() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И НЕ Склады.НеИспользовать");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Склад = Справочники.Склады.СоздатьЭлемент();
	Склад.Наименование = "Основной склад";
	Склад.Записать();

	Возврат Склад.Ссылка;

КонецФункции

// Возвращает товар приёмника с указанным артикулом; при отсутствии создает.
//
Функция ТоварПриемника(Знач Артикул, Знач Наименование, Знач Штрихкод) Экспорт

	Ссылка = ЭлементСправочникаПоРеквизиту("Товары", "Артикул", Артикул);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Товар = Справочники.Товары.СоздатьЭлемент();
	Товар.Артикул = Артикул;
	Товар.Наименование = Наименование;
	Товар.Штрихкод = Штрихкод;
	Товар.Вид = Перечисления.ВидыТоваров.Товар;
	Товар.Записать();

	Возврат Товар.Ссылка;

КонецФункции

// Возвращает элемент справочника приёмника по наименованию; при отсутствии создает.
// Подходит для Организации и Контрагенты.
//
Функция ЭлементПриемникаПоНаименованию(Знач ИмяСправочника, Знач Наименование) Экспорт

	Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.Записать();

	Возврат Элемент.Ссылка;

КонецФункции

// Возвращает валюту источника, чей код отсутствует в приёмнике - гарантия
// «не найдена» без создания тестовых валют (коды валют в базах могут
// нормализоваться по-разному).
//
Функция ВалютаИсточникаОтсутствующаяВПриемнике(Знач Источник) Экспорт

	Выборка = Источник.Справочники.Валюты.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления ИЛИ ПустаяСтрока(СокрЛП(Выборка.Код)) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементСправочникаПоРеквизиту("Валюты", "Код", СокрЛП(Выборка.Код)).Пустая() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Коды всех валют источника есть в приёмнике - сценарий не может гарантировать ""валюта не найдена""";

КонецФункции

// Пометит на удаление непроведенные тестовые счета источника (номер "ТТ...")
// от прошлых прогонов фичи - новые тестовые счета создаются с тем же префиксом.
//
Процедура ПометитьТестовыеСчета(Знач Источник) Экспорт

	Выборка = Источник.Документы._ДемоСчетНаОплатуПокупателю.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Лев(Выборка.Номер, 2) = "ТТ" И НЕ Выборка.ПометкаУдаления И НЕ Выборка.Проведен Тогда
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.ПометкаУдаления = Истина;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает валюту приёмника с указанным кодом; при отсутствии создает.
//
Функция ВалютаПриемника(Знач Код, Знач Наименование) Экспорт

	Ссылка = ЭлементСправочникаПоРеквизиту("Валюты", "Код", Код);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Валюта = Справочники.Валюты.СоздатьЭлемент();
	Валюта.Код = Код;
	Валюта.Наименование = Наименование;
	Валюта.Записать();

	Возврат Валюта.Ссылка;

КонецФункции

// Возвращает ссылку первой непомеченной организации источника,
// чьё наименование помещается в поле приёмника (25).
//
Функция ОрганизацияИсточника(Знач Источник) Экспорт

	Возврат ЭлементИсточникаПоДлине(Источник, "_ДемоОрганизации", 25, Ложь);

КонецФункции

// Возвращает ссылку первого непомеченного контрагента источника
// с наименованием до 30 символов (поле покупателя приёмника).
//
Функция КонтрагентИсточника(Знач Источник) Экспорт

	Возврат ЭлементИсточникаПоДлине(Источник, "_ДемоКонтрагенты", 30, Ложь);

КонецФункции

// Возвращает ссылку первой непомеченной валюты источника с кодом до 3 символов.
//
Функция ВалютаИсточника(Знач Источник) Экспорт

	Возврат ЭлементИсточникаПоДлине(Источник, "Валюты", 3, Истина);

КонецФункции

// Возвращает элемент справочника источника по наименованию (для валюты - по
// коду); при отсутствии создает элемент с этими наименованием и кодом.
// Для контрагента при создании также создается одноименный партнёр.
//
Функция ЭлементИсточникаПоИмени(Знач Источник, Знач ИмяСправочника,
	Знач Наименование, Знач Код = "") Экспорт

	Если ИмяСправочника = "_ДемоОрганизации" Тогда
		Ссылка = Источник.Справочники._ДемоОрганизации.НайтиПоНаименованию(Наименование);
		Если Ссылка.Пустая() Тогда
			Элемент = Источник.Справочники._ДемоОрганизации.СоздатьЭлемент();
			Элемент.Наименование = Наименование;
			Элемент.Записать();
			Возврат Элемент.Ссылка;
		КонецЕсли;
		Возврат Ссылка;

	ИначеЕсли ИмяСправочника = "_ДемоКонтрагенты" Тогда
		Партнер = Источник.Справочники._ДемоПартнеры.НайтиПоНаименованию(Наименование);
		Если Партнер.Пустая() Тогда
			ЭлементПартнер = Источник.Справочники._ДемоПартнеры.СоздатьЭлемент();
			ЭлементПартнер.Наименование = Наименование;
			ЭлементПартнер.Записать();
			Партнер = ЭлементПартнер.Ссылка;
		КонецЕсли;
		Ссылка = Источник.Справочники._ДемоКонтрагенты.НайтиПоНаименованию(Наименование);
		Если Ссылка.Пустая() Тогда
			Элемент = Источник.Справочники._ДемоКонтрагенты.СоздатьЭлемент();
			Элемент.Наименование = Наименование;
			Элемент.Партнер = Партнер;
			Элемент.Записать();
			Возврат Элемент.Ссылка;
		КонецЕсли;
		Возврат Ссылка;

	ИначеЕсли ИмяСправочника = "Валюты" Тогда
		Ссылка = Источник.Справочники.Валюты.НайтиПоКоду(Код);
		Если Ссылка.Пустая() Тогда
			Элемент = Источник.Справочники.Валюты.СоздатьЭлемент();
			Элемент.Код = Код;
			Элемент.Наименование = Наименование;
			Элемент.Записать();
			Возврат Элемент.Ссылка;
		КонецЕсли;
		Возврат Ссылка;

	КонецЕсли;

	ВызватьИсключение "Неизвестный справочник источника: " + ИмяСправочника;

КонецФункции

// Возвращает номенклатуру источника по артикулу; при отсутствии создает.
Функция НоменклатураИсточника(Знач Источник, Знач Артикул, Знач Наименование, Знач Штрихкод) Экспорт

	Ссылка = Источник.Справочники._ДемоНоменклатура.НайтиПоРеквизиту("Артикул", Артикул);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;

	Элемент = Источник.Справочники._ДемоНоменклатура.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.Артикул = Артикул;
	Элемент.Штрихкод = Штрихкод;
	Элемент.Записать();

	Возврат Элемент.Ссылка;

КонецФункции

// Возвращает счёт источника с заданными номером, датой и шапкой; товарные
// строки берутся из массива структур {Номенклатура, Количество, Цена, Сумма}
// с полной заменой ТЧ. Существующий счёт обновляется, поэтому фичу можно
// повторять. Счет записывается без проведения.
//
Функция СчетИсточникаССтроками(Знач Источник, Знач Номер, Знач Дата,
	Знач Организация, Знач Контрагент, Знач Валюта, Знач СтрокиТоваров) Экспорт

	СсылкаСчёта = Источник.Документы._ДемоСчетНаОплатуПокупателю.НайтиПоНомеру(Номер, Дата);
	Если СсылкаСчёта.Пустая() Тогда
		Объект = Источник.Документы._ДемоСчетНаОплатуПокупателю.СоздатьДокумент();
		Объект.Номер = Номер;
		Объект.Дата = Дата;
	Иначе
		Объект = СсылкаСчёта.ПолучитьОбъект();
	КонецЕсли;

	Объект.Организация = Организация;
	Объект.Партнер = Контрагент.Партнер;
	Объект.Контрагент = Контрагент;
	Объект.ВалютаДокумента = Валюта;

	Объект.Товары.Очистить();
	Для Каждого ДанныеСтроки Из СтрокиТоваров Цикл
		СтрокаТовары = Объект.Товары.Добавить();
		СтрокаТовары.Номенклатура = ДанныеСтроки.Номенклатура;
		СтрокаТовары.Количество = ДанныеСтроки.Количество;
		СтрокаТовары.Цена = ДанныеСтроки.Цена;
		СтрокаТовары.Сумма = ДанныеСтроки.Сумма;
	КонецЦикла;

	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

// Соответствие отметок для ВыгрузитьСчета по одному счёту источника.
//
Функция ОтмеченныеИсточника(Знач Источник, Знач СсылкаСчёта) Экспорт

	Ключ = СсылкаСчёта.Номер + "|" + XMLСтрока(СсылкаСчёта.Дата);
	Отмеченные = Источник.NewObject("Соответствие");
	Отмеченные.Вставить(Ключ, Ключ);

	Возврат Отмеченные;

КонецФункции

// Возвращает заказ приёмника по номеру и проверяет количество экземпляров.
//
Функция ЗаказПриемника(Знач Номер, Знач ОжидаемоеКоличество) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Заказы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Заказ КАК Заказы
	|ГДЕ
	|	Заказы.Номер = &Номер");
	Запрос.УстановитьПараметр("Номер", Номер);

	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() <> ОжидаемоеКоличество Тогда
		ВызватьИсключение "Заказов с номером " + Номер + ": " + Таблица.Количество()
			+ ", ожидалось " + ОжидаемоеКоличество;
	КонецЕсли;

	Если Таблица.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Таблица[0].Ссылка;

КонецФункции

// Количество непомеченных элементов справочника приёмника (контроль роста).
//
Функция КоличествоЭлементовПриемника(Знач ИмяСправочника) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Кол
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления", ИмяСправочника);

	Возврат Запрос.Выполнить().Выгрузить()[0].Кол;

КонецФункции

// Пауза серверного кода (тестовая синхронизация с брокером).
Процедура Ожидать(Знач Миллисекунды) Экспорт

	Момент = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунды;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Момент Цикл
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭлементСправочникаПоРеквизиту(Знач ИмяСправочника, Знач ИмяРеквизита, Знач Значение)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	Т.%2 = &Значение", ИмяСправочника, ИмяРеквизита);
	Запрос.УстановитьПараметр("Значение", Значение);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники[ИмяСправочника].ПустаяСсылка();

КонецФункции

// Обход справочника источника через COM: первый непомеченный элемент,
// значение поля которого помещается в поле приёмника. Для валюты проверяется код.
//
Функция ЭлементИсточникаПоДлине(Знач Источник, Знач ИмяСправочника, Знач МаксДлина, Знач ПроверятьКод)

	Если ИмяСправочника = "_ДемоОрганизации" Тогда
		Выборка = Источник.Справочники._ДемоОрганизации.Выбрать();
	ИначеЕсли ИмяСправочника = "_ДемоКонтрагенты" Тогда
		Выборка = Источник.Справочники._ДемоКонтрагенты.Выбрать();
	ИначеЕсли ИмяСправочника = "Валюты" Тогда
		Выборка = Источник.Справочники.Валюты.Выбрать();
	Иначе
		ВызватьИсключение "Неизвестный справочник источника: " + ИмяСправочника;
	КонецЕсли;

	Пока Выборка.Следующий() Цикл
		Если ПроверятьКод Тогда
			Значение = СокрЛП(Выборка.Код);
			// Тестовые валюты сценариев протокола (коды "Z..") не подходят
			Тестовое = Лев(Значение, 1) = "Z";
		Иначе
			Значение = СокрЛП(Выборка.Наименование);
			// Тестовые ненайденные элементы сценариев протокола не подходят
			Тестовое = Лев(Значение, СтрДлина("ИТ-Нет")) = "ИТ-Нет";
		КонецЕсли;
		Если Не Тестовое И Не Выборка.ПометкаУдаления И Значение <> "" И СтрДлина(Значение) <= МаксДлина Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "В источнике нет подходящего элемента справочника " + ИмяСправочника
		+ " (длина поля до " + МаксДлина + ")";

КонецФункции

#КонецОбласти
