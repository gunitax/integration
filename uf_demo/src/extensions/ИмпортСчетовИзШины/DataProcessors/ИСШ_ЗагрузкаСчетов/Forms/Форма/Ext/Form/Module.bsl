
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Адрес = "localhost:9092";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ГруппаПолучателей) Тогда
		ГруппаПолучателей = "uf-demo-invoices";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Топик) Тогда
		Топик = "invoices";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)

	Итоги = ЗагрузитьНаСервере();

	ТекстИтогов = СтрШаблон(
		"Прочитано: %1, создано: %2, обновлено: %3, пропущено: %4, ошибок: %5",
		Итоги.Прочитано, Итоги.Создано, Итоги.Обновлено, Итоги.Пропущено, Итоги.Ошибок);

	Сообщить(ТекстИтогов);

	Для Каждого СтрокаПротокола Из Итоги.Протокол Цикл
		Сообщить(СтрокаПротокола);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьНаСервере()

	Возврат ИСШ_ЗагрузкаСчетов.ЗагрузитьСчета(Адрес, ГруппаПолучателей, Топик);

КонецФункции
