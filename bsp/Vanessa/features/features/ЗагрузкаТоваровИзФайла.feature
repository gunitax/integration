Сценарий: Удаление только данных целевого прогона
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        НачатьТранзакцию();
        Попытка
            Вид = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("ЗТ-VA-20261017-2300", Истина);
            Если Не Вид.Пустая() Тогда
                Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ ВидНоменклатуры = &Вид");
                Запрос.УстановитьПараметр("Вид", Вид); Выборка = Запрос.Выполнить().Выбрать();
                Пока Выборка.Следующий() Цикл
                    Набор = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();
                    Набор.Отбор.Номенклатура.Установить(Выборка.Ссылка); Набор.Записать();
                    Товар = Выборка.Ссылка.ПолучитьОбъект(); Товар.ОбменДанными.Загрузка = Истина; Товар.Удалить();
                КонецЦикла;
                ОбъектВида = Вид.ПолучитьОбъект(); ОбъектВида.ОбменДанными.Загрузка = Истина; ОбъектВида.Удалить();
            КонецЕсли;
            Единица = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("ЗТ-VA-20261017-2300 единица", Истина);
            Если Не Единица.Пустая() Тогда
                ОбъектЕдиницы = Единица.ПолучитьОбъект(); ОбъектЕдиницы.ОбменДанными.Загрузка = Истина; ОбъектЕдиницы.Удалить();
            КонецЕсли;
            Если Не Справочники.ВидыНоменклатуры.НайтиПоНаименованию("ЗТ-VA-20261017-2300", Истина).Пустая()
                Или Не Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("ЗТ-VA-20261017-2300 единица", Истина).Пустая()
                Или Не Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "001-ЗТ-VA-20261017-2300").Пустая()
                Или Не Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "ЗТ-VA-20261017-2300-занят").Пустая() Тогда
                ВызватьИсключение "Тестовые карточки не удалены";
            КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
        """
