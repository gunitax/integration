    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Наименование, Артикул ИЗ Справочник.Номенклатура ГДЕ Артикул = &Артикул");
        Запрос.УстановитьПараметр("Артикул", "001-ЗТ-VA-20261017-2300"); Таблица = Запрос.Выполнить().Выгрузить();
        Если Таблица.Количество() <> 1 Тогда ВызватьИсключение "Ожидается одна карточка"; КонецЕсли;
        Если Таблица[0].Наименование <> "ЗТ VA товар с двумя кодами" Тогда ВызватьИсключение "Наименование не сохранено"; КонецЕсли;
        Запрос.Текст = "ВЫБРАТЬ Штрихкод ИЗ РегистрСведений.ШтрихкодыНоменклатуры ГДЕ Номенклатура = &Товар УПОРЯДОЧИТЬ ПО Штрихкод";
        Запрос.УстановитьПараметр("Товар", Таблица[0].Ссылка); Коды = Запрос.Выполнить().Выгрузить();
        Если Коды.Количество() <> 2 Тогда ВызватьИсключение "Ожидается два штрихкода"; КонецЕсли;
        Если Коды[0].Штрихкод <> "0017001723002" Или Коды[1].Штрихкод <> "0017001723003" Тогда ВызватьИсключение "Искажены штрихкоды"; КонецЕсли;
        Запрос.Текст = "ВЫБРАТЬ Номенклатура.Артикул КАК Артикул ИЗ РегистрСведений.ШтрихкодыНоменклатуры ГДЕ Штрихкод = &Код";
        Запрос.УстановитьПараметр("Код", "0017001723001"); Владельцы = Запрос.Выполнить().Выгрузить();
        Если Владельцы.Количество() <> 1 Тогда ВызватьИсключение "Изменены связи занятого штрихкода"; КонецЕсли;
        Если Владельцы[0].Артикул <> "ЗТ-VA-20261017-2300-занят" Тогда ВызватьИсключение "Занятый код передан другому товару"; КонецЕсли;
        Сведения = Новый Структура("Карточек,Штрихкодов,Артикул,Наименование,Ссылка,ЗанятыйКодСохранен", Таблица.Количество(), Коды.Количество(), Таблица[0].Артикул, Таблица[0].Наименование, ПолучитьНавигационнуюСсылку(Таблица[0].Ссылка), Истина);
        Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл("C:\Users\IT\Desktop\hakaton\1c\tmp\products-va-db.json");
        ЗаписатьJSON(Запись, Сведения); Запись.Закрыть();
