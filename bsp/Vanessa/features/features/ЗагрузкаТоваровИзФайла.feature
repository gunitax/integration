Функционал: Загрузка обычной карточки с двумя штрихкодами из XLSX

Сценарий: Подготовка изолированных данных и двух файлов XLSX
    Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        НачатьТранзакцию();
        Попытка
            Маркер = "ЗТ-VA-20261017-2300";
            Если Не Справочники.ВидыНоменклатуры.НайтиПоНаименованию(Маркер, Истина).Пустая() Тогда
                ВызватьИсключение "Тестовый вид уже существует: сначала завершите очистку этого прогона";
            КонецЕсли;
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыНоменклатуры
            |ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа
            |И ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
            |И ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
            |УПОРЯДОЧИТЬ ПО Наименование");
            Выборка = Запрос.Выполнить().Выбрать();
            Если Не Выборка.Следующий() Тогда ВызватьИсключение "Нет вида товаров для фикстуры"; КонецЕсли;
            Вид = Выборка.Ссылка.ПолучитьОбъект().Скопировать();
            Вид.ОбменДанными.Загрузка = Истина; Вид.Наименование = Маркер;
            Вид.ИспользоватьСерии = Ложь; Вид.Записать();
            Единица = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("796");
            Если Единица.Пустая() Тогда ВызватьИсключение "Нет единицы измерения с кодом 796"; КонецЕсли;
            ОбъектЕдиницы = Единица.ПолучитьОбъект().Скопировать();
            ОбъектЕдиницы.Наименование = Маркер + " единица";
            ОбъектЕдиницы.ОбменДанными.Загрузка = Истина; ОбъектЕдиницы.Записать();
            Единица = ОбъектЕдиницы.Ссылка;
            Строки = ЗТ_ЗагрузкаСервер.НовыеСтроки(); СтрокаТовара = Строки.Добавить();
            СтрокаТовара.НомерСтроки = 2; СтрокаТовара.Загружать = Истина;
            СтрокаТовара.Наименование = Маркер + " занятый штрихкод";
            СтрокаТовара.Артикул = Маркер + "-занят";
            СтрокаТовара.ВидНоменклатуры = Вид.Ссылка; СтрокаТовара.ЕдиницаИзмерения = Единица;
            СтрокаТовара.Штрихкод = "0017001723001";
            Настройки = ЗТ_ЗагрузкаСервер.НастройкиПоУмолчанию();
            План = ЗТ_ЗагрузкаСервер.ПодготовитьПлан(Строки, Настройки);
            Результат = ЗТ_ЗагрузкаСервер.ВыполнитьПлан(План, Настройки);
            Если Результат[0].Статус <> "Создан" Тогда ВызватьИсключение Результат[0].Описание; КонецЕсли;
            Для НомерФайла = 1 По 2 Цикл
                Документ = Новый ТабличныйДокумент;
                Документ.Область(1,1).Текст = "Артикул";
                Документ.Область(1,2).Текст = "Название из прайса";
                Документ.Область(1,3).Текст = "Штрихкод";
                Документ.Область(1,4).Текст = "Вид номенклатуры";
                Документ.Область(1,5).Текст = "Единица измерения";
                Для НомерСтроки = 2 По 3 Цикл
                    Документ.Область(НомерСтроки,1).Текст = "001-ЗТ-VA-20261017-2300";
                    Документ.Область(НомерСтроки,2).Текст = "ЗТ VA товар с двумя кодами";
                    Документ.Область(НомерСтроки,3).Текст = ?(НомерСтроки = 3, "0017001723002", ?(НомерФайла = 1, "0017001723001", "0017001723003"));
                    Документ.Область(НомерСтроки,4).Текст = Маркер;
                    Документ.Область(НомерСтроки,5).Текст = Единица.Наименование;
                КонецЦикла;
                Документ.Записать("C:\Users\IT\Desktop\hakaton\1c\tmp\products-va-" + Строка(НомерФайла) + ".xlsx", ТипФайлаТабличногоДокумента.XLSX);
            КонецЦикла;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
        """

