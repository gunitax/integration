#language: ru
Функционал: Фоновые обработчики снятия резервов на изолированном заказе

Сценарий: Подготовка собственного заказа для фоновых команд
    Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        СР_ТестыРезервов.ОчиститьИнтерфейс();
        СР_ТестыРезервов.ПодготовитьИнтерфейс();
        Ф = ХранилищеОбщихНастроек.Загрузить("СР_VA","20261021",,"");
        Н = СР_РезервыСервер.ЗагрузитьНастройки();
        Если Ф.Заказ.Комментарий <> Ф.Маркер Тогда ВызватьИсключение "Нет собственного маркера"; КонецЕсли;
        Ссылки = СР_РезервыСервер.СсылкиЗаказов(Н);
        Если Ссылки.Количество() <> 1 Или Ссылки[0] <> Ф.Заказ Тогда ВызватьИсключение "Небезопасный отбор фоновых команд"; КонецЕсли;
        Н.ПредупреждениеКлиенту = Ложь; Н.СнятиеКлиенту = Ложь;
        Н.СнятиеСотрудникам = Ложь; Н.СнятиеКанал = "Задача";
        Н.СнятиеАдресаты.Очистить(); Н.СнятиеАдресаты.Добавить(Пользователи.ТекущийПользователь());
        СР_РезервыСервер.СохранитьНастройки(Н);
        """

Сценарий: Пять обработчиков исполняются в настоящих фоновых заданиях
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Ф = ХранилищеОбщихНастроек.Загрузить("СР_VA","20261021",,"");
        Н = СР_РезервыСервер.ЗагрузитьНастройки();
        Методы = СтрРазделить("ЗакрытьИсполненныеПоРасписанию,ПредупредитьПоРасписанию,ПредупредитьПоРасписанию,ДайджестПоРасписанию,СнятьПоРасписанию,ЗакрытьНеотработанныеПоРасписанию",",");
        Лог = Новый ТекстовыйДокумент;
        Для Номер = 0 По Методы.Количество()-1 Цикл
            Если Номер = 3 Тогда Н.РезервПоУмолчанию = 5; СР_РезервыСервер.СохранитьНастройки(Н); КонецЕсли;
            Ссылки = СР_РезервыСервер.СсылкиЗаказов(Н);
            Если Ссылки.Количество() <> 1 Или Ссылки[0] <> Ф.Заказ Или Ф.Заказ.Комментарий <> Ф.Маркер Тогда ВызватьИсключение "Изменился изолированный отбор"; КонецЕсли;
            Метод = "СР_РезервыСервер." + Методы[Номер];
            Задание = ФоновыеЗадания.Выполнить(Метод,Новый Массив,Строка(Новый УникальныйИдентификатор),"СР проверка " + Ф.Маркер);
            Задание = Задание.ОжидатьЗавершенияВыполнения(60);
            Если Задание.Состояние <> СостояниеФоновогоЗадания.Завершено Тогда
                Если Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда Задание.Отменить(); Задание = Задание.ОжидатьЗавершенияВыполнения(10); КонецЕсли;
                ВызватьИсключение Метод + ": " + Строка(Задание.Состояние);
            КонецЕсли;
            Лог.ДобавитьСтроку(Метод + " — " + Строка(Задание.Состояние));
            ЗЛ = Новый Запрос("ВЫБРАТЬ Событие,Успех,Описание ИЗ РегистрСведений.СР_ЖурналРезервов ГДЕ Заказ = &Заказ УПОРЯДОЧИТЬ ПО Момент"); ЗЛ.УстановитьПараметр("Заказ",Ф.Заказ);
            Для Каждого СЛ Из ЗЛ.Выполнить().Выгрузить() Цикл Лог.ДобавитьСтроку(СЛ.Событие + ": " + Строка(СЛ.Успех) + " " + СЛ.Описание); КонецЦикла;
            Лог.Записать("C:\Users\IT\Desktop\hakaton\docs\reports\reserve-review-20261101\background-handlers.txt",КодировкаТекста.UTF8);
            ЗСтатус = Новый Запрос("ВЫБРАТЬ Статус ИЗ Документ.ЗаказКлиента ГДЕ Ссылка = &Заказ"); ЗСтатус.УстановитьПараметр("Заказ",Ф.Заказ); ВСтатус = ЗСтатус.Выполнить().Выбрать(); Если Не ВСтатус.Следующий() Тогда ВызватьИсключение "Заказ не найден"; КонецЕсли;
            Если Номер = 0 И ВСтатус.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда ВызватьИсключение "Неисполненный заказ закрыт как исполненный"; КонецЕсли;
            Если Номер = 1 Или Номер = 2 Тогда
                Если Не СР_РезервыСервер.УжеПредупрежден(Ф.Заказ) Тогда ВызватьИсключение "Фоновое предупреждение не учтено"; КонецЕсли;
                З = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Задача.ЗадачаИсполнителя ГДЕ Предмет = &Заказ"); З.УстановитьПараметр("Заказ",Ф.Заказ); В = З.Выполнить().Выбрать(); В.Следующий();
                Если В.Количество <> 1 Тогда ВызватьИсключение "Дубль фонового предупреждения"; КонецЕсли;
            КонецЕсли;
            Если Номер = 3 Тогда
                З = Новый Запрос("ВЫБРАТЬ Ссылка,Описание ИЗ Задача.ЗадачаИсполнителя ГДЕ Наименование = &Тема И Исполнитель = &Исполнитель");
                З.УстановитьПараметр("Тема","Сводное уведомление о просроченных резервах"); З.УстановитьПараметр("Исполнитель",Пользователи.ТекущийПользователь());
                Найдено = 0; Для Каждого СтрокаЗадачи Из З.Выполнить().Выгрузить() Цикл Если СтрНайти(СтрокаЗадачи.Описание,Ф.Маркер) > 0 Тогда Найдено = Найдено + 1; КонецЕсли; КонецЦикла;
                Если Найдено <> 1 Тогда ВызватьИсключение "Фоновый дайджест не создал одну собственную задачу"; КонецЕсли;
            КонецЕсли;
            Если Номер = 4 Тогда
                // Проверять запросом: объект, полученный до другого сеанса, закеширован в текущем серверном вызове.
                ЗСтроки = Новый Запрос("ВЫБРАТЬ Отменено,ВариантОбеспечения ИЗ Документ.ЗаказКлиента.Товары ГДЕ Ссылка = &Заказ"); ЗСтроки.УстановитьПараметр("Заказ",Ф.Заказ);
                Для Каждого Т Из ЗСтроки.Выполнить().Выгрузить() Цикл Если Не Т.Отменено И Т.ВариантОбеспечения <> Перечисления.ВариантыОбеспечения.НеТребуется Тогда ВызватьИсключение "Фон не снял обеспечение"; КонецЕсли; КонецЦикла;
                З = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(ВРезерве),0) КАК Количество ИЗ РегистрНакопления.ТоварыКОтгрузке ГДЕ Регистратор = &Заказ И Активность"); З.УстановитьПараметр("Заказ",Ф.Заказ); В = З.Выполнить().Выбрать(); В.Следующий(); Если В.Количество <> 0 Тогда ВызватьИсключение "Фон оставил складской резерв"; КонецЕсли;
            КонецЕсли;
            Если Номер = 5 И ВСтатус.Статус <> Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда ВызватьИсключение "Фон не закрыл неотработанный заказ"; КонецЕсли;
        КонецЦикла;
        Лог.Записать("C:\Users\IT\Desktop\hakaton\docs\reports\reserve-review-20261101\background-handlers.txt",КодировкаТекста.UTF8);
        """

Сценарий: Очистка собственных данных фоновой проверки
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Ф = ХранилищеОбщихНастроек.Загрузить("СР_VA","20261021",,"");
        Если Ф <> Неопределено Тогда
            З = Новый Запрос("ВЫБРАТЬ Ссылка,Описание ИЗ Задача.ЗадачаИсполнителя ГДЕ Наименование = &Тема И Исполнитель = &Исполнитель");
            З.УстановитьПараметр("Тема","Сводное уведомление о просроченных резервах"); З.УстановитьПараметр("Исполнитель",Пользователи.ТекущийПользователь());
            Для Каждого СтрокаЗадачи Из З.Выполнить().Выгрузить() Цикл
                Если СтрНайти(СтрокаЗадачи.Описание,Ф.Маркер) > 0 Тогда СтрокаЗадачи.Ссылка.ПолучитьОбъект().Удалить(); КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        СР_ТестыРезервов.ОчиститьИнтерфейс();
        Если ХранилищеОбщихНастроек.Загрузить("СР_VA","20261021",,"") <> Неопределено Тогда ВызватьИсключение "Фикстура не очищена"; КонецЕсли;
        """
