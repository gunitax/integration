Функционал: Заполнение контрагента из DaData без потери ручных правок

Сценарий: Подготовка изолированной карточки и безопасной настройки
    Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        ДДФайлКлюча = "C:\Users\IT\Desktop\hakaton\1c\tmp\dadata-api-key.txt";
        ДДФайл = Новый Файл(ДДФайлКлюча);
        Если ДДФайл.Существует() Тогда
            Попытка
                ДДЧтение = Новый ЧтениеТекста(ДДФайлКлюча, КодировкаТекста.UTF8);
                ДДКлюч = ДДЧтение.Прочитать();
                ДДЧтение.Закрыть();
                ДД_КонтрагентыСервер.СохранитьКлюч(ДДКлюч);
            Исключение
                УдалитьФайлы(ДДФайлКлюча);
                ВызватьИсключение "Не удалось сохранить настройку доступа DaData";
            КонецПопытки;
            УдалитьФайлы(ДДФайлКлюча);
        КонецЕсли;
        ДДМаркер = "ДД-VA-20261009-1834";
        ДДПартнер = Справочники.Партнеры.НайтиПоНаименованию(ДДМаркер, Истина);
        Если ДДПартнер.Пустая() Тогда
            ДДОбъектПартнера = Справочники.Партнеры.СоздатьЭлемент();
            ДДОбъектПартнера.ОбменДанными.Загрузка = Истина;
            ДДОбъектПартнера.Наименование = ДДМаркер;
            ДДОбъектПартнера.Записать();
            ДДПартнер = ДДОбъектПартнера.Ссылка;
        КонецЕсли;
        ДДЗапрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Контрагенты ГДЕ Партнер = &Партнер");
        ДДЗапрос.УстановитьПараметр("Партнер", ДДПартнер);
        ДДВыборка = ДДЗапрос.Выполнить().Выбрать();
        Если ДДВыборка.Следующий() Тогда
            ДДКарточка = ДДВыборка.Ссылка.ПолучитьОбъект();
        Иначе
            ДДКарточка = Справочники.Контрагенты.СоздатьЭлемент();
        КонецЕсли;
        ДДКарточка.ОбменДанными.Загрузка = Истина;
        ДДКарточка.Наименование = "ДД-VA ручное наименование";
        ДДКарточка.НаименованиеПолное = "ДД-VA ручное полное наименование";
        ДДКарточка.Партнер = ДДПартнер;
        ДДКарточка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
        ДДКарточка.ИНН = "7839012930";
        ДДКарточка.КПП = "781601001";
        ДДКарточка.ДополнительнаяИнформация = "ДД-VA: прочие данные сохраняются";
        ДДКарточка.Записать();
        ДДНайденные = ДД_КонтрагентыСервер.ПолучитьСведения(ДДКарточка);
        Если ДДНайденные.Количество() <> 1 Тогда ВызватьИсключение "Для контрольного ИНН и КПП нужен один результат"; КонецЕсли;
        ДДОжидаемые = Новый Структура;
        Для Каждого ДДПоле Из СтрРазделить("Наименование,НаименованиеПолное,ИНН,КПП,РегистрационныйНомер,КодПоОКПО,ЮридическийАдрес", ",") Цикл
            ДДОжидаемые.Вставить(ДДПоле, ДДНайденные[0][ДДПоле]);
        КонецЦикла;
        ДДОжидаемые.Вставить("Ссылка", ПолучитьНавигационнуюСсылку(ДДКарточка.Ссылка));
        ДДЗапись = Новый ЗаписьJSON;
        ДДЗапись.ОткрытьФайл("C:\Users\IT\Desktop\hakaton\1c\tmp\dadata-expected.json");
        ЗаписатьJSON(ДДЗапись, ДДОжидаемые);
        ДДЗапись.Закрыть();
        """

