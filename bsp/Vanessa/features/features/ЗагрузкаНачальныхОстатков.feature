Сценарий: Подготовка Excel и снимка документов
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Старая = ХранилищеОбщихНастроек.Загрузить("ЗНО_VA", "20261020");
        Если Старая <> Неопределено Тогда
            Если ЗначениеЗаполнено(Старая.Документ) Тогда ВызватьИсключение "Сначала очистите документ предыдущего прогона"; КонецЕсли;
            З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ВводОстатковТоваров"); Текущие = З.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
            Если Текущие.Количество() <> Старая.Снимок.Количество() Тогда ВызватьИсключение "Состав документов изменился после прерывания"; КонецЕсли;
            Для Каждого С Из Текущие Цикл Если Старая.Снимок.Найти(С) = Неопределено Тогда ВызватьИсключение "Найден новый документ после прерывания"; КонецЕсли; КонецЦикла;
            ХранилищеОбщихНастроек.Удалить("ЗНО_VA", "20261020", Неопределено);
        КонецЕсли;
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка, Т.Номенклатура, Т.Характеристика ИЗ Документ.ВводОстатковТоваров.Товары КАК Т
        |ГДЕ Т.Ссылка.Проведен И НЕ Т.Ссылка.ПометкаУдаления
        |И Т.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВводОстатковСобственныхТоваров) И Т.Количество > 0");
        В = З.Выполнить().Выбрать(); Если Не В.Следующий() Тогда ВызватьИсключение "Нет образца товаров"; КонецЕсли;
        Д = В.Ссылка.ПолучитьОбъект(); Н = ЗНО_ЗагрузкаСервер.НастройкиПоУмолчанию();
        Н.ДатаДокумента = Д.Дата; Н.Организация = Д.Организация; Н.Склад = Д.Склад; Н.Подразделение = Д.Подразделение; Н.Менеджер = Д.Менеджер;
        Н.Партия = Д.Партия;
        Если Д.ДетализацияПартий.Количество() > 0 Тогда Н.Партия = Д.ДетализацияПартий[0].ДокументПоступления; КонецЕсли;
        З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Партнеры ГДЕ НЕ ПометкаУдаления И Поставщик");
        П = З.Выполнить().Выбрать(); Если Не П.Следующий() Тогда ВызватьИсключение "Нет поставщика"; КонецЕсли; Н.Поставщик = П.Ссылка;
        Н.ПерваяСтрока = 2; Н.КолонкаХарактеристики = ?(ЗначениеЗаполнено(В.Характеристика), 4, 0);
        Для НомерФайла = 1 По 2 Цикл
            Т = Новый ТабличныйДокумент;
            Т.Область(1,1).Текст = "Код"; Т.Область(1,2).Текст = "Количество"; Т.Область(1,3).Текст = "Цена"; Т.Область(1,4).Текст = "Характеристика";
            Для Стр = 2 По 3 Цикл
                Т.Область(Стр,1).Текст = В.Номенклатура.Код; Т.Область(Стр,2).Текст = ?(Стр = 3 И НомерФайла = 1, "ошибка", Строка(Стр));
                Т.Область(Стр,3).Текст = "123,45"; Т.Область(Стр,4).Текст = Строка(В.Характеристика);
            КонецЦикла;
            Т.Записать("C:\Users\IT\Desktop\hakaton\1c\tmp\остатки-ui\source-" + Строка(НомерФайла) + ".xlsx", ТипФайлаТабличногоДокумента.XLSX);
        КонецЦикла;
        З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ВводОстатковТоваров"); Снимок = З.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
        Ф = Новый Структура("Настройки,Товар,Характеристика,Снимок,Документ", Н, В.Номенклатура, В.Характеристика, Снимок, Неопределено);
        ХранилищеОбщихНастроек.Сохранить("ЗНО_VA", "20261020", Ф);
        Текст = Новый ТекстовыйДокумент;
        Для Каждого К Из Н Цикл Текст.ДобавитьСтроку(К.Ключ + "=" + Строка(К.Значение)); КонецЦикла;
        Текст.ДобавитьСтроку("Товар=" + Строка(В.Номенклатура)); Текст.ДобавитьСтроку("Характеристика=" + Строка(В.Характеристика));
        Текст.Записать("C:\Users\IT\Desktop\hakaton\1c\tmp\остатки-ui\fixture.txt", КодировкаТекста.UTF8);
        """

