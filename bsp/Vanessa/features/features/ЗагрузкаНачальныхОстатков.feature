Сценарий: Очистка прерванного собственного прогона
    Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Ф = ХранилищеОбщихНастроек.Загрузить("ЗНО_VA", "20261020");
        Если Ф <> Неопределено Тогда
            НачатьТранзакцию();
            Попытка
                З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ВводОстатковТоваров");
                Для Каждого С Из З.Выполнить().Выгрузить() Цикл
                    Если Ф.Снимок.Найти(С.Ссылка) <> Неопределено Тогда Продолжить; КонецЕсли;
                    Д = С.Ссылка.ПолучитьОбъект();
                    Если ЗначениеЗаполнено(Ф.Документ) И С.Ссылка <> Ф.Документ Тогда ВызватьИсключение "Найден посторонний новый документ"; КонецЕсли;
                    Если Д.Организация <> Ф.Настройки.Организация Или Д.Склад <> Ф.Настройки.Склад
                        Или НачалоДня(Д.Дата) <> НачалоДня(Ф.Настройки.ДатаДокумента)
                        Или СтрНайти(Д.Комментарий, "Загрузка начальных остатков") = 0
                        Или Д.Товары.Количество() <> 2 Или Д.Товары.Итог("Количество") <> 5 Или Д.Товары.Итог("Сумма") <> 617.25 Тогда
                        ВызватьИсключение "Документ не соответствует фикстуре; удаление запрещено";
                    КонецЕсли;
                    Для Каждого Т Из Д.Товары Цикл
                        Если Т.Номенклатура <> Ф.Товар Или Т.Характеристика <> Ф.Характеристика Тогда ВызватьИсключение "Посторонние строки документа"; КонецЕсли;
                    КонецЦикла;
                    Если Д.Проведен Тогда Д.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
                    Д = С.Ссылка.ПолучитьОбъект();
                    Д.Удалить();
                КонецЦикла;
                З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ВводОстатковТоваров");
                Осталось = З.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
                Если Осталось.Количество() <> Ф.Снимок.Количество() Тогда ВызватьИсключение "После очистки изменился состав документов"; КонецЕсли;
                Для Каждого С Из Ф.Снимок Цикл Если Осталось.Найти(С) = Неопределено Тогда ВызватьИсключение "Потерян исходный документ"; КонецЕсли; КонецЦикла;
                ХранилищеОбщихНастроек.Удалить("ЗНО_VA", "20261020", Неопределено);
                ЗафиксироватьТранзакцию();
            Исключение
                ОтменитьТранзакцию(); ВызватьИсключение;
            КонецПопытки;
        КонецЕсли;
        Если ХранилищеОбщихНастроек.Загрузить("ЗНО_VA", "20261020") <> Неопределено Тогда ВызватьИсключение "Осталась фикстура"; КонецЕсли;
        """

