Функционал: WebP из макетов расширения без внешнего пути

Сценарий: Подготовка отдельных карточек и файлов WebP
    Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Маркер = "ЗТ-WebP-20261018-1625";
        Если Не Справочники.ВидыНоменклатуры.НайтиПоНаименованию(Маркер, Истина).Пустая() Тогда ВызватьИсключение "Фикстура уже существует"; КонецЕсли;
        НачатьТранзакцию();
        Попытка
            Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыНоменклатуры
            |ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа
            |И ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
            |И ИспользованиеХарактеристик = ЗНАЧЕНИЕ(Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать)
            |УПОРЯДОЧИТЬ ПО Наименование");
            Выборка = Запрос.Выполнить().Выбрать(); Если Не Выборка.Следующий() Тогда ВызватьИсключение "Нет вида для фикстуры"; КонецЕсли;
            Вид = Выборка.Ссылка.ПолучитьОбъект().Скопировать(); Вид.Наименование = Маркер;
            Вид.ИспользоватьСерии = Ложь; Вид.ОбменДанными.Загрузка = Истина; Вид.Записать();
            Единица = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоКоду("796");
            Если Единица.Пустая() Тогда ВызватьИсключение "Нет единицы 796"; КонецЕсли;
            Корень = "C:\Users\IT\Desktop\hakaton\1c\tmp\";
            Base64Значение("UklGRhwAAABXRUJQVlA4TA8AAAAvAUAAAAcQ0f/+ByKi/wEA").Записать(Корень + "products-webp-normal.webp");
            Base64Значение("UklGRoQAAABXRUJQVlA4WAoAAAACAAAAAwAAAQAAQU5JTQYAAAAAAAAAAABBTk1GKAAAAAAAAAAAAAMAAAEAAGQAAAJWUDhMDwAAAC8DQAAABxD9j/4HIqL/AQBBTk1GKAAAAAAAAAAAAAMAAAEAAGQAAABWUDhMDwAAAC8DQAAABxDR//4HIqL/AQA=").Записать(Корень + "products-webp-animation.webp");
            Документ = Новый ТабличныйДокумент;
            Заголовки = СтрРазделить("Артикул;Наименование;ВидНоменклатуры;ЕдиницаИзмерения;Изображения", ";");
            Для Колонка = 0 По Заголовки.Количество() - 1 Цикл Документ.Область(1, Колонка + 1).Текст = Заголовки[Колонка]; КонецЦикла;
            Для СтрокаФайла = 2 По 3 Цикл
                Документ.Область(СтрокаФайла,1).Текст = Маркер + "-" + Строка(СтрокаФайла);
                Документ.Область(СтрокаФайла,2).Текст = ?(СтрокаФайла = 2, "Товар с WebP", "Товар с анимированным WebP");
                Документ.Область(СтрокаФайла,3).Текст = Маркер;
                Документ.Область(СтрокаФайла,4).Текст = Единица.Наименование;
                Документ.Область(СтрокаФайла,5).Текст = Корень + ?(СтрокаФайла = 2, "products-webp-normal.webp", "products-webp-animation.webp");
            КонецЦикла;
            Документ.Записать(Корень + "products-webp-auto.xlsx", ТипФайлаТабличногоДокумента.XLSX);
            Если Метаданные.ОбщиеМодули.Найти("ЗТ_ТестыЗагрузки") <> Неопределено Тогда ВызватьИсключение "В поставке остался тестовый модуль"; КонецЕсли;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
        """

Сценарий: Чтение старой настройки и загрузка без указания декодера
    И я открываю навигационную ссылку "e1cib/app/Обработка.ЗТ_ЗагрузкаТоваров"
    И я перехожу к закладке с именем "СтраницаИзображений"
    И я выбираю файл "C:\Users\IT\Desktop\hakaton\1c\tmp\products-webp-auto.xlsx"
    И я нажимаю на кнопку с именем "ВыбратьФайл"
    И в поле с именем "ИмяНастройки" я ввожу текст "ЗТ-WebP-20261018-1625"
    И я нажимаю на кнопку с именем "СохранитьНастройку"
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Сохраненное = ХранилищеОбщихНастроек.Загрузить("ЗТ_ЗагрузкаТоваров", "ЗТ-WebP-20261018-1625");
        Если Сохраненное.Настройки.Свойство("КонвертерWebP") Тогда ВызватьИсключение "Новая настройка содержит внешний путь"; КонецЕсли;
        Сохраненное.Настройки.Вставить("КонвертерWebP", "Z:\несуществующий-декодер.exe");
        ХранилищеОбщихНастроек.Сохранить("ЗТ_ЗагрузкаТоваров", "ЗТ-WebP-20261018-1625", Сохраненное);
        """
    И я нажимаю на кнопку с именем "ПрочитатьНастройку"
    И я нажимаю на кнопку с именем "Проверить"
    Тогда таблица "Строки" содержит строки:
        | 'Строка' | 'Действие' |
        | '2'      | 'Создать'  |
        | '3'      | 'Создать'  |
    И я нажимаю на кнопку с именем "Загрузить"
    И я жду закрытия окна "Загрузка номенклатуры" в течение 120 секунд
    Тогда таблица "Строки" содержит строки:
        | 'Строка' | 'Действие' |
        | '2'      | 'Создан'   |
        | '3'      | 'Создан'   |

Сценарий: Повторное чтение картинок и повторная загрузка без дублей
    И я нажимаю на кнопку с именем "Проверить"
    И я нажимаю на кнопку с именем "Загрузить"
    И я жду закрытия окна "Загрузка номенклатуры" в течение 120 секунд
    Тогда таблица "Строки" содержит строки:
        | 'Строка' | 'Действие'        |
        | '2'      | 'Без изменений'   |
        | '3'      | 'Без изменений'   |
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Для НомерТовара = 2 По 3 Цикл
            Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "ЗТ-WebP-20261018-1625-" + Строка(НомерТовара));
            Если Товар.Пустая() Тогда ВызватьИсключение "Карточка не создана"; КонецЕсли;
            Объект = Товар.ПолучитьОбъект(); Объект.Прочитать();
            Если Не ЗначениеЗаполнено(Объект.ФайлКартинки) Тогда ВызватьИсключение "Не установлена картинка"; КонецЕсли;
            Данные = РаботаСФайлами.ДвоичныеДанныеФайла(Объект.ФайлКартинки); Картинка = Новый Картинка(Данные);
            Если Картинка.Ширина() <> ?(НомерТовара = 2, 2, 4) Тогда ВызватьИсключение "Неверная ширина картинки"; КонецЕсли;
            Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.НоменклатураПрисоединенныеФайлы ГДЕ ВладелецФайла = &Товар И НЕ ПометкаУдаления");
            Запрос.УстановитьПараметр("Товар", Товар); В = Запрос.Выполнить().Выбрать(); В.Следующий();
            Если В.Количество <> 1 Тогда ВызватьИсключение "Картинки продублированы"; КонецЕсли;
        КонецЦикла;
        """
    И я закрываю все окна клиентского приложения

Сценарий: Удаление только данных прогона WebP
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        НачатьТранзакцию();
        Попытка
            Вид = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("ЗТ-WebP-20261018-1625", Истина);
            Если Не Вид.Пустая() Тогда
                Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ ВидНоменклатуры = &Вид");
                Запрос.УстановитьПараметр("Вид", Вид); Товары = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
                Для Каждого Товар Из Товары Цикл
                    Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.НоменклатураПрисоединенныеФайлы ГДЕ ВладелецФайла = &Товар";
                    Запрос.УстановитьПараметр("Товар", Товар); Файлы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
                    Для Каждого Файл Из Файлы Цикл Файл.ПолучитьОбъект().Удалить(); КонецЦикла;
                    Набор = РегистрыСведений.НаличиеФайлов.СоздатьНаборЗаписей(); Набор.Отбор.ОбъектСФайлами.Установить(Товар); Набор.Записать();
                    Объект = Товар.ПолучитьОбъект(); Объект.ОбменДанными.Загрузка = Истина; Объект.Удалить();
                КонецЦикла;
                Объект = Вид.ПолучитьОбъект(); Объект.ОбменДанными.Загрузка = Истина; Объект.Удалить();
            КонецЕсли;
            ХранилищеОбщихНастроек.Удалить("ЗТ_ЗагрузкаТоваров", "ЗТ-WebP-20261018-1625", Неопределено);
            Если Не Справочники.ВидыНоменклатуры.НайтиПоНаименованию("ЗТ-WebP-20261018-1625", Истина).Пустая() Тогда ВызватьИсключение "Остались тестовые данные"; КонецЕсли;
            Если ХранилищеОбщихНастроек.Загрузить("ЗТ_ЗагрузкаТоваров", "ЗТ-WebP-20261018-1625") <> Неопределено Тогда ВызватьИсключение "Осталась тестовая настройка"; КонецЕсли;
            Для НомерТовара = 2 По 3 Цикл
                Если Не Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "ЗТ-WebP-20261018-1625-" + Строка(НомерТовара)).Пустая() Тогда ВызватьИсключение "Остался тестовый товар"; КонецЕсли;
            КонецЦикла;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию(); ВызватьИсключение;
        КонецПопытки;
        """
