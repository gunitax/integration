Сценарий: Пакетная печать пустой список и действующий счет-фактура
    Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        УШПротокол = Новый ТекстовыйДокумент;
        УШВыборка = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.РеализацияТоваровУслуг ГДЕ Комментарий ПОДОБНО &Метка И Дата >= ДАТАВРЕМЯ(2026,1,1)");
        УШВыборка.УстановитьПараметр("Метка","УШ приемка 20261025 %");
        УШМассив = УШВыборка.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
        Если УШМассив.Количество() <> 2 Тогда ВызватьИсключение "Ожидались две собственные реализации 2026 года";КонецЕсли;
        УШОбъекты = Новый СписокЗначений;
        УШТабДок = УШ_ПечатьСервер.Сформировать(УШМассив,УШОбъекты);
        Если УШОбъекты.Количество() <> 2 Или УШТабДок.НайтиТекст("4601234567893") = Неопределено Тогда ВызватьИсключение "Не прошла пакетная печать";КонецЕсли;
        Если УШ_ПечатьСервер.РежимПечатиВключен() Тогда ВызватьИсключение "Не сброшен режим пакетной печати";КонецЕсли;
        УШТабДок.Записать("C:\Users\IT\Desktop\hakaton\docs\reports\upd-barcode-20261025\batch.pdf",ТипФайлаТабличногоДокумента.PDF);
        УШПротокол.ДобавитьСтроку("PASS|Пакетная печать двух реализаций через установленный чистый CFE");
        УШПустой = УШ_ПечатьСервер.Сформировать(Новый Массив,Новый СписокЗначений);
        Если УШПустой.ВысотаТаблицы <> 0 Или УШ_ПечатьСервер.РежимПечатиВключен() Тогда ВызватьИсключение "Ошибка пустого списка";КонецЕсли;
        УШПротокол.ДобавитьСтроку("PASS|Пустой список документов");
        
        // Изменения штрихкодов настоящих товаров существуют только внутри откатываемой транзакции.
        НачатьТранзакцию();
        Попытка
            УШЗапрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
                |ИЗ Документ.РеализацияТоваровУслуг
                |ГДЕ Проведен И НЕ ПометкаУдаления
                |И Ссылка В (ВЫБРАТЬ ДокументОснование ИЗ Документ.СчетФактураВыданный.ДокументыОснования ГДЕ Ссылка.Проведен И НЕ Ссылка.ПометкаУдаления)
                |И Ссылка В (ВЫБРАТЬ Ссылка ИЗ Документ.РеализацияТоваровУслуг.ВидыЗапасов)");
            УШСтроки = УШЗапрос.Выполнить().Выбрать();
            Если Не УШСтроки.Следующий() Тогда ВызватьИсключение "Нет реализации с выставленным счетом-фактурой для проверки статуса 1";КонецЕсли;
            УШСсылка = УШСтроки.Ссылка;
            Для Каждого УШЗапас Из УШСсылка.ВидыЗапасов Цикл
                УШЗапись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
                УШЗапись.Номенклатура = УШЗапас.АналитикаУчетаНоменклатуры.Номенклатура;
                УШЗапись.Штрихкод = "0000000000000";УШЗапись.Записать();
            КонецЦикла;
            УШМассив = Новый Массив;УШМассив.Добавить(УШСсылка);
            УШОбъекты = Новый СписокЗначений;
            УШТабДок = УШ_ПечатьСервер.Сформировать(УШМассив,УШОбъекты);
            Если УШТабДок.НайтиТекст("0000000000000") = Неопределено Тогда ВызватьИсключение "Не подставлены штрихкоды в УПД со счетом-фактурой";КонецЕсли;
            УШТабДок.Записать("C:\Users\IT\Desktop\hakaton\docs\reports\upd-barcode-20261025\invoice-status1.pdf",ТипФайлаТабличногоДокумента.PDF);
            Если УШ_ПечатьСервер.РежимПечатиВключен() Тогда ВызватьИсключение "Не сброшен режим после печати счета-фактуры";КонецЕсли;
            УШПротокол.ДобавитьСтроку("PASS|УПД на основании действующей реализации с проведенным счетом-фактурой");
            ОтменитьТранзакцию();
        Исключение
            ОтменитьТранзакцию();ВызватьИсключение;
        КонецПопытки;
        УШПротокол.ДобавитьСтроку("PASS|Транзакция изменений настоящей номенклатуры отменена");
        УШПротокол.Записать("C:\Users\IT\Desktop\hakaton\docs\reports\upd-barcode-20261025\extra-checks.txt",КодировкаТекста.UTF8);
        """

Сценарий: Удаление собственных данных приемки
    Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl
        Протокол = Новый ТекстовыйДокумент;
        Протокол.Прочитать("C:\Users\IT\Desktop\hakaton\docs\reports\upd-barcode-20261025\ui-links.txt",КодировкаТекста.UTF8);
        Товары = Новый Массив;Ключи = Новый Массив;СобственныеДокументы = Новый Массив;
        Для Индекс = 1 По Протокол.КоличествоСтрок() Цикл
            Части = СтрРазделить(Протокол.ПолучитьСтроку(Индекс),"|");
            Если Части.Количество() <> 2 Тогда Продолжить;КонецЕсли;
            Если Части[0] = "Товар" Тогда Товары.Добавить(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Части[1])));
            ИначеЕсли Части[0] = "Ключ" Тогда Ключи.Добавить(Справочники.КлючиАналитикиУчетаНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Части[1])));
            ИначеЕсли Части[0] = "Документ" Тогда СобственныеДокументы.Добавить(Документы.РеализацияТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(Части[1])));
            КонецЕсли;
        КонецЦикла;
        Если Товары.Количество() <> 4 Или Ключи.Количество() <> 4 Или СобственныеДокументы.Количество() <> 4 Тогда ВызватьИсключение "Неоднозначный набор очистки";КонецЕсли;
        Для Каждого Ссылка Из Товары Цикл
            Если Лев(Ссылка.Артикул,13) <> "UPD-20261025-" Тогда ВызватьИсключение "Чужой товар";КонецЕсли;
        КонецЦикла;
        Для Каждого Ссылка Из Ключи Цикл
            Если Товары.Найти(Ссылка.Номенклатура) = Неопределено Тогда ВызватьИсключение "Чужой ключ";КонецЕсли;
        КонецЦикла;
        Для Каждого Ссылка Из СобственныеДокументы Цикл
            Если Не СтрНачинаетсяС(Ссылка.Комментарий, "УШ приемка 20261025 ") Или Ссылка.Проведен Тогда ВызватьИсключение "Чужой или проведенный документ";КонецЕсли;
        КонецЦикла;
        НачатьТранзакцию();
        Попытка
            Для Каждого Ссылка Из СобственныеДокументы Цикл
                Объект = Ссылка.ПолучитьОбъект();Объект.ОбменДанными.Загрузка = Истина;Объект.Удалить();
            КонецЦикла;
            Для Каждого Ссылка Из Товары Цикл
                Набор = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();Набор.Отбор.Номенклатура.Установить(Ссылка);Набор.Записать();
                Набор = РегистрыСведений.АналитикаУчетаНоменклатуры.СоздатьНаборЗаписей();Набор.Отбор.Номенклатура.Установить(Ссылка);Набор.Записать();
            КонецЦикла;
            Для Каждого Ссылка Из Ключи Цикл
                Объект = Ссылка.ПолучитьОбъект();Объект.ОбменДанными.Загрузка = Истина;Объект.Удалить();
            КонецЦикла;
            Для Каждого Ссылка Из Товары Цикл
                Объект = Ссылка.ПолучитьОбъект();Объект.ОбменДанными.Загрузка = Истина;Объект.Удалить();
            КонецЦикла;
            Для Каждого Ссылка Из СобственныеДокументы Цикл
                Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда ВызватьИсключение "Документ остался";КонецЕсли;
            КонецЦикла;
            Для Каждого Ссылка Из Товары Цикл
                Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда ВызватьИсключение "Товар остался";КонецЕсли;
            КонецЦикла;
            Для Каждого Ссылка Из Ключи Цикл
                Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда ВызватьИсключение "Ключ остался";КонецЕсли;
            КонецЦикла;
            Для Каждого ИмяРегистра Из СтрРазделить("ШтрихкодыНоменклатуры,АналитикаУчетаНоменклатуры",",") Цикл
                Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ РегистрСведений."+ИмяРегистра+" ГДЕ Номенклатура В (&Товары)");
                Запрос.УстановитьПараметр("Товары",Товары);Таблица = Запрос.Выполнить().Выгрузить();
                Если Таблица[0].Количество <> 0 Тогда ВызватьИсключение "Остались записи "+ИмяРегистра;КонецЕсли;
            КонецЦикла;
            ЗафиксироватьТранзакцию();
        Исключение
            ОтменитьТранзакцию();ВызватьИсключение;
        КонецПопытки;
        Итог = Новый ТекстовыйДокумент;Итог.ДобавитьСтроку("Удалены и проверены: четыре собственных документа, четыре товара, четыре ключа и их записи регистров.");
        Итог.Записать("C:\Users\IT\Desktop\hakaton\docs\reports\upd-barcode-20261025\cleanup.txt",КодировкаТекста.UTF8);
        """
    И я закрываю все окна клиентского приложения
