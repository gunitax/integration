                Если ВГМетаТаб.Реквизиты.Найти("ХарактеристикаНабора") <> Неопределено Тогда ВГСтрока.ХарактеристикаНабора = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();КонецЕсли;
                Если ВГМетаТаб.Реквизиты.Найти("КодСтроки") <> Неопределено Тогда ВГСтрока.КодСтроки = ВГСтрока.НомерСтроки;КонецЕсли;
                Если ВГМетаТаб.Реквизиты.Найти("Содержание") <> Неопределено Тогда ВГСтрока.Содержание = Строка(ВГСтрока.Номенклатура);КонецЕсли;
                Если ВГМетаТаб.Реквизиты.Найти("СуммаСНДС") <> Неопределено Тогда ВГСтрока.СуммаСНДС = ВГСтрока.Сумма;КонецЕсли;
                Для Каждого ВГПолеСуммы Из СтрРазделить("СуммаНДС,СуммаРучнойСкидки,СуммаАвтоматическойСкидки,ПроцентРучнойСкидки,ПроцентАвтоматическойСкидки",",") Цикл
                    Если ВГМетаТаб.Реквизиты.Найти(ВГПолеСуммы) <> Неопределено Тогда ВГСтрока[ВГПолеСуммы] = 0;КонецЕсли;
                КонецЦикла;
            КонецЦикла;
            ВГДокумент.Записать();
        КонецЦикла;
