            ВГОбъект = ВГСсылка.ПолучитьОбъект();ВГОбъект.ОбменДанными.Загрузка = Истина;ВГОбъект.НаименованиеПолное = ВГОбъект.Наименование;ВГОбъект.Записать();
        КонецЦикла;
