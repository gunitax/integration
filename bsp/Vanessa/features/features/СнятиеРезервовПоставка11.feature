Сценарий: Удаление собственных данных после проверки чистого CFE
    И я закрываю все окна клиентского приложения
    И я выполняю код встроенного языка на сервере (Расширение)
        """bsl

        
            Ф = ХранилищеОбщихНастроек.Загрузить("СР_VA","20261021",,""); Если Ф = Неопределено Тогда ВызватьИсключение "Нет активной собственной фикстуры"; КонецЕсли;
            Ссылки = Новый Массив; Ссылки.Добавить(Ф.Заказ); Для Каждого П Из Ф.Участники Цикл Ссылки.Добавить(П.Значение); КонецЦикла;
            НачатьТранзакцию();
            Попытка
                О = Ф.Заказ.ПолучитьОбъект();
                Если О <> Неопределено Тогда
                    Если О.Комментарий <> Ф.Маркер Тогда ВызватьИсключение "Удаление запрещено: маркер фикстуры не совпал"; КонецЕсли;
                    З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Задача.ЗадачаИсполнителя ГДЕ Предмет = &Заказ"); З.УстановитьПараметр("Заказ",Ф.Заказ);
                    Для Каждого С Из З.Выполнить().Выгрузить() Цикл С.Ссылка.ПолучитьОбъект().Удалить(); КонецЦикла;
                    Если О.Проведен Тогда О.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли; О = Ф.Заказ.ПолучитьОбъект(); О.Удалить();
                КонецЕсли;
                З = Новый Запрос("ВЫБРАТЬ Идентификатор ИЗ РегистрСведений.СР_ЖурналРезервов ГДЕ Заказ = &Заказ"); З.УстановитьПараметр("Заказ",Ф.Заказ);
                Для Каждого С Из З.Выполнить().Выгрузить() Цикл Запись = РегистрыСведений.СР_ЖурналРезервов.СоздатьМенеджерЗаписи(); Запись.Идентификатор = С.Идентификатор; Запись.Удалить(); КонецЦикла;
                Если Метаданные.РегистрыСведений.Найти("ССД_РезультатыСогласования") <> Неопределено Тогда
                    Набор = РегистрыСведений["ССД_РезультатыСогласования"].СоздатьНаборЗаписей(); Набор.Отбор.Объект.Установить(Ф.Заказ); Набор.Записать();
                КонецЕсли;
                Для Каждого ИмяУчастника Из СтрРазделить("Договор,Соглашение,Контрагент,Партнер",",") Цикл
                    СсылкаУчастника = Неопределено; Если Не Ф.Участники.Свойство(ИмяУчастника,СсылкаУчастника) Тогда Продолжить; КонецЕсли;
                    О = СсылкаУчастника.ПолучитьОбъект(); Если О = Неопределено Тогда Продолжить; КонецЕсли;
                    Если О.Наименование <> Лев(Ф.Маркер + " " + ИмяУчастника,100) Тогда ВызватьИсключение "Маркер участника не совпал"; КонецЕсли;
                    Если Метаданные.РегистрыСведений.Найти("ССД_РезультатыСогласования") <> Неопределено Тогда
                        Набор = РегистрыСведений["ССД_РезультатыСогласования"].СоздатьНаборЗаписей(); Набор.Отбор.Объект.Установить(СсылкаУчастника); Набор.Записать();
                    КонецЕсли;
                    О.Удалить();
                КонецЦикла;
                ХранилищеОбщихНастроек.Сохранить("СР_СнятиеРезервов","Настройки",Ф.ИсходныеНастройки,,"");
                ХранилищеОбщихНастроек.Сохранить("СР_VA","20261021",Неопределено,,""); ЗафиксироватьТранзакцию();
            Исключение Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли; ВызватьИсключение;
            КонецПопытки;
        
        Для Каждого С Из Ссылки Цикл Если С.ПолучитьОбъект() <> Неопределено Тогда ВызватьИсключение "Фикстура не удалена"; КонецЕсли; КонецЦикла;
        Вывод = Новый ТекстовыйДокумент; Вывод.УстановитьТекст("Проверено удаление объектов: " + Строка(Ссылки.Количество())); Вывод.Записать("C:\Users\IT\Desktop\hakaton\docs\reports\reserve-review-20261101\clean-cfe-cleanup.txt");
