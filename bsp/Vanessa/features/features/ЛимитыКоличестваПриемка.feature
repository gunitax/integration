Функционал: Количественные лимиты в форме заказа

Сценарий: Очистка предыдущих данных своего прогона
	Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Маркер = "ЛЗ-VA-20261009-A";
		Партнер = Справочники.Партнеры.НайтиПоНаименованию(Маркер, Истина);
		Если Не Партнер.Пустая() Тогда
		    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказПоставщику ГДЕ Партнер = &Партнер И ВЫРАЗИТЬ(Комментарий КАК СТРОКА(100)) = &Маркер");
		    Запрос.УстановитьПараметр("Партнер", Партнер);
		    Запрос.УстановитьПараметр("Маркер", Маркер);
		    Выборка = Запрос.Выполнить().Выбрать();
		    Пока Выборка.Следующий() Цикл
		        Заказ = Выборка.Ссылка.ПолучитьОбъект();
		        Если Заказ.Проведен Тогда Заказ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
		        Заказ = Выборка.Ссылка.ПолучитьОбъект();
		        Заказ.Удалить();
		    КонецЦикла;
		    Набор = РегистрыСведений.ЛЗ_ЛимитыНоменклатуры.СоздатьНаборЗаписей();
		    Набор.Отбор.Поставщик.Установить(Партнер);
		    Набор.Записать();
		    Имена = Новый Массив;
		    Имена.Добавить("СоглашенияСПоставщиками");
		    Имена.Добавить("ДоговорыКонтрагентов");
		    Имена.Добавить("Контрагенты");
		    Для Каждого Имя Из Имена Цикл
		        Ссылка = Справочники[Имя].НайтиПоНаименованию(Маркер, Истина);
		        Если Не Ссылка.Пустая() Тогда
		            ОбъектУдаления = Ссылка.ПолучитьОбъект();
		            Если ОбъектУдаления.Партнер <> Партнер Тогда ВызватьИсключение "Защита очистки: другой поставщик"; КонецЕсли;
		            ОбъектУдаления.ОбменДанными.Загрузка = Истина;
		            ОбъектУдаления.Удалить();
		        КонецЕсли;
		    КонецЦикла;
		    ОбъектУдаления = Партнер.ПолучитьОбъект();
		    ОбъектУдаления.ОбменДанными.Загрузка = Истина;
		    ОбъектУдаления.Удалить();
		КонецЕсли;
		"""

Сценарий: Подготовка изолированных данных
	Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		НачатьТранзакцию();
		Попытка
		    Маркер = "ЛЗ-VA-20261009-A";
		    Если Не Справочники.Партнеры.НайтиПоНаименованию(Маркер, Истина).Пустая() Тогда ВызватьИсключение "Тестовые данные уже существуют; сначала очистить свой предыдущий прогон"; КонецЕсли;
		    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ЗаказПоставщику ГДЕ Проведен И НЕ ПометкаУдаления И ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика) УПОРЯДОЧИТЬ ПО Дата");
		    Выборка = Запрос.Выполнить().Выбрать();
		    Если Не Выборка.Следующий() Тогда ВызватьИсключение "Нет образца заказа для фикстуры"; КонецЕсли;
		    Образец = Выборка.Ссылка;
		    Партнер = Образец.Партнер.ПолучитьОбъект().Скопировать();
		    Партнер.Наименование = Маркер;
		    Партнер.ОбменДанными.Загрузка = Истина;
		    Партнер.Записать();
		    Контрагент = Образец.Контрагент.ПолучитьОбъект().Скопировать();
		    Контрагент.Наименование = Маркер;
		    Контрагент.Партнер = Партнер.Ссылка;
		    Контрагент.ОбменДанными.Загрузка = Истина;
		    Контрагент.Записать();
		    Соглашение = Образец.Соглашение.ПолучитьОбъект().Скопировать();
		    Соглашение.Наименование = Маркер;
		    Соглашение.Партнер = Партнер.Ссылка;
		    Соглашение.Контрагент = Контрагент.Ссылка;
		    Соглашение.ДатаОкончанияДействия = Дата(1,1,1);
		    Соглашение.ОбменДанными.Загрузка = Истина;
		    Соглашение.Записать();
		    Договор = Образец.Договор;
		    Если ЗначениеЗаполнено(Договор) Тогда
		        НовыйДоговор = Договор.ПолучитьОбъект().Скопировать();
		        НовыйДоговор.Наименование = Маркер;
		        НовыйДоговор.Партнер = Партнер.Ссылка;
		        НовыйДоговор.Контрагент = Контрагент.Ссылка;
		        НовыйДоговор.ДатаОкончанияДействия = Дата(1,1,1);
		        НовыйДоговор.ОбменДанными.Загрузка = Истина;
		        НовыйДоговор.Записать();
		        Договор = НовыйДоговор.Ссылка;
		    КонецЕсли;
		    Заказ = Образец.ПолучитьОбъект().Скопировать();
		    Заказ.Дата = Дата(2099,1,15,12,0,0);
		    Заказ.Партнер = Партнер.Ссылка;
		    Заказ.Контрагент = Контрагент.Ссылка;
		    Заказ.Соглашение = Соглашение.Ссылка;
		    Заказ.Договор = Договор;
		    Заказ.Комментарий = Маркер;
		    Заказ.Статус = Перечисления.СтатусыЗаказовПоставщикам.Согласован;
		    Заказ.РегистрироватьЦеныПоставщика = Ложь;
		    Заказ.ЖелаемаяДатаПоступления = Дата(2099,1,16);
		    Заказ.ДатаПоступления = Дата(2099,1,16);
		    Заказ.ДатаОтгрузки = Дата(2099,1,16);
		    Заказ.ДатаСогласования = Дата(2099,1,15);
		    Пока Заказ.Товары.Количество() > 1 Цикл Заказ.Товары.Удалить(Заказ.Товары.Количество()-1); КонецЦикла;
		    СтрокаТовара = Заказ.Товары[0];
		    СтрокаТовара.Количество = 6;
		    СтрокаТовара.КоличествоУпаковок = 6;
		    СтрокаТовара.Цена = 100;
		    СтрокаТовара.Сумма = 600;
		    СтрокаТовара.СуммаСНДС = 600;
		    СтрокаТовара.СуммаНДС = 100;
		    СтрокаТовара.ДатаПоступления = Дата(2099,1,16);
		    СтрокаТовара.ДатаОтгрузки = Дата(2099,1,16);
		    Заказ.СуммаДокумента = 600;
		    Заказ.ЭтапыГрафикаОплаты.Очистить();
		    Заказ.ОбменДанными.Загрузка = Истина;
		    Заказ.Записать();
		    ЗафиксироватьТранзакцию();
		Исключение
		    ОтменитьТранзакцию();
		    ВызватьИсключение;
		КонецПопытки;
		"""

Сценарий: Нет лимита — отказ проведения и сохранение черновика
	Дано я подключаю TestClient "УТ" логин "Администратор" пароль ""
	И я закрываю все окна клиентского приложения
	И Я запоминаю в переменную "Код" значение
		"""bsl
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказПоставщику ГДЕ ВЫРАЗИТЬ(Комментарий КАК СТРОКА(100)) = &Маркер"); Запрос.УстановитьПараметр("Маркер", "ЛЗ-VA-20261009-A"); Выборка = Запрос.Выполнить().Выбрать(); Если Не Выборка.Следующий() Тогда ВызватьИсключение "Нет тестового заказа"; КонецЕсли; ЗначениеДляВозврата = ПолучитьНавигационнуюСсылку(Выборка.Ссылка);
		"""
	И Я запоминаю значение выражения на сервере '$Код$' в переменную "Заказ" (Расширение)
	И я открываю навигационную ссылку "$Заказ$"
	И элемент формы с именем "ЛЗ_Состояние" стал равен "*лимит не установлен*" по шаблону
	И я нажимаю на кнопку с именем "ФормаПровести"
	И я нажимаю на кнопку с именем "OK"
	Тогда в логе сообщений TestClient есть строки:
		| "Превышен количественный лимит или не задан лимит товара" |
	И я нажимаю на кнопку с именем "ФормаЗаписать"
	И я делаю 10 раз
		И Я запоминаю в переменную "Код" значение
			"""bsl
			Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ЗаказПоставщику ГДЕ ВЫРАЗИТЬ(Комментарий КАК СТРОКА(100)) = &Маркер"); Запрос.УстановитьПараметр("Маркер", "ЛЗ-VA-20261009-A"); Выборка = Запрос.Выполнить().Выбрать(); Если Не Выборка.Следующий() Тогда ВызватьИсключение "Нет тестового заказа"; КонецЕсли; Заказ = Выборка.Ссылка.ПолучитьОбъект(); ЗначениеДляВозврата = Не Заказ.Проведен И Заказ.Товары[0].Количество = 6;
			"""
		И Я запоминаю значение выражения на сервере '$Код$' в переменную "Проверка" (Расширение)
		Если выражение внутреннего языка 'Строка(Контекст.Проверка) = "Да"' Истинно
			Тогда я прерываю цикл
		И Пауза 1
	И выражение внутреннего языка 'Строка(Контекст.Проверка) = "Да"' Истинно

