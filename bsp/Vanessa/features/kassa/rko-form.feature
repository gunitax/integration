# language: ru
Функционал: Внешний вид расходного кассового ордера (расширение «Кассовые документы»)
	Приемочные проверки формы документа КД_РасходныйКассовыйОрдер по образцу формы РКО УТ 11.5:
	вкладки «Основное / Расшифровка платежа / Печать», режим «Без разбитения / Списком»,
	гиперссылки заявки и документа-основания, список работников, синхронизация
	сумм, низ формы. Существование элементов проверяется действиями над ними,
	итоговый вид — скриншотами. Перед прогоном выполнить rko-prep.feature
	отдельным запуском va.ps1.

Контекст:
	Дано я подключаю TestClient "Демо" логин "Администратор" пароль ""

Сценарий: Форма нового РКО соответствует образцу
	И я закрываю все окна клиентского приложения
	И я открываю навигационную ссылку "e1cib/data/Документ.КД_РасходныйКассовыйОрдер"
	Тогда открылось окно "*Расходный кассовый ордер*"
	И из выпадающего списка с именем 'Операция' я выбираю точное значение 'Выдача подотчетнику'
	И в поле с именем 'Касса' я ввожу текст 'Торговый дом'
	И из выпадающего списка с именем 'Касса' я выбираю по строке 'Торговый дом "Комплексный'
	И в поле с именем 'ПодотчетноеЛицо' я ввожу текст 'Авдеева'
	И из выпадающего списка с именем 'ПодотчетноеЛицо' я выбираю по строке 'Авдеева'
	И в поле с именем 'Подразделение' я ввожу текст 'Отдел закупок'
	И из выпадающего списка с именем 'Подразделение' я выбираю по строке 'Отдел закупок'
	И в поле с именем 'СуммаДокумента' я ввожу текст '40000'
	И в поле с именем 'ДатаАвансовогоОтчета' я ввожу текст '12.04.2020'
	И я нажимаю на кнопку с именем 'СписокРаботников'
	И я нажимаю на кнопку с именем 'ТребуетсяНастройка'
	И я жду, что в сообщениях пользователю будет подстрока 'Настройка параметров выплаты не реализована' в течение 30 секунд
	И я нажимаю на кнопку с именем 'СписокРаботников'
	И я перехожу к закладке 'Расшифровка платежа (1)'
	И я нажимаю на кнопку с именем 'КнопкаСписком'
	И я нажимаю на кнопку с именем 'КнопкаБезРазбитения'
	И в поле с именем 'ЗаявкаНаРасходДС' я ввожу текст 'Заявка на расходование ДС ТД00-000008 от 10.04.2022 23:59:59'
	И в поле с именем 'СуммаВзаиморасчетов' я ввожу текст '40000'
	И в поле с именем 'ВалютаРасшифровки' я ввожу текст 'RUB'
	И из выпадающего списка с именем 'ВалютаРасшифровки' я выбираю по строке 'RUB'
	И в поле с именем 'СтатьяДДС' я ввожу текст 'Выдача ДС'
	И из выпадающего списка с именем 'СтатьяДДС' я выбираю по строке 'Выдача ДС подотчетному лицу'
	И в поле с именем 'КомментарийРасшифровки' я ввожу текст 'ВА расшифровка'
	И я перехожу к закладке 'Печать'
	И в поле с именем 'Основание' я ввожу текст 'Заявка на расходование денежных средств 8 от 10.04.2015'
	И в поле с именем 'Руководитель' я ввожу текст 'Бажиев'
	И из выпадающего списка с именем 'Руководитель' я выбираю по строке 'Бажиев'
	И в поле с именем 'ГлавныйБухгалтер' я ввожу текст 'Кострова'
	И из выпадающего списка с именем 'ГлавныйБухгалтер' я выбираю по строке 'Кострова'
	И я перехожу к закладке 'Основное'
	И в поле с именем 'Комментарий' я ввожу текст 'ВА форма РКО'
	И я нажимаю на кнопку с именем 'ФормаПровестиИЗакрыть'
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.КД_РасходныйКассовыйОрдер ГДЕ Проведен = ИСТИНА И СуммаДокумента = 40000 УПОРЯДОЧИТЬ ПО МоментВремени УБЫВ");
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() = 0 Тогда
			ВызватьИсключение "Не найден проведенный РКО на 40000";
		КонецЕсли;
		Док = Таблица[0].Ссылка.ПолучитьОбъект();
		Ошибки = Новый Массив;
		Если Док.Комментарий <> "ВА форма РКО" Тогда
			Ошибки.Добавить("комментарий " + Док.Комментарий);
		КонецЕсли;
		Если Не Док.Проведен Тогда
			Ошибки.Добавить("документ не проведен");
		КонецЕсли;
		Если Док.СуммаДокумента <> 40000 Тогда
			Ошибки.Добавить("сумма документа " + Док.СуммаДокумента);
		КонецЕсли;
		Если Строка(Док.Операция) <> "Выдача подотчетнику" Тогда
			Ошибки.Добавить("операция " + Строка(Док.Операция));
		КонецЕсли;
		Если Док.Касса <> Справочники._ДемоКассы.НайтиПоНаименованию("Торговый дом ""Комплексный"" (RUB)", Истина) Тогда
			Ошибки.Добавить("касса не заполнена");
		КонецЕсли;
		Если Док.ПодотчетноеЛицо <> Справочники._ДемоФизическиеЛица.НайтиПоНаименованию("Авдеева Аделина Павловна", Истина) Тогда
			Ошибки.Добавить("подотчетное лицо не заполнено");
		КонецЕсли;
		Если Док.Подразделение <> Справочники._ДемоПодразделения.НайтиПоНаименованию("Отдел закупок торгового направления", Истина) Тогда
			Ошибки.Добавить("подразделение не заполнено");
		КонецЕсли;
		Если Док.ДатаАвансовогоОтчета <> Дата(2020, 4, 12) Тогда
			Ошибки.Добавить("дата авансового отчета " + Док.ДатаАвансовогоОтчета);
		КонецЕсли;
		Если Строка(Док.Выдать) <> "Авдеева Аделина Павловна" Тогда
			Ошибки.Добавить("поле Выдать: " + Док.Выдать);
		КонецЕсли;
		Если Док.Основание <> "Заявка на расходование денежных средств 8 от 10.04.2015" Тогда
			Ошибки.Добавить("основание " + Док.Основание);
		КонецЕсли;
		Если Док.Руководитель <> Справочники._ДемоФизическиеЛица.НайтиПоНаименованию("Бажиев П.И.", Истина) Тогда
			Ошибки.Добавить("руководитель не заполнен");
		КонецЕсли;
		Если Док.ГлавныйБухгалтер <> Справочники._ДемоФизическиеЛица.НайтиПоНаименованию("Кострова В.Б.", Истина) Тогда
			Ошибки.Добавить("главный бухгалтер не заполнен");
		КонецЕсли;
		Если Док.РасшифровкаПлатежа.Количество() <> 1 Тогда
			Ошибки.Добавить("строк расшифровки " + Док.РасшифровкаПлатежа.Количество());
		Иначе
			Строка = Док.РасшифровкаПлатежа[0];
			Если Строка.Сумма <> 40000 Тогда
				Ошибки.Добавить("сумма строки расшифровки " + Строка.Сумма);
			КонецЕсли;
			Если Строка.СуммаВзаиморасчетов <> 40000 Тогда
				Ошибки.Добавить("сумма взаиморасчетов строки " + Строка.СуммаВзаиморасчетов);
			КонецЕсли;
			Если Строка.ВалютаВзаиморасчетов <> Справочники.Валюты.НайтиПоНаименованию("RUB", Истина) Тогда
				Ошибки.Добавить("валюта строки не заполнена");
			КонецЕсли;
			Если Строка.СтатьяДДС <> Справочники.КД_СтатьиДДС.НайтиПоНаименованию("Выдача ДС подотчетному лицу (прочие цели)", Истина) Тогда
				Ошибки.Добавить("статья ДДС строки не заполнена");
			КонецЕсли;
			Если Строка.ЗаявкаНаРасходованиеДенежныхСредств <> "Заявка на расходование ДС ТД00-000008 от 10.04.2022 23:59:59" Тогда
				Ошибки.Добавить("заявка строки: " + Строка.ЗаявкаНаРасходованиеДенежныхСредств);
			КонецЕсли;
			Если Строка.Комментарий <> "ВА расшифровка" Тогда
				Ошибки.Добавить("комментарий строки " + Строка.Комментарий);
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Док.Ответственный) Тогда
			Ошибки.Добавить("автор не заполнен (ОбработкаЗаполнения не сработала)");
		КонецЕсли;

		// Заполняем заявки, документ-основание и флажок шапки — они отображаются в форме.
		Док.ЗаявкаНаРасходованиеДенежныхСредств = "Заявка на расходование ДС ТД00-000008 от 10.04.2022 23:59:59";
		Док.ДокументОснование = "Заявка на расходование ДС ТД00-000008 от 10.04.2022 23:59:59";
		Док.ОплатаПоЗаявке = Истина;
		Док.Записать();

		Если Ошибки.Количество() > 0 Тогда
			ВызватьИсключение "РКО записан неверно: " + СтрСоединить(Ошибки, ", ");
		КонецЕсли;
		"""
	И я открываю навигационную ссылку "e1cib/list/Документ.КД_РасходныйКассовыйОрдер"
	Тогда открылось окно "*Расходные кассовые ордера*"
	И в таблице 'Список' я выбираю текущую строку
	Тогда открылось окно "*Расходный кассовый ордер*"
	И Я делаю паузу 6 секунды
	И я сохраняю скриншот "C:\temp\va-rko-form-01.png"
	И я перехожу к закладке 'Расшифровка платежа (1)'
	И Я делаю паузу 3 секунды
	И я сохраняю скриншот "C:\temp\va-rko-form-02.png"
	И я перехожу к закладке 'Печать'
	И Я делаю паузу 3 секунды
	И я сохраняю скриншот "C:\temp\va-rko-form-03.png"

Сценарий: Очистка данных сценария
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Удалено = 0;
		Выб = Документы.КД_РасходныйКассовыйОрдер.Выбрать();
		Пока Выб.Следующий() Цикл
			Если Выб.Комментарий = "ВА форма РКО" Тогда
				Документ = Выб.Ссылка.ПолучитьОбъект();
				Если Документ.Проведен Тогда
					Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				// Подписка БСП запрещает прямое удаление — обходим режимом загрузки.
				Документ.ОбменДанными.Загрузка = Истина;
				Документ.Удалить();
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
		Если Удалено = 0 Тогда
			ВызватьИсключение "Не найдено ни одного документа ВА форма РКО для очистки";
		КонецЕсли;
		Сообщить("ВА-очистка: удалено документов " + Удалено);
		"""
