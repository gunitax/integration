# language: ru
Функционал: Подготовка тестовой базы для приёмки кассовых документов
	Назначение роли КД_ пользователю и создание демо-данных для формы ПКО.
	Изменения применяются к новым сеансам, поэтому прогон выполняется до основного
	прогона приёмки (pko-form.feature) отдельным запуском va.ps1.

Контекст:
	Дано я подключаю TestClient "Демо" логин "Администратор" пароль ""

Сценарий: Роль пользователю и демо-данные
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Изменения = Новый Массив;

		Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		ЕстьРоль = Ложь;
		Для Каждого Роль Из Пользователь.Роли Цикл
			Если Роль.Имя = "КД_ДобавлениеИзменениеКассовыхДокументов" Тогда
				ЕстьРоль = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьРоль Тогда
			РольМетаданных = Метаданные.Роли.Найти("КД_ДобавлениеИзменениеКассовыхДокументов");
			Если РольМетаданных = Неопределено Тогда
				ВызватьИсключение "Роль КД_ДобавлениеИзменениеКассовыхДокументов не найдена в Метаданные.Роли";
			КонецЕсли;
			Пользователь.Роли.Добавить(РольМетаданных);
			Пользователь.Записать();
			Изменения.Добавить("роль КД_ назначена пользователю " + Пользователь.Имя);
		КонецЕсли;

		Если Справочники._ДемоКассы.НайтиПоНаименованию("Касса (Новые технологии ООО)", Истина).Пустая() Тогда
			Касса = Справочники._ДемоКассы.СоздатьЭлемент();
			Касса.Наименование = "Касса (Новые технологии ООО)";
			Попытка
				Касса.Записать();
			Исключение
				// Обычной записи может мешать подписка БСП на организационные данные тестовой базы.
				Касса = Справочники._ДемоКассы.СоздатьЭлемент();
				Касса.Наименование = "Касса (Новые технологии ООО)";
				Касса.ОбменДанными.Загрузка = Истина;
				Касса.Записать();
			КонецПопытки;
			Изменения.Добавить("создана касса");
		КонецЕсли;

		Если Справочники._ДемоПодразделения.НайтиПоНаименованию("Отдел продаж", Истина).Пустая() Тогда
			Подразделение = Справочники._ДемоПодразделения.СоздатьЭлемент();
			Подразделение.Наименование = "Отдел продаж";
			Попытка
				Подразделение.Записать();
			Исключение
				Подразделение = Справочники._ДемоПодразделения.СоздатьЭлемент();
				Подразделение.Наименование = "Отдел продаж";
				Подразделение.ОбменДанными.Загрузка = Истина;
				Подразделение.Записать();
			КонецПопытки;
			Изменения.Добавить("создано подразделение");
		КонецЕсли;

		Сообщить("ВА-подготовка: " + ?(Изменения.Количество() = 0, "изменений не потребовалось", СтрСоединить(Изменения, ", ")));
		"""
