# language: ru
Функционал: Подготовка тестовой базы для приёмки расходного кассового ордера
	Демо-данные для формы РКО по образцу УТ 11.5: касса, подотчетные лица,
	руководитель, главный бухгалтер, подразделение, статья ДДС, валюта RUB.
	Роль КД_ назначается идемпотентно. Изменения применяются к новым сеансам,
	поэтому прогон выполняется до основного прогона приёмки (rko-form.feature)
	отдельным запуском va.ps1.

Контекст:
	Дано я подключаю TestClient "Демо" логин "Администратор" пароль ""

Сценарий: Роль пользователю и демо-данные для РКО
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Изменения = Новый Массив;

		Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
		ЕстьРоль = Ложь;
		Для Каждого Роль Из Пользователь.Роли Цикл
			Если Роль.Имя = "КД_ДобавлениеИзменениеКассовыхДокументов" Тогда
				ЕстьРоль = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не ЕстьРоль Тогда
			РольМетаданных = Метаданные.Роли.Найти("КД_ДобавлениеИзменениеКассовыхДокументов");
			Если РольМетаданных = Неопределено Тогда
				ВызватьИсключение "Роль КД_ДобавлениеИзменениеКассовыхДокументов не найдена в Метаданные.Роли";
			КонецЕсли;
			Пользователь.Роли.Добавить(РольМетаданных);
			Пользователь.Записать();
			Изменения.Добавить("роль КД_ назначена пользователю " + Пользователь.Имя);
		КонецЕсли;

		// Касса по образцу скриншота.
		Если Справочники._ДемоКассы.НайтиПоНаименованию("Торговый дом ""Комплексный"" (RUB)", Истина).Пустая() Тогда
			Касса = Справочники._ДемоКассы.СоздатьЭлемент();
			Касса.Наименование = "Торговый дом ""Комплексный"" (RUB)";
			Попытка
				Касса.Записать();
			Исключение
				Касса = Справочники._ДемоКассы.СоздатьЭлемент();
				Касса.Наименование = "Торговый дом ""Комплексный"" (RUB)";
				Касса.ОбменДанными.Загрузка = Истина;
				Касса.Записать();
			КонецПопытки;
			Изменения.Добавить("создана касса");
		КонецЕсли;

		// Физические лица: подотчетное лицо, руководитель, главный бухгалтер, кассир.
		Для Каждого ФИО Из СтрРазделить("Авдеева Аделина Павловна|Бажиев П.И.|Кострова В.Б.", "|") Цикл
			Если Справочники._ДемоФизическиеЛица.НайтиПоНаименованию(ФИО, Истина).Пустая() Тогда
				Лицо = Справочники._ДемоФизическиеЛица.СоздатьЭлемент();
				Лицо.Наименование = ФИО;
				Попытка
					Лицо.Записать();
				Исключение
					Лицо = Справочники._ДемоФизическиеЛица.СоздатьЭлемент();
					Лицо.Наименование = ФИО;
					Лицо.ОбменДанными.Загрузка = Истина;
					Лицо.Записать();
				КонецПопытки;
				Изменения.Добавить("создано физлицо " + ФИО);
			КонецЕсли;
		КонецЦикла;

		// Подразделение по образцу скриншота.
		Если Справочники._ДемоПодразделения.НайтиПоНаименованию("Отдел закупок торгового направления", Истина).Пустая() Тогда
			Подразделение = Справочники._ДемоПодразделения.СоздатьЭлемент();
			Подразделение.Наименование = "Отдел закупок торгового направления";
			Попытка
				Подразделение.Записать();
			Исключение
				Подразделение = Справочники._ДемоПодразделения.СоздатьЭлемент();
				Подразделение.Наименование = "Отдел закупок торгового направления";
				Подразделение.ОбменДанными.Загрузка = Истина;
				Подразделение.Записать();
			КонецПопытки;
			Изменения.Добавить("создано подразделение");
		КонецЕсли;

		// Статья ДДС по образцу скриншота.
		Если Справочники.КД_СтатьиДДС.НайтиПоНаименованию("Выдача ДС подотчетному лицу (прочие цели)", Истина).Пустая() Тогда
			Статья = Справочники.КД_СтатьиДДС.СоздатьЭлемент();
			Статья.Наименование = "Выдача ДС подотчетному лицу (прочие цели)";
			Статья.Записать();
			Изменения.Добавить("создана статья ДДС");
		КонецЕсли;

		// Валюта RUB для расшифровки платежа.
		Если Справочники.Валюты.НайтиПоНаименованию("RUB", Истина).Пустая() Тогда
			Валюта = Справочники.Валюты.СоздатьЭлемент();
			Валюта.Наименование = "RUB";
			Валюта.Код = "643";
			Попытка
				Валюта.Записать();
			Исключение
				Валюта = Справочники.Валюты.СоздатьЭлемент();
				Валюта.Наименование = "RUB";
				Валюта.Код = "643";
				Валюта.ОбменДанными.Загрузка = Истина;
				Валюта.Записать();
			КонецПопытки;
			Изменения.Добавить("создана валюта RUB");
		КонецЕсли;

		Сообщить("ВА-подготовка РКО: " + ?(Изменения.Количество() = 0, "изменений не потребовалось", СтрСоединить(Изменения, ", ")));
		"""
