# language: ru
Функционал: Внешний вид приходного кассового ордера (расширение «Кассовые документы»)
	Приемочные проверки формы документа КД_ПриходныйКассовыйОрдер по образцу формы ПКО:
	состав реквизитов основной страницы, вкладки «Основное / Расшифровка платежа / Печать»,
	главная кнопка «Провести и закрыть», гиперссылка «Чек не пробит», печать документа,
	синхронизация расшифровки платежа с суммой, низ формы.
	Существование элементов проверяется действиями над ними, итоговый вид — скриншотами.
	Перед прогоном выполнить pko-prep.feature отдельным запуском va.ps1.

Контекст:
	Дано я подключаю TestClient "Демо" логин "Администратор" пароль ""

Сценарий: Форма нового ПКО соответствует образцу
	И я закрываю все окна клиентского приложения
	И я открываю навигационную ссылку "e1cib/data/Документ.КД_ПриходныйКассовыйОрдер"
	Тогда открылось окно "*Приходный кассовый ордер*"
	И я нажимаю на кнопку с именем 'ЧекНеПробит'
	И я жду, что в сообщениях пользователю будет подстрока 'Кассовый чек не пробит' в течение 30 секунд
	И из выпадающего списка с именем 'Операция' я выбираю точное значение 'Поступление оплаты от клиента'
	И из выпадающего списка с именем 'СтавкаНДС' я выбираю точное значение 'Без налога (НДС)'
	И в поле с именем 'Касса' я ввожу текст 'Касса (Новые технологии ООО)'
	И из выпадающего списка с именем 'Касса' я выбираю по строке 'Касса (Новые технологии'
	И в поле с именем 'СуммаДокумента' я ввожу текст '1500'
	И в поле с именем 'Комментарий' я ввожу текст 'ВА форма'
	И в поле с именем 'Подразделение' я ввожу текст 'Отдел продаж'
	И из выпадающего списка с именем 'Подразделение' я выбираю по строке 'Отдел продаж'
	И я нажимаю на кнопку с именем 'ВставитьНДС'
	И я сохраняю скриншот "C:\temp\va-pko-form-01.png"
	И я нажимаю на кнопку с именем 'ФормаПровестиИЗакрыть'
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.КД_ПриходныйКассовыйОрдер ГДЕ Проведен = ИСТИНА И СуммаДокумента = 1500 УПОРЯДОЧИТЬ ПО МоментВремени УБЫВ");
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() = 0 Тогда
			ВызватьИсключение "Не найден проведенный документ на 1500";
		КонецЕсли;
		Док = Таблица[0].Ссылка.ПолучитьОбъект();
		Ошибки = Новый Массив;
		Если Док.Комментарий <> "ВА форма" Тогда
			Ошибки.Добавить("комментарий " + Док.Комментарий);
		КонецЕсли;
		Если Не Док.Проведен Тогда
			Ошибки.Добавить("документ не проведен");
		КонецЕсли;
		Если Док.СуммаДокумента <> 1500 Тогда
			Ошибки.Добавить("сумма документа " + Док.СуммаДокумента);
		КонецЕсли;
		Если Док.РасшифровкаПлатежа.Количество() <> 1 Тогда
			Ошибки.Добавить("строк расшифровки " + Док.РасшифровкаПлатежа.Количество());
		ИначеЕсли Док.РасшифровкаПлатежа[0].Сумма <> 1500 Тогда
			Ошибки.Добавить("сумма строки расшифровки " + Док.РасшифровкаПлатежа[0].Сумма);
		КонецЕсли;
		Если Строка(Док.Операция) <> "Поступление оплаты от клиента" Тогда
			Ошибки.Добавить("операция " + Строка(Док.Операция));
		КонецЕсли;
		Если Строка(Док.СтавкаНДС) <> "Без налога (НДС)" Тогда
			Ошибки.Добавить("ставка НДС " + Строка(Док.СтавкаНДС));
		КонецЕсли;
		Если Док.Касса <> Справочники._ДемоКассы.НайтиПоНаименованию("Касса (Новые технологии ООО)", Истина) Тогда
			Ошибки.Добавить("касса не заполнена");
		КонецЕсли;
		Если Док.Подразделение <> Справочники._ДемоПодразделения.НайтиПоНаименованию("Отдел продаж", Истина) Тогда
			Ошибки.Добавить("подразделение не заполнено");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Док.Ответственный) Тогда
			Ошибки.Добавить("автор не заполнен (ОбработкаЗаполнения не сработала)");
		КонецЕсли;
		Если Ошибки.Количество() > 0 Тогда
			ВызватьИсключение "ПКО записан неверно: " + СтрСоединить(Ошибки, ", ");
		КонецЕсли;
		"""

Сценарий: Очистка данных сценария
	И я закрываю все окна клиентского приложения
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Удалено = 0;
		Выб = Документы.КД_ПриходныйКассовыйОрдер.Выбрать();
		Пока Выб.Следующий() Цикл
			Если Выб.Комментарий = "ВА форма" Тогда
				Документ = Выб.Ссылка.ПолучитьОбъект();
				Если Документ.Проведен Тогда
					Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				// Подписка БСП запрещает прямое удаление — обходим режимом загрузки.
				Документ.ОбменДанными.Загрузка = Истина;
				Документ.Удалить();
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
		Если Удалено = 0 Тогда
			ВызватьИсключение "Не найдено ни одного документа ВА форма для очистки";
		КонецЕсли;
		Сообщить("ВА-очистка: удалено документов " + Удалено);
		"""
