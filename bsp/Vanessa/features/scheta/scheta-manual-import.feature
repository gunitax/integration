Сценарий: Кадр раздела «Протокол и ненайденные элементы»
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		// Товар «ИНТЕГ-НЕТ» мог попасть в приёмник через обмен goods (экспорт выгружает
		// все номенклатуры источника) — удаляем его, иначе сопоставление его найдёт
		НайденныйТовар = Справочники.Товары.НайтиПоРеквизиту("Артикул", "ИНТЕГ-НЕТ");
		Если Не НайденныйТовар.Пустая() Тогда
			ОбъектТовара = НайденныйТовар.ПолучитьОбъект();
			ОбъектТовара.ОбменДанными.Загрузка = Истина;
			ОбъектТовара.Удалить();
		КонецЕсли;
		// Счёт ИНТ-1001 заменяется на вариант с ненайденным товаром
		Соединитель = Новый COMОбъект("V85.ComConnector");
		Источник = Соединитель.Connect("File=""C:\Users\sax\Documents\InfoBase22"";Usr=""Администратор"";");
		Организация = ИСШ_ТестовыеДанные.ОрганизацияИсточника(Источник);
		Контрагент = ИСШ_ТестовыеДанные.КонтрагентИсточника(Источник);
		Валюта = ИСШ_ТестовыеДанные.ВалютаИсточника(Источник);
		ДатаСчета = Дата(2025, 3, 15, 10, 0, 0);
		ОтсутствующийТовар = ИСШ_ТестовыеДанные.НоменклатураИсточника(Источник,
			"ИНТЕГ-НЕТ", "Товар отсутствует в приёмнике", "ИНТЕГ-НЕТ-ШК");
		СтрокиСчета = Новый Массив;
		СтрокиСчета.Добавить(Новый Структура("Номенклатура, Количество, Цена, Сумма", ОтсутствующийТовар.Ссылка, 1, 999, 999));
		СсылкаСчёта = ИСШ_ТестовыеДанные.СчетИсточникаССтроками(Источник, "ИНТ-1001", ДатаСчета,
			Организация.Ссылка, Контрагент.Ссылка, Валюта.Ссылка, СтрокиСчета);
		ИтогиЭкспорта = Источник.ЭСВ_ЭкспортСчетов.ВыгрузитьСчета("localhost:9092", "invoices",
			ДатаСчета, ДатаСчета, ИСШ_ТестовыеДанные.ОтмеченныеИсточника(Источник, СсылкаСчёта));
		Если ИтогиЭкспорта.Отправлено < 1 Тогда
			ВызватьИсключение "Экспорт счёта с ненайденным товаром не отправил сообщение";
		КонецЕсли;
		ИСШ_ТестовыеДанные.Ожидать(4000);
		"""
