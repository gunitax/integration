		ИСШ_ТестовыеДанные.ЭлементПриемникаПоНаименованию("Контрагенты", Контрагент.Наименование);
		ИСШ_ТестовыеДанные.ВалютаПриемника(СокрЛП(Валюта.Код), Валюта.Наименование);

