# language: ru
Функционал: Выгрузка счетов в Kafka (расширение «Экспорт счетов в шину»)
	Проверки формы обработки ЭСВ_ВыгрузкаСчетов и модуля ЭСВ_ЭкспортСчетов
	на тестовой базе InfoBase22: отправка отмеченного счёта за период,
	пропуск счётов с пометкой удаления, работа формы со значениями по умолчанию.
	Перед прогоном должен быть запущен брокер Kafka на localhost:9092.

Контекст:
	Дано я подключаю TestClient "Демо" логин "Администратор" пароль ""

Сценарий: Модуль экспорта отправляет отмеченный счёт и возвращает итог
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		// Подготовка: новый счёт с одной товарной строкой на существующих данных
		// Партнёр/контрагент в базе отсутствуют — создаются для теста с фиксированным наименованием
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Организации.Ссылка КАК Ссылка ИЗ Справочник._ДемоОрганизации КАК Организации ГДЕ НЕ Организации.ПометкаУдаления");
		Организация = Запрос.Выполнить().Выгрузить()[0].Ссылка;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Валюты.Ссылка КАК Ссылка ИЗ Справочник.Валюты КАК Валюты ГДЕ НЕ Валюты.ПометкаУдаления";
		Валюта = Запрос.Выполнить().Выгрузить()[0].Ссылка;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура.Ссылка КАК Ссылка ИЗ Справочник._ДемоНоменклатура КАК Номенклатура ГДЕ НЕ Номенклатура.ЭтоГруппа И НЕ Номенклатура.ПометкаУдаления";
		Номенклатура = Запрос.Выполнить().Выгрузить()[0].Ссылка;

		Партнер = Справочники._ДемоПартнеры.НайтиПоНаименованию("Клиент Тестовый");
		Если Партнер.Пустая() Тогда
			НовыйПартнер = Справочники._ДемоПартнеры.СоздатьЭлемент();
			НовыйПартнер.Наименование = "Клиент Тестовый";
			НовыйПартнер.Записать();
			Партнер = НовыйПартнер.Ссылка;
		КонецЕсли;
		Контрагент = Справочники._ДемоКонтрагенты.НайтиПоНаименованию("Клиент Тестовый");
		Если Контрагент.Пустая() Тогда
			НовыйКонтрагент = Справочники._ДемоКонтрагенты.СоздатьЭлемент();
			НовыйКонтрагент.Наименование = "Клиент Тестовый";
			НовыйКонтрагент.Партнер = Партнер;
			НовыйКонтрагент.Записать();
			Контрагент = НовыйКонтрагент.Ссылка;
		КонецЕсли;

		Счёт = Документы._ДемоСчетНаОплатуПокупателю.СоздатьДокумент();
		Счёт.Дата = ТекущаяДатаСеанса();
		Счёт.Организация = Организация;
		Счёт.Партнер = Партнер;
		Счёт.Контрагент = Контрагент;
		Счёт.ВалютаДокумента = Валюта;
		СтрокаТовары = Счёт.Товары.Добавить();
		СтрокаТовары.Номенклатура = Номенклатура;
		СтрокаТовары.Количество = 2;
		СтрокаТовары.Цена = 100;
		СтрокаТовары.Сумма = 200;
		Счёт.Записать();

		Ключ = Счёт.Номер + "|" + XMLСтрока(Счёт.Дата);
		Отмеченные = Новый Соответствие;
		Отмеченные.Вставить(Ключ, Истина);

		Итоги = ЭСВ_ЭкспортСчетов.ВыгрузитьСчета("localhost:9092", "invoices",
			НачалоДня(Счёт.Дата), КонецДня(Счёт.Дата), Отмеченные);
		Если Итоги.Отправлено <> 1 Тогда
			ВызватьИсключение "Ожидалось 1 сообщение, отправлено: " + Итоги.Отправлено;
		КонецЕсли;
		Если Итоги.Ошибок <> 0 Тогда
			ВызватьИсключение "Ошибок при выгрузке: " + Итоги.Ошибок;
		КонецЕсли;
		"""

