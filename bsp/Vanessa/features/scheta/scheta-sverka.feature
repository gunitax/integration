# language: ru
Функционал: Сверка счетов с заказами приёмника (расширение «Сверка справочников»)
	Проверки модуля СС_ЗагрузкаЗаказов и отчёта СС_СверкаЗаказов на базе
	InfoBase22. Перед прогоном должен работать обмен (загрузка счетов в
	заказы приёмника) и публикация uf-demo-test: http://localhost/uf-demo-test.
	Сценарии зависят от фичи scheta-import: счёт ИНТ-1001 с строками
	ИНТЕГ-АРТ2/АРТ3 загружен в заказ приёмника; непомеченный счёт ТТ
	(без товарных строк) существует в источнике.

Контекст:
	Дано я подключаю TestClient "Демо" логин "Администратор" пароль ""

Сценарий: Срез заказов загружается из JSON без HTTP
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		СрезJSON = "[{""Номер"": ""ИНТ-1001"", ""Дата"": ""2025-03-15T10:00:00"", ""Организация"": ""Новые технологии ООО"",
		|""Покупатель"": ""Клиент Тестовый"", ""ВалютаКод"": ""643"", ""СуммаДокумента"": 170,
		|""НомерСтроки"": 1, ""Номенклатура"": ""Товар интеграционный 2"", ""Артикул"": ""ИНТЕГ-АРТ2"",
		|""Количество"": 2, ""Цена"": 70, ""СуммаСтроки"": 140}]";
		Записей = СС_ЗагрузкаЗаказов.ЗагрузитьСрезИзJSON(СрезJSON);
		Если Записей <> 1 Тогда
			ВызватьИсключение "Записано в регистр: " + Записей + ", ожидалось 1";
		КонецЕсли;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Рег.Номер КАК Номер,
		|	Рег.Дата КАК Дата,
		|	Рег.Номенклатура КАК Номенклатура,
		|	Рег.СуммаСтроки КАК СуммаСтроки
		|ИЗ
		|	РегистрСведений.СС_СостояниеЗаказовПриемника КАК Рег");
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() <> 1 Тогда
			ВызватьИсключение "Записей в регистре: " + Таблица.Количество() + ", ожидалось 1";
		КонецЕсли;
		Строка = Таблица[0];
		Если Строка.Номер <> "ИНТ-1001" Или Строка.Дата <> Дата(2025, 3, 15, 10, 0, 0) Тогда
			ВызватьИсключение "Ключ записи: " + Строка.Номер + " от " + Строка.Дата;
		КонецЕсли;
		Если Строка.Номенклатура <> "Товар интеграционный 2" Или Строка.СуммаСтроки <> 140 Тогда
			ВызватьИсключение "Содержимое записи не соответствует JSON";
		КонецЕсли;
		"""

Сценарий: Срез заказов загружается по HTTP-сервису приёмника
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Записей = СС_ЗагрузкаЗаказов.ЗагрузитьСрезЗаказов("http://localhost/uf-demo-test/hs/itsh-goods/v1/orders");
		Если Записей < 1 Тогда
			ВызватьИсключение "Срез по HTTP пуст";
		КонецЕсли;
		Запрос = Новый Запрос(
		"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ РегистрСведений.СС_СостояниеЗаказовПриемника КАК Рег
		|ГДЕ Рег.Номер = &Номер");
		Запрос.УстановитьПараметр("Номер", "ИНТ-1001");
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица[0].Кол < 2 Тогда
			ВызватьИсключение "В срезе нет двух строк заказа ИНТ-1001: " + Таблица[0].Кол;
		КонецЕсли;
		"""

Сценарий: Отчет сверки показывает статус согласования
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		// Срез приёмника уже в регистре (предыдущий сценарий); счёт ИНТ-1001
		// источника согласован с заказом приёмника фичей scheta-import.
		// Статусы считает запрос набора данных самой схемы СКД.
		Схема = Отчеты.СС_СверкаЗаказов.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
		ЗапросТекст = Схема.НаборыДанных[0].Запрос;

		ЗапросОтчета = Новый Запрос(ЗапросТекст);
		ЗапросОтчета.УстановитьПараметр("ДатаНачала", Дата(1, 1, 1));
		ЗапросОтчета.УстановитьПараметр("ДатаОкончания", Дата(1, 1, 1));
		ТаблицаОтчета = ЗапросОтчета.Выполнить().Выгрузить();
		Если ТаблицаОтчета.Количество() = 0 Тогда
			ВызватьИсключение "Отчетный запрос не вывел ни одной строки";
		КонецЕсли;

		// Согласованные строки счёта ИНТ-1001
		Отбор = Новый Структура("Номер, Статус", "ИНТ-1001", "Совпадает");
		Совпадающие = ТаблицаОтчета.НайтиСтроки(Отбор);
		Если Совпадающие.Количество() < 2 Тогда
			ВызватьИсключение "Строк ""Совпадает"" для ИНТ-1001: " + Совпадающие.Количество() + ", ожидалось 2";
		КонецЕсли;
		"""

