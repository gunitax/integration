Сценарий: Помеченный счет получает особый статус
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		// Берем непомеченный счёт ТТ (обычно без строк, от scheta-import);
		// при отсутствии - создаем новый. Пометка снимается при любом исходе.
		НайденТестовый = Ложь;
		Выборка = Документы._ДемоСчетНаОплатуПокупателю.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Лев(Выборка.Номер, 2) = "ТТ" И Не Выборка.ПометкаУдаления Тогда
				НомерТестового = Выборка.Номер;
				НайденТестовый = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не НайденТестовый Тогда
			ЗапросЭлементов = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Организации.Ссылка КАК Ссылка ИЗ Справочник._ДемоОрганизации КАК Организации ГДЕ НЕ Организации.ПометкаУдаления");
			Организация = ЗапросЭлементов.Выполнить().Выгрузить()[0].Ссылка;
			ЗапросЭлементов.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Контрагенты.Ссылка КАК Ссылка ИЗ Справочник._ДемоКонтрагенты КАК Контрагенты ГДЕ НЕ Контрагенты.ПометкаУдаления";
			Контрагент = ЗапросЭлементов.Выполнить().Выгрузить()[0].Ссылка;
			ЗапросЭлементов.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Валюты.Ссылка КАК Ссылка ИЗ Справочник.Валюты КАК Валюты ГДЕ НЕ Валюты.ПометкаУдаления";
			Валюта = ЗапросЭлементов.Выполнить().Выгрузить()[0].Ссылка;
			Метка = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
			НомерТестового = "ТТ" + Прав(Метка, 9);
			СчётОбъект = Документы._ДемоСчетНаОплатуПокупателю.СоздатьДокумент();
			СчётОбъект.Номер = НомерТестового;
			СчётОбъект.Дата = ТекущаяДатаСеанса();
			СчётОбъект.Организация = Организация;
			СчётОбъект.Партнер = Контрагент.Партнер;
			СчётОбъект.Контрагент = Контрагент;
			СчётОбъект.ВалютаДокумента = Валюта;
			СчётОбъект.Записать();
		КонецЕсли;

		ОбъектСчёта = Документы._ДемоСчетНаОплатуПокупателю.НайтиПоНомеру(НомерТестового, ТекущаяДатаСеанса()).ПолучитьОбъект();
		ОбъектСчёта.ПометкаУдаления = Истина;
		ОбъектСчёта.Записать();

		Попытка
			Схема = Отчеты.СС_СверкаЗаказов.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
			ЗапросОтчета = Новый Запрос(Схема.НаборыДанных[0].Запрос);
			ЗапросОтчета.УстановитьПараметр("ДатаНачала", Дата(1, 1, 1));
			ЗапросОтчета.УстановитьПараметр("ДатаОкончания", Дата(1, 1, 1));
			ТаблицаОтчета = ЗапросОтчета.Выполнить().Выгрузить();
			Если ТаблицаОтчета.Найти("Счёт помечен на удаление", "Статус") = Неопределено Тогда
				ВызватьИсключение "Статус ""Счёт помечен на удаление"" не найден в отчетном запросе";
			КонецЕсли;
		Исключение
			ОбъектСчёта.ПометкаУдаления = Ложь;
			ОбъектСчёта.Записать();
			ВызватьИсключение;
		КонецПопытки;

		// Счёт возвращается в рабочее состояние для повторных прогонов
		ОбъектСчёта.ПометкаУдаления = Ложь;
		ОбъектСчёта.Записать();
		"""
