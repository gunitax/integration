				+ ", пропущено " + Итоги.Пропущено;
		КонецЕсли;
		"""

Сценарий: Форма загрузки счетов читает порцию из топика invoices
	И я закрываю все окна клиентского приложения
	И я открываю навигационную ссылку "e1cib/app/Обработка.ИСШ_ЗагрузкаСчетов"
	Тогда открылось окно "*Загрузка счетов из шины*"
	И я нажимаю на кнопку с именем 'ФормаЗагрузить'
	И я жду, что в сообщениях пользователю будет подстрока 'ошибок: 0' в течение 60 секунд
	И я закрываю все окна клиентского приложения

Сценарий: Заказ соответствует счёту источника
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Соединитель = Новый COMОбъект("V85.ComConnector");
		Источник = Соединитель.Connect("File=""C:\Users\sax\Documents\InfoBase22"";Usr=""Администратор"";");
		Организация = ИСШ_ТестовыеДанные.ОрганизацияИсточника(Источник);
		Контрагент = ИСШ_ТестовыеДанные.КонтрагентИсточника(Источник);
		Валюта = ИСШ_ТестовыеДанные.ВалютаИсточника(Источник);

		Ссылка = ИСШ_ТестовыеДанные.ЗаказПриемника("ИНТ-1001", 1);
		Если Ссылка.Проведен Тогда
			ВызватьИсключение "Заказ проведен, а должен быть записан без проведения";
		КонецЕсли;
		Если Ссылка.СостояниеЗаказа <> Перечисления.СостоянияЗаказов.Открыт Тогда
			ВызватьИсключение "Состояние заказа не ""Открыт""";
		КонецЕсли;
		Если Ссылка.Дата <> Дата(2025, 3, 15, 10, 0, 0) Тогда
			ВызватьИсключение "Дата заказа не равна дате счёта: " + Ссылка.Дата;
		КонецЕсли;
		Если Ссылка.Организация.Наименование <> Организация.Наименование Тогда
			ВызватьИсключение "Организация заказа: " + Ссылка.Организация.Наименование;
		КонецЕсли;
		Если Ссылка.Покупатель.Наименование <> Контрагент.Наименование Тогда
			ВызватьИсключение "Покупатель заказа: " + Ссылка.Покупатель.Наименование;
		КонецЕсли;
		Если Ссылка.Валюта.Код <> СокрЛП(Валюта.Код) Тогда
			ВызватьИсключение "Код валюты заказа: " + Ссылка.Валюта.Код;
		КонецЕсли;
		Если Ссылка.Склад.Пустая() Тогда
			ВызватьИсключение "Склад заказа не заполнен";
		КонецЕсли;

		Товары = Ссылка.Товары;
		Если Товары.Количество() <> 1 Тогда
			ВызватьИсключение "Строк в заказе: " + Товары.Количество();
		КонецЕсли;
		СтрокаТовары = Товары[0];
		Если СтрокаТовары.Товар.Артикул <> "ИНТЕГ-АРТ1" Тогда
			ВызватьИсключение "Артикул товара заказа: " + СтрокаТовары.Товар.Артикул;
		КонецЕсли;
		Если СтрокаТовары.Количество <> 3 Или СтрокаТовары.Цена <> 150 Или СтрокаТовары.Сумма <> 450 Тогда
			ВызватьИсключение "Строка заказа: количество " + СтрокаТовары.Количество
				+ ", цена " + СтрокаТовары.Цена + ", сумма " + СтрокаТовары.Сумма;
		КонецЕсли;
		Если Ссылка.Сумма <> 450 Тогда
			ВызватьИсключение "Сумма заказа не равна сумме строк: " + Ссылка.Сумма;
		КонецЕсли;
		"""

