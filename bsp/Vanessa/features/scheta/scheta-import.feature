# language: ru
Функционал: Импорт счетов из Kafka в заказы (расширение «Импорт счетов из шины»)
	Проверки модуля ИСШ_ЗагрузкаСчетов и формы обработки ИСШ_ЗагрузкаСчетов
	на тестовой базе uf-demo-test: чтение порции топика invoices, запись заказа,
	повторная загрузка без дублей, приведение строк заказа в соответствие,
	протокол ненайденных элементов и пропусков, некоммит порции с ошибкой.
	Фикстуры готовит модуль ИСШ_ТестовыеДанные: счёт источника создается или
	обновляется через COM (V85.ComConnector) к InfoBase22, эталонные данные
	приёмника - кодом. Номер и дата тестового счёта фиксированы - сценарии
	можно повторять; сообщения-«яд» пишутся в отдельный топик invoices-poison,
	чтобы не ломать основной канал.

Контекст:
	Дано я подключаю TestClient "Демо" логин "" пароль ""

Сценарий: Модуль загрузки читает порцию и записывает заказ без ошибок
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		// --- Приёмник: эталонные данные и склад для заказов ---
		Артикул = "ИНТЕГ-АРТ1";
		ИСШ_ТестовыеДанные.ТоварПриемника(Артикул, "Товар интеграционный 1", "ИНТЕГ-ШК1");
		ИСШ_ТестовыеДанные.СкладПриемника();

		// --- Источник: шапка из подходящих по длине элементов ---
		Соединитель = Новый COMОбъект("V85.ComConnector");
		Источник = Соединитель.Connect("File=""C:\Users\sax\Documents\InfoBase22"";Usr=""Администратор"";");
		Организация = ИСШ_ТестовыеДанные.ОрганизацияИсточника(Источник);
		Контрагент = ИСШ_ТестовыеДанные.КонтрагентИсточника(Источник);
		Валюта = ИСШ_ТестовыеДанные.ВалютаИсточника(Источник);

		// --- Приёмник: копии реквизитов шапки для строгого сопоставления ---
		ИСШ_ТестовыеДанные.ЭлементПриемникаПоНаименованию("Организации", Организация.Наименование);
		ИСШ_ТестовыеДанные.ЭлементПриемникаПоНаименованию("Контрагенты", Контрагент.Наименование);
		ИСШ_ТестовыеДанные.ВалютаПриемника(СокрЛП(Валюта.Код), Валюта.Наименование);

		// --- Источник: счёт с фиксированными номером, датой и строкой ---
		ДатаСчета = Дата(2025, 3, 15, 10, 0, 0);
		Номенклатура = ИСШ_ТестовыеДанные.НоменклатураИсточника(Источник, Артикул, "Товар интеграционный 1", "ИНТЕГ-ШК1");
		СтрокиСчета = Новый Массив;
		СтрокиСчета.Добавить(Новый Структура("Номенклатура, Количество, Цена, Сумма", Номенклатура.Ссылка, 3, 150, 450));
		СсылкаСчёта = ИСШ_ТестовыеДанные.СчетИсточникаССтроками(Источник, "ИНТ-1001", ДатаСчета,
			Организация.Ссылка, Контрагент.Ссылка, Валюта.Ссылка, СтрокиСчета);

		// --- Экспорт отмеченного счёта через COM (модуль расширения источника) ---
		ИтогиЭкспорта = Источник.ЭСВ_ЭкспортСчетов.ВыгрузитьСчета("localhost:9092", "invoices",
			ДатаСчета, ДатаСчета, ИСШ_ТестовыеДанные.ОтмеченныеИсточника(Источник, СсылкаСчёта));
		Если ИтогиЭкспорта.Отправлено < 1 Тогда
			ВызватьИсключение "Экспорт источника не отправил счёт: отправлено " + ИтогиЭкспорта.Отправлено;
		КонецЕсли;

		// Пауза: группа получателей должна успеть получить назначение разделов
		ИСШ_ТестовыеДанные.Ожидать(4000);
		"""
