Сценарий: Ненайденные элементы в протоколе, заказ и справочники не создаются
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		Соединитель = Новый COMОбъект("V85.ComConnector");
		Источник = Соединитель.Connect("File=""C:\Users\sax\Documents\InfoBase22"";Usr=""Администратор"";");
		ИСШ_ТестовыеДанные.ПометитьТестовыеСчета(Источник);

		// Уникальные на прогон имена - приёмник их заведомо не знает
		Метка = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
		ОргИмя = "ИТ-НетОрг" + Прав(Метка, 6);
		КонтрИмя = "ИТ-НетКонтр" + Прав(Метка, 6);
		ТоварИмя = "ИТ-НетТовар1" + Прав(Метка, 5);
		ТоварИмя2 = "ИТ-НетТовар2" + Прав(Метка, 5);
		АртикулНет = "НЕТ" + Прав(Метка, 6);
		АртикулНет2 = "НЕТ2" + Прав(Метка, 5);

		Организация = ИСШ_ТестовыеДанные.ЭлементИсточникаПоИмени(Источник, "_ДемоОрганизации", ОргИмя);
		Контрагент = ИСШ_ТестовыеДанные.ЭлементИсточникаПоИмени(Источник, "_ДемоКонтрагенты", КонтрИмя);
		Валюта = ИСШ_ТестовыеДанные.ВалютаИсточникаОтсутствующаяВПриемнике(Источник);
		КодВалюты = СокрЛП(Валюта.Код);
		Номенклатура1 = ИСШ_ТестовыеДанные.НоменклатураИсточника(Источник, АртикулНет, ТоварИмя, "");
		Номенклатура2 = ИСШ_ТестовыеДанные.НоменклатураИсточника(Источник, АртикулНет2, ТоварИмя2, "");

		НомерСчета = "ТТ" + Прав(Метка, 9);
		НомерЗаказа = Прав(НомерСчета, 9);
		ДатаСчета = ТекущаяДатаСеанса();
		СтрокиСчета = Новый Массив;
		СтрокиСчета.Добавить(Новый Структура("Номенклатура, Количество, Цена, Сумма", Номенклатура1.Ссылка, 1, 10, 10));
		СтрокиСчета.Добавить(Новый Структура("Номенклатура, Количество, Цена, Сумма", Номенклатура2.Ссылка, 2, 20, 40));
		СсылкаСчёта = ИСШ_ТестовыеДанные.СчетИсточникаССтроками(Источник, НомерСчета, ДатаСчета,
			Организация.Ссылка, Контрагент.Ссылка, Валюта.Ссылка, СтрокиСчета);

		ИтогиЭкспорта = Источник.ЭСВ_ЭкспортСчетов.ВыгрузитьСчета("localhost:9092", "invoices",
			ДатаСчета, ДатаСчета, ИСШ_ТестовыеДанные.ОтмеченныеИсточника(Источник, СсылкаСчёта));
		Если ИтогиЭкспорта.Отправлено < 1 Тогда
			ВызватьИсключение "Экспорт счёта с ненайденными элементами не отправлен";
		КонецЕсли;
		ИСШ_ТестовыеДанные.Ожидать(4000);

