Сценарий: Проверка числа снимков источника
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
		ИменаСнимков = Новый Массив;
		ИменаСнимков.Добавить("01-vygruzka-forma.png");
		ИменаСнимков.Добавить("02-vygruzka-itog.png");
		ИменаСнимков.Добавить("20-srez-forma.png");
		ИменаСнимков.Добавить("21-srez-itog.png");
		ИменаСнимков.Добавить("22-otchet.png");
		Для Каждого ИмяСнимка Из ИменаСнимков Цикл
			ФайлСнимка = Новый Файл("C:\temp\manual-scheta\" + ИмяСнимка);
			Если Не ФайлСнимка.Существует() Тогда
				ВызватьИсключение "Нет снимка: " + ФайлСнимка.ПолноеИмя;
			КонецЕсли;
		КонецЦикла;
		"""
