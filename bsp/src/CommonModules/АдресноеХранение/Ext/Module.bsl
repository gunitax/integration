#Область ПрограммныйИнтерфейс

// Определяет, включено ли адресное хранение по складу.
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - проверяемый склад.
//
// Возвращаемое значение:
//  Булево - Истина, если по складу есть запись в регистре сведений ИспользованиеАдресногоХранения.
//
Функция Используется(Склад) Экспорт
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Используется
	|ИЗ
	|	РегистрСведений.ИспользованиеАдресногоХранения КАК ИспользованиеАдресногоХранения
	|ГДЕ
	|	ИспользованиеАдресногоХранения.Склад = &Склад";
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

// Включает или отключает адресное хранение по складу.
//
// При отключении, если по складу есть остатки товаров в ячейках, работа прерывается
// исключением (FR-010); иначе запись регистра удаляется.
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - склад, для которого меняется режим;
//  Включить - Булево - Истина - включить режим, Ложь - отключить.
//
Процедура УстановитьИспользование(Склад, Включить) Экспорт
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан склад для установки режима адресного хранения.'");
	КонецЕсли;
	
	Если Включить Тогда
		Набор = РегистрыСведений.ИспользованиеАдресногоХранения.СоздатьНаборЗаписей();
		Набор.Отбор.Склад.Установить(Склад);
		Запись = Набор.Добавить();
		Запись.Склад = Склад;
		Запись.Используется = Истина;
		Набор.Записать(Истина);
	Иначе
		Если ЕстьОстаткиПоСкладу(Склад) Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Отключение адресного хранения по складу ""%1"" невозможно: по складу есть остатки товаров в ячейках.'"),
				Строка(Склад));
		КонецЕсли;
		Набор = РегистрыСведений.ИспользованиеАдресногоХранения.СоздатьНаборЗаписей();
		Набор.Отбор.Склад.Установить(Склад);
		Набор.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

// Составляет адрес ячейки из компонентов в формате "З-РР-СС-Я".
//
// Ряд и секция выводятся двумя цифрами с ведущим нулем, ярус - без ведущего нуля,
// например "А-01-02-3" (FR-003).
//
// Параметры:
//  КодЗоны - Строка - код зоны, один символ: буква А-Я/A-Z или цифра;
//  Ряд - Число - номер ряда, 1...99;
//  Секция - Число - номер секции, 1...99;
//  Ярус - Число - номер яруса, 1...99.
//
// Возвращаемое значение:
//  Строка - адрес ячейки, например "А-01-02-3".
//
Функция СоставитьАдрес(КодЗоны, Ряд, Секция, Ярус) Экспорт
	
	Возврат СокрЛП(КодЗоны) + "-" + Формат(Ряд, "ЧЦ=2; ЧВН=")
		+ "-" + Формат(Секция, "ЧЦ=2; ЧВН=")
		+ "-" + Формат(Ярус, "ЧГ=");
	
КонецФункции

// Проверяет код зоны: ровно один символ - буква А-Я/A-Z или цифра (FR-003).
//
// Параметры:
//  КодЗоны - Строка - проверяемый код зоны.
//
// Возвращаемое значение:
//  Булево - Истина, если код допустим.
//
Функция ПроверитьКодЗоны(КодЗоны) Экспорт
	
	Если СтрДлина(КодЗоны) <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтрНайти(ДопустимыеСимволыЗоны(), КодЗоны) > 0;
	
КонецФункции

// Генерирует ячейки хранения по диапазонам рядов, секций и ярусов (FR-004).
//
// Существующие адреса пропускаются (идемпотентность). Если в параметре Зона передан
// код (строка), зона создается, а при наличии у склада зоны с таким кодом используется
// существующая зона. Запись выполняется пакетом в одной транзакции. Склад должен
// быть включен в адресное хранение.
//
// Параметры:
//  Параметры - Структура:
//   * Склад - СправочникСсылка._ДемоМестаХранения - склад генерации;
//   * Зона - СправочникСсылка.ЗоныХранения, Строка - зона или код новой зоны (один символ);
//   * РядыОт - Число - начало диапазона рядов;
//   * РядыПо - Число - конец диапазона рядов;
//   * СекцииОт - Число - начало диапазона секций;
//   * СекцииПо - Число - конец диапазона секций;
//   * ЯрусыОт - Число - начало диапазона ярусов;
//   * ЯрусыПо - Число - конец диапазона ярусов.
//
// Возвращаемое значение:
//  Структура:
//   * Создано - Число - количество созданных ячеек;
//   * Пропущено - Число - количество пропущенных существующих адресов.
//
Функция СгенерироватьЯчейки(Параметры) Экспорт
	
	ПроверитьПараметрыГенерации(Параметры);
	
	Если Не Используется(Параметры.Склад) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Адресное хранение по складу ""%1"" не включено: генерация ячеек невозможна.'"),
			Строка(Параметры.Склад));
	КонецЕсли;
	
	Результат = Новый Структура("Создано, Пропущено", 0, 0);
	
	НачатьТранзакцию();
	Попытка
		Зона = НайтиИлиСоздатьЗону(Параметры.Склад, Параметры.Зона);
		Существующие = СуществующиеАдресаЗоны(Параметры.Склад, Зона);
		СоздатьЯчейкиПоДиапазонам(Параметры, Зона, Существующие, Результат);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Возвращает остаток товара в ячейке склада (FR-013).
//
// Если номенклатура не указана, возвращается итог по ячейке по всей номенклатуре.
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - склад;
//  Ячейка - СправочникСсылка.ЯчейкиХранения - ячейка;
//  Номенклатура - СправочникСсылка._ДемоНоменклатура - номенклатура, может быть пустой.
//
// Возвращаемое значение:
//  Число - текущий остаток по ячейке.
//
Функция ОстатокЯчейки(Склад, Ячейка, Номенклатура) Экспорт
	
	Если Не ЗначениеЗаполнено(Склад) Или Не ЗначениеЗаполнено(Ячейка) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровПоЯчейкам.Остатки(
		|			,
		|			Склад = &Склад
		|				И Ячейка = &Ячейка
		|				И Номенклатура = &Номенклатура) КАК Остатки";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровПоЯчейкам.Остатки(
		|			,
		|			Склад = &Склад
		|				И Ячейка = &Ячейка) КАК Остатки";
	КонецЕсли;
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Проверяет, что склад включен в адресное хранение (FR-015).
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - склад документа;
//  Отказ - Булево - флаг отказа, устанавливается в Истина при ошибке.
//
Процедура ПроверитьСкладДляОпераций(Склад, Отказ) Экспорт
	
	Если Используется(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(
		НСтр("ru = 'Склад ""%1"" не включен в адресное хранение: операции по ячейкам запрещены.'"),
		Строка(Склад));
	Сообщение.Сообщить();
	
КонецПроцедуры

// Проверяет ячейку документа: принадлежность складу (FR-008), отсутствие пометки
// удаления у ячейки (FR-019) и у ее зоны.
//
// Незаполненная ячейка не проверяется: обязательность заполнения контролируется
// отдельно проверкой заполнения.
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - склад документа;
//  Ячейка - СправочникСсылка.ЯчейкиХранения - проверяемая ячейка;
//  Отказ - Булево - флаг отказа, устанавливается в Истина при ошибке;
//  ИмяПоля - Строка - имя поля для сообщения (например, "Товары[3].Ячейка"), может быть пустым.
//
Процедура ПроверитьЯчейкуДокумента(Склад, Ячейка, Отказ, ИмяПоля) Экспорт
	
	Если Не ЗначениеЗаполнено(Ячейка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ячейки.Склад КАК Склад,
	|	Ячейки.ПометкаУдаления КАК ПометкаУдаления,
	|	Ячейки.Зона КАК Зона,
	|	ЕСТЬNULL(Зоны.ПометкаУдаления, ИСТИНА) КАК ЗонаПомеченаНаУдаление
	|ИЗ
	|	Справочник.ЯчейкиХранения КАК Ячейки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЗоныХранения КАК Зоны
	|		ПО Ячейки.Зона = Зоны.Ссылка
	|ГДЕ
	|	Ячейки.Ссылка = &Ячейка";
	Запрос.УстановитьПараметр("Ячейка", Ячейка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		СообщитьОбОшибкеЯчейки(Отказ, ИмяПоля,
			СтрШаблон(НСтр("ru = 'Ячейка ""%1"" не найдена.'"), Строка(Ячейка)));
		Возврат;
	КонецЕсли;
	
	Если Выборка.Склад <> Склад Тогда
		СообщитьОбОшибкеЯчейки(Отказ, ИмяПоля,
			СтрШаблон(НСтр("ru = 'Ячейка ""%1"" принадлежит другому складу.'"), Строка(Ячейка)));
		Возврат;
	КонецЕсли;
	
	Если Выборка.ПометкаУдаления Тогда
		СообщитьОбОшибкеЯчейки(Отказ, ИмяПоля,
			СтрШаблон(НСтр("ru = 'Ячейка ""%1"" помечена на удаление.'"), Строка(Ячейка)));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.Зона) Или Выборка.ЗонаПомеченаНаУдаление Тогда
		СообщитьОбОшибкеЯчейки(Отказ, ИмяПоля,
			СтрШаблон(НСтр("ru = 'Зона ячейки ""%1"" не заполнена или помечена на удаление.'"), Строка(Ячейка)));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет параметры массовой генерации ячеек.
//
// Параметры:
//  Параметры - Структура - см. СгенерироватьЯчейки.
//
Процедура ПроверитьПараметрыГенерации(Параметры)
	
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Параметры генерации ячеек должны быть структурой.'");
	КонецЕсли;
	
	ОбязательныеКлючи = "Склад,Зона,РядыОт,РядыПо,СекцииОт,СекцииПо,ЯрусыОт,ЯрусыПо";
	Для Каждого ИмяКлюча Из СтрРазделить(ОбязательныеКлючи, ",") Цикл
		Если Не Параметры.Свойство(ИмяКлюча) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'В параметрах генерации не заполнен ключ ""%1"".'"), ИмяКлюча);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Параметры.Склад) Тогда
		ВызватьИсключение НСтр("ru = 'В параметрах генерации не указан склад.'");
	КонецЕсли;
	
	ПроверитьДиапазонГенерации(Параметры.РядыОт, Параметры.РядыПо, "рядов");
	ПроверитьДиапазонГенерации(Параметры.СекцииОт, Параметры.СекцииПо, "секций");
	ПроверитьДиапазонГенерации(Параметры.ЯрусыОт, Параметры.ЯрусыПо, "ярусов");
	
КонецПроцедуры

// Проверяет границы одного диапазона генерации.
//
// Параметры:
//  ГраницаОт - Число - начало диапазона;
//  ГраницаПо - Число - конец диапазона;
//  Наименование - Строка - имя диапазона для текста исключения.
//
Процедура ПроверитьДиапазонГенерации(ГраницаОт, ГраницаПо, Наименование)
	
	Если Не ЭтоЧисло(ГраницаОт) Или Не ЭтоЧисло(ГраницаПо) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Границы диапазона %1 должны быть числами.'"), Наименование);
	КонецЕсли;
	
	Если ГраницаОт < 1 Или ГраницаПо > 99 Или ГраницаОт > ГраницаПо Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Диапазон %1 должен быть задан от 1 до 99, граница ""от"" не должна превышать границу ""по"".'"),
			Наименование);
	КонецЕсли;
	
КонецПроцедуры

// Находит зону склада по коду или возвращает переданную ссылку; при необходимости
// создает новую зону. Уникальность "Склад + КодЗоны" обеспечивается поиском перед
// созданием.
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - склад зоны;
//  ЗонаИлиКод - СправочникСсылка.ЗоныХранения, Строка - зона или код зоны.
//
// Возвращаемое значение:
//  СправочникСсылка.ЗоныХранения - найденная или созданная зона.
//
Функция НайтиИлиСоздатьЗону(Склад, ЗонаИлиКод)
	
	Если ТипЗнч(ЗонаИлиКод) = Тип("СправочникСсылка.ЗоныХранения") Тогда
		Если Не ЗначениеЗаполнено(ЗонаИлиКод) Тогда
			ВызватьИсключение НСтр("ru = 'Не указана зона для генерации ячеек.'");
		КонецЕсли;
		Если ЗонаИлиКод.Склад <> Склад Тогда
			ВызватьИсключение НСтр("ru = 'Указанная зона принадлежит другому складу.'");
		КонецЕсли;
		Возврат ЗонаИлиКод;
	КонецЕсли;
	
	КодЗоны = СокрЛП(Строка(ЗонаИлиКод));
	Если Не ПроверитьКодЗоны(КодЗоны) Тогда
		ВызватьИсключение НСтр("ru = 'Код зоны должен состоять из одного символа: буква А-Я, A-Z или цифра.'");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Зоны.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЗоныХранения КАК Зоны
	|ГДЕ
	|	Зоны.Склад = &Склад
	|	И Зоны.КодЗоны = &КодЗоны";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("КодЗоны", КодЗоны);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Зона = Справочники.ЗоныХранения.СоздатьЭлемент();
	Зона.Наименование = КодЗоны;
	Зона.Склад = Склад;
	Зона.КодЗоны = КодЗоны;
	Зона.Записать();
	
	Возврат Зона.Ссылка;
	
КонецФункции

// Возвращает соответствие всех адресов ячеек склада и зоны.
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - склад;
//  Зона - СправочникСсылка.ЗоныХранения - зона.
//
// Возвращаемое значение:
//  Соответствие - ключи - адреса существующих ячеек.
//
Функция СуществующиеАдресаЗоны(Склад, Зона)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ячейки.Адрес КАК Адрес
	|ИЗ
	|	Справочник.ЯчейкиХранения КАК Ячейки
	|ГДЕ
	|	Ячейки.Склад = &Склад
	|	И Ячейки.Зона = &Зона";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Зона", Зона);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СокрЛП(Выборка.Адрес), Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает ячейки по диапазонам, пропуская существующие адреса.
//
// Параметры:
//  Параметры - Структура - см. СгенерироватьЯчейки;
//  Зона - СправочникСсылка.ЗоныХранения - зона генерации;
//  Существующие - Соответствие - адреса существующих ячеек;
//  Результат - Структура - Создано, Пропущено (заполняется).
//
Процедура СоздатьЯчейкиПоДиапазонам(Параметры, Зона, Существующие, Результат)
	
	Для НомерРяда = Параметры.РядыОт По Параметры.РядыПо Цикл
		Для НомерСекции = Параметры.СекцииОт По Параметры.СекцииПо Цикл
			Для НомерЯруса = Параметры.ЯрусыОт По Параметры.ЯрусыПо Цикл
				
				Адрес = СоставитьАдрес(Зона.КодЗоны, НомерРяда, НомерСекции, НомерЯруса);
				
				Если Существующие.Получить(Адрес) <> Неопределено Тогда
					Результат.Пропущено = Результат.Пропущено + 1;
					Продолжить;
				КонецЕсли;
				
				Ячейка = Справочники.ЯчейкиХранения.СоздатьЭлемент();
				Ячейка.Наименование = Адрес;
				Ячейка.Склад = Параметры.Склад;
				Ячейка.Зона = Зона;
				Ячейка.Ряд = НомерРяда;
				Ячейка.Секция = НомерСекции;
				Ячейка.Ярус = НомерЯруса;
				Ячейка.Адрес = Адрес;
				Ячейка.Записать();
				
				Существующие.Вставить(Адрес, Истина);
				Результат.Создано = Результат.Создано + 1;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Определяет наличие ненулевых остатков товаров в ячейках по складу (FR-010).
//
// Параметры:
//  Склад - СправочникСсылка._ДемоМестаХранения - склад.
//
// Возвращаемое значение:
//  Булево - Истина, если по складу есть остатки.
//
Функция ЕстьОстаткиПоСкладу(Склад)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровПоЯчейкам.Остатки(
	|			,
	|			Склад = &Склад) КАК Остатки";
	Запрос.УстановитьПараметр("Склад", Склад);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество > 0;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Устанавливает отказ и выводит сообщение об ошибке проверки ячейки.
//
// Параметры:
//  Отказ - Булево - флаг отказа, устанавливается в Истина;
//  ИмяПоля - Строка - имя поля для сообщения, может быть пустым;
//  Причина - Строка - текст ошибки.
//
Процедура СообщитьОбОшибкеЯчейки(Отказ, ИмяПоля, Причина)
	
	Отказ = Истина;
	
	Сообщение = Новый СообщениеПользователю;
	Если ЗначениеЗаполнено(ИмяПоля) Тогда
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Поле ""%1"": %2'"),
			ИмяПоля, НРег(Лев(Причина, 1)) + Сред(Причина, 2));
	Иначе
		Сообщение.Текст = Причина;
	КонецЕсли;
	Сообщение.Сообщить();
	
КонецПроцедуры

// Проверяет адрес ячейки на соответствие формату "З-РР-СС-Я": код зоны - один символ,
// ряд и секция - две цифры, ярус - одна или две цифры, не ноль.
//
// Параметры:
//  Адрес - Строка - проверяемый адрес.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес соответствует формату.
//
Функция ПроверитьАдрес(Адрес)
	
	Части = СтрРазделить(СокрЛП(Адрес), "-", Истина);
	Если Части.Количество() <> 4 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПроверитьКодЗоны(Части[0]) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрДлина(Части[1]) <> 2 Или Не ЭтоЦифры(Части[1])
		Или СтрДлина(Части[2]) <> 2 Или Не ЭтоЦифры(Части[2]) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЭтоЦифры(Части[3]) Или СтрДлина(Части[3]) > 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Число(Части[3]) >= 1;
	
КонецФункции

// Определяет, что строка состоит только из цифр и не пуста.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если строка состоит только из цифр.
//
Функция ЭтоЦифры(Значение)
	
	Если СтрДлина(Значение) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Определяет, что значение имеет тип Число.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если значение имеет тип Число.
//
Функция ЭтоЧисло(Значение)
	
	Возврат ТипЗнч(Значение) = Тип("Число");
	
КонецФункции

// Возвращает строку допустимых символов кода зоны.
//
// Возвращаемое значение:
//  Строка - буквы А-Я, A-Z и цифры.
//
Функция ДопустимыеСимволыЗоны()
	
	Возврат "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"
		+ "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
		+ "0123456789";
	
КонецФункции

#КонецОбласти
