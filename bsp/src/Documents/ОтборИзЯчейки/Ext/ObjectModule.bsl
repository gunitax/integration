#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		СообщитьОбОшибкеПоля(НСтр("ru = 'Не заполнено поле ""Склад"".'"),
			"Склад", Отказ);
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого СтрокаТовары Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ИмяПоля = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=0") + "]";
		
		Если Не ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не заполнена колонка ""Номенклатура"" в строке %1 списка ""Товары""!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".Номенклатура", Отказ);
		КонецЕсли;
		
		Если СтрокаТовары.Количество <= 0 Тогда
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Количество в строке %1 списка ""Товары"" должно быть больше нуля!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".Количество", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовары.Ячейка) Тогда
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не заполнена колонка ""Ячейка"" в строке %1 списка ""Товары""!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".Ячейка", Отказ);
		Иначе
			// Ячейка должна принадлежать складу шапки и быть активной (FR-008, FR-019).
			АдресноеХранение.ПроверитьЯчейкуДокумента(Склад, СтрокаТовары.Ячейка, Отказ,
				ИмяПоля + ".Ячейка");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Склад должен быть включен в адресное хранение (FR-015).
	АдресноеХранение.ПроверитьСкладДляОпераций(Склад, Отказ);
	
	НомерСтроки = 0;
	Для Каждого СтрокаТовары Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		// Ячейка каждой строки должна принадлежать складу шапки (FR-008).
		АдресноеХранение.ПроверитьЯчейкуДокумента(Склад, СтрокаТовары.Ячейка, Отказ,
			"Товары[" + Формат(НомерСтроки - 1, "ЧГ=0") + "].Ячейка");
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьДвиженияПоЯчейкам();
	
	// Контроль отрицательных остатков (US2-3, SC-003): движения документа записываются,
	// затем регистр блокируется и остатки проверяются на момент документа (research D6).
	Движения.Записать();
	
	ЗаблокироватьОстаткиПоЯчейкам();
	КонтролироватьОтрицательныеОстатки(Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Расход товара из ячеек: по одной записи на строку ТЧ, склад берется из шапки (FR-007).
//
Процедура СформироватьДвиженияПоЯчейкам()
	
	Движения.ОстаткиТоваровПоЯчейкам.Записывать = Истина;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		Движение = Движения.ОстаткиТоваровПоЯчейкам.Добавить();
		
		Движение.Период        = Дата;
		Движение.ВидДвижения   = ВидДвиженияНакопления.Расход;
		
		Движение.Склад         = Склад;
		Движение.Ячейка        = СтрокаТовары.Ячейка;
		
		Движение.Номенклатура  = СтрокаТовары.Номенклатура;
		Движение.Количество    = СтрокаТовары.Количество;
		
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает управляемую блокировку регистра остатков по сочетаниям
// (Склад, Ячейка, Номенклатура) из строк документа (research D6).
//
Процедура ЗаблокироватьОстаткиПоЯчейкам()
	
	Блокировка = Новый БлокировкаДанных;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваровПоЯчейкам");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
		ЭлементБлокировки.УстановитьЗначение("Ячейка", СтрокаТовары.Ячейка);
		ЭлементБлокировки.УстановитьЗначение("Номенклатура", СтрокаТовары.Номенклатура);

	КонецЦикла;

	Блокировка.Заблокировать();

КонецПроцедуры

// Контролирует отсутствие отрицательных остатков по ячейкам после записи движений
// документа: остатки берутся на текущий момент - собственный расход уже записан
// той же транзакцией и виден гарантированно. При отрицательном остатке выводится
// сообщение и устанавливается Отказ.
//
// Параметры:
//  Отказ - Булево - флаг отказа, устанавливается в Истина при ошибке.
//
Процедура КонтролироватьОтрицательныеОстатки(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Ячейка КАК Ячейка,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровПоЯчейкам.Остатки(
	|			,
	|			Склад = &Склад
	|				И Ячейка В (&Ячейки)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ячейки", ЯчейкиДокумента());
	
	ТребуемыеКоличества = ТребуемыеКоличестваПоЯчейкам();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Ключ = Строка(Выборка.Ячейка) + Символы.ПС + Строка(Выборка.Номенклатура);
		Требуется = ТребуемыеКоличества.Получить(Ключ);
		Требуется = ?(Требуется = Неопределено, 0, Требуется);
		Доступно = Выборка.Остаток + Требуется;
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			НСтр("ru = 'Недостаточно остатка в ячейке ""%1"" (требуется %2, доступно %3).'"),
			Строка(Выборка.Ячейка),
			Формат(Требуется, "ЧДЦ=3"),
			Формат(Доступно, "ЧДЦ=3"));
		Сообщение.Сообщить();
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает массив ячеек, задействованных в строках документа.
//
// Возвращаемое значение:
//  Массив - СправочникСсылка.ЯчейкиХранения - ячейки строк Товары.
//
Функция ЯчейкиДокумента()
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		Результат.Добавить(СтрокаТовары.Ячейка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие требуемых количеств документа по сочетаниям
// (Ячейка, Номенклатура): несколько строк по одной ячейке суммируются.
//
// Возвращаемое значение:
//  Соответствие - ключ - "Ячейка<ПС>Номенклатура", значение - Число - количество.
//
Функция ТребуемыеКоличестваПоЯчейкам()
	
	Результат = Новый Соответствие;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		Ключ = Строка(СтрокаТовары.Ячейка) + Символы.ПС + Строка(СтрокаТовары.Номенклатура);
		Требуется = Результат.Получить(Ключ);
		Результат.Вставить(Ключ, ?(Требуется = Неопределено, 0, Требуется) + СтрокаТовары.Количество);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Выводит сообщение с привязкой к полю объекта и устанавливает Отказ.
//
// Параметры:
//   Текст - Строка - текст сообщения.
//   Поле - Строка - путь к полю, например "Товары[0].Ячейка".
//   Отказ - Булево - флаг отказа, устанавливается в Истина.
//
Процедура СообщитьОбОшибкеПоля(Текст, Поле, Отказ)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле  = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли