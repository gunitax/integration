#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		СообщитьОбОшибкеПоля(НСтр("ru = 'Не заполнено поле ""Склад"".'"),
			"Склад", Отказ);
	КонецЕсли;
	
	НомерСтроки = 0;
	Для Каждого СтрокаТовары Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ИмяПоля = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=0") + "]";
		
		Если Не ЗначениеЗаполнено(СтрокаТовары.Номенклатура) Тогда
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не заполнена колонка ""Номенклатура"" в строке %1 списка ""Товары""!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".Номенклатура", Отказ);
		КонецЕсли;
		
		Если СтрокаТовары.Количество <= 0 Тогда
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Количество в строке %1 списка ""Товары"" должно быть больше нуля!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".Количество", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовары.ЯчейкаИсточник) Тогда
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не заполнена колонка ""Ячейка-источник"" в строке %1 списка ""Товары""!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".ЯчейкаИсточник", Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТовары.ЯчейкаПриемник) Тогда
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не заполнена колонка ""Ячейка-приемник"" в строке %1 списка ""Товары""!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".ЯчейкаПриемник", Отказ);
		КонецЕсли;
		
		// Ячейки-источник и ячейки-приемник одной строки должны различаться.
		Если ЗначениеЗаполнено(СтрокаТовары.ЯчейкаИсточник)
			И ЗначениеЗаполнено(СтрокаТовары.ЯчейкаПриемник)
			И СтрокаТовары.ЯчейкаИсточник = СтрокаТовары.ЯчейкаПриемник Тогда
			
			СообщитьОбОшибкеПоля(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ячейка-источник и ячейка-приемник в строке %1 списка ""Товары"" должны различаться!'"),
					Формат(НомерСтроки, "ЧГ=0")),
				ИмяПоля + ".ЯчейкаПриемник", Отказ);
		КонецЕсли;
		
		// Обе ячейки строки должны принадлежать складу шапки и быть активными (FR-008, FR-019).
		АдресноеХранение.ПроверитьЯчейкуДокумента(Склад, СтрокаТовары.ЯчейкаИсточник, Отказ,
			ИмяПоля + ".ЯчейкаИсточник");
		АдресноеХранение.ПроверитьЯчейкуДокумента(Склад, СтрокаТовары.ЯчейкаПриемник, Отказ,
			ИмяПоля + ".ЯчейкаПриемник");
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Склад должен быть включен в адресное хранение (FR-015).
	АдресноеХранение.ПроверитьСкладДляОпераций(Склад, Отказ);
	
	НомерСтроки = 0;
	Для Каждого СтрокаТовары Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ИмяПоля = "Товары[" + Формат(НомерСтроки - 1, "ЧГ=0") + "]";
		
		// Обе ячейки строки должны принадлежать складу шапки (FR-008).
		АдресноеХранение.ПроверитьЯчейкуДокумента(Склад, СтрокаТовары.ЯчейкаИсточник, Отказ,
			ИмяПоля + ".ЯчейкаИсточник");
		АдресноеХранение.ПроверитьЯчейкуДокумента(Склад, СтрокаТовары.ЯчейкаПриемник, Отказ,
			ИмяПоля + ".ЯчейкаПриемник");
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьДвиженияПоЯчейкам();
	
	// Расходный документ: движения записываются до контроля остатков - контроль
	// считает остатки на текущий момент, собственный расход уже учтен (research D6).
	Движения.Записать();
	КонтролироватьОстатки(Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Расход по ячейкам-источникам и приход по ячейкам-приемникам:
// по две записи на строку ТЧ, склад берется из шапки (FR-007, FR-008).
//
Процедура СформироватьДвиженияПоЯчейкам()
	
	Движения.ОстаткиТоваровПоЯчейкам.Записывать = Истина;
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		Движение = Движения.ОстаткиТоваровПоЯчейкам.Добавить();
		
		Движение.Период        = Дата;
		Движение.ВидДвижения   = ВидДвиженияНакопления.Расход;
		
		Движение.Склад         = Склад;
		Движение.Ячейка        = СтрокаТовары.ЯчейкаИсточник;
		
		Движение.Номенклатура  = СтрокаТовары.Номенклатура;
		Движение.Количество    = СтрокаТовары.Количество;
		
		Движение = Движения.ОстаткиТоваровПоЯчейкам.Добавить();
		
		Движение.Период        = Дата;
		Движение.ВидДвижения   = ВидДвиженияНакопления.Приход;
		
		Движение.Склад         = Склад;
		Движение.Ячейка        = СтрокаТовары.ЯчейкаПриемник;
		
		Движение.Номенклатура  = СтрокаТовары.Номенклатура;
		Движение.Количество    = СтрокаТовары.Количество;
		
	КонецЦикла;
	
КонецПроцедуры

// Контроль отрицательных остатков по ячейкам-источникам (FR-007, SC-003):
// остатки берутся на текущий момент - собственный расход уже записан той же
// транзакцией и виден гарантированно.
//
// Параметры:
//   Отказ - Булево - флаг отказа, устанавливается в Истина при нехватке остатка.
//
Процедура КонтролироватьОстатки(Отказ)
	
	Комбинации = КомбинацииРасхода();
	Если Комбинации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Управляемая блокировка по ключевым полям регистра: исключает параллельное
	// проведение операций по тем же сочетаниям (Склад, Ячейка, Номенклатура)
	// между записью движений документа и контролем остатков (research D6).
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваровПоЯчейкам");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Комбинации;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Склад", "Склад");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ячейка", "Ячейка");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Комбинации.Ячейка КАК Ячейка,
	|	Комбинации.Номенклатура КАК Номенклатура,
	|	Комбинации.Требуется КАК Требуется,
	|	Комбинации.ПерваяСтрока КАК ПерваяСтрока
	|ПОМЕСТИТЬ ВТ_Комбинации
	|ИЗ
	|	&Комбинации КАК Комбинации
	|ИНДЕКСИРОВАТЬ ПО Ячейка,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Ячейка КАК Ячейка,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Остаток,
	|	ВТ_Комбинации.Требуется КАК Требуется,
	|	ВТ_Комбинации.ПерваяСтрока КАК ПерваяСтрока
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваровПоЯчейкам.Остатки(
	|			,
	|			Склад = &Склад) КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Комбинации КАК ВТ_Комбинации
	|		ПО Остатки.Ячейка = ВТ_Комбинации.Ячейка
	|			И Остатки.Номенклатура = ВТ_Комбинации.Номенклатура
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Комбинации", Комбинации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Движения документа уже учтены в остатке: доступно было на величину
		// требуемого расхода больше текущего (отрицательного) остатка.
		Доступно = Выборка.Остаток + Выборка.Требуется;
		
		СообщитьОбОшибкеПоля(
			СтрШаблон(
				НСтр("ru = 'Недостаточно остатка в ячейке ""%1"" (требуется %2, доступно %3).'"),
				Строка(Выборка.Ячейка),
				Формат(Выборка.Требуется, "ЧДЦ=3"),
				Формат(Доступно, "ЧДЦ=3")),
			"Товары[" + Формат(Выборка.ПерваяСтрока, "ЧГ=0") + "].ЯчейкаИсточник",
			Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает уникальные сочетания (Склад, Ячейка, Номенклатура) расходной части
// документа с суммарным требуемым количеством: используется как источник
// управляемой блокировки и для сообщений о нехватке остатка.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Склад, Ячейка, Номенклатура, Требуется, ПерваяСтрока
//   (индекс первой строки ТЧ с этим сочетанием, для привязки сообщения).
//
Функция КомбинацииРасхода()
	
	Комбинации = Новый ТаблицаЗначений;
	Комбинации.Колонки.Добавить("Склад",
		Новый ОписаниеТипов("СправочникСсылка._ДемоМестаХранения"));
	Комбинации.Колонки.Добавить("Ячейка",
		Новый ОписаниеТипов("СправочникСсылка.ЯчейкиХранения"));
	Комбинации.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка._ДемоНоменклатура"));
	Комбинации.Колонки.Добавить("Требуется",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	Комбинации.Колонки.Добавить("ПерваяСтрока",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(9, 0)));
	
	НайденныеКомбинации = Новый Соответствие;
	
	НомерСтроки = 0;
	Для Каждого СтрокаТовары Из Товары Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		КомбинацииЯчейки = НайденныеКомбинации.Получить(СтрокаТовары.ЯчейкаИсточник);
		Если КомбинацииЯчейки = Неопределено Тогда
			КомбинацииЯчейки = Новый Соответствие;
			НайденныеКомбинации.Вставить(СтрокаТовары.ЯчейкаИсточник, КомбинацииЯчейки);
		КонецЕсли;
		
		СтрокаКомбинации = КомбинацииЯчейки.Получить(СтрокаТовары.Номенклатура);
		Если СтрокаКомбинации = Неопределено Тогда
			СтрокаКомбинации = Комбинации.Добавить();
			СтрокаКомбинации.Склад         = Склад;
			СтрокаКомбинации.Ячейка        = СтрокаТовары.ЯчейкаИсточник;
			СтрокаКомбинации.Номенклатура  = СтрокаТовары.Номенклатура;
			СтрокаКомбинации.ПерваяСтрока  = НомерСтроки - 1;
			КомбинацииЯчейки.Вставить(СтрокаТовары.Номенклатура, СтрокаКомбинации);
		КонецЕсли;
		
		СтрокаКомбинации.Требуется = СтрокаКомбинации.Требуется + СтрокаТовары.Количество;
		
	КонецЦикла;
	
	Возврат Комбинации;
	
КонецФункции

// Выводит сообщение с привязкой к полю объекта и устанавливает Отказ.
//
// Параметры:
//   Текст - Строка - текст сообщения.
//   Поле - Строка - путь к полю, например "Товары[0].ЯчейкаИсточник".
//   Отказ - Булево - флаг отказа, устанавливается в Истина.
//
Процедура СообщитьОбОшибкеПоля(Текст, Поле, Отказ)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле  = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли