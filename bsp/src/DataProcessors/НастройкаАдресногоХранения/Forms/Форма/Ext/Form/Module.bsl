#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РядыОт = 1;
	РядыПо = 1;
	СекцииОт = 1;
	СекцииПо = 1;
	ЯрусыОт = 1;
	ЯрусыПо = 1;
	
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	ОбновитьИндикаторРежимаНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВключитьАдресноеХранение(Команда)
	
	УстановитьРежимАдресногоХранения(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьАдресноеХранение(Команда)
	
	УстановитьРежимАдресногоХранения(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СгенерироватьЯчейки(Команда)
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите склад для генерации ячеек.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Зона) И ПустаяСтрока(КодЗоны) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите существующую зону или код новой зоны.'"));
		Возврат;
	КонецЕсли;
	
	РезультатГенерации = СгенерироватьЯчейкиНаСервере();
	Если ЗначениеЗаполнено(РезультатГенерации.ТекстОшибки) Тогда
		ПоказатьПредупреждение(, РезультатГенерации.ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьРежимАдресногоХранения(Включить)
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите склад.'"));
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = УстановитьРежимАдресногоХраненияНаСервере(Включить);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
	ОбновитьИндикаторРежимаНаСервере();
	
КонецПроцедуры

&НаСервере
Функция УстановитьРежимАдресногоХраненияНаСервере(Включить)
	
	Попытка
		АдресноеХранение.УстановитьИспользование(Склад, Включить);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	
	Если Включить Тогда
		Текст = НСтр("ru = 'Адресное хранение по складу ""%1"" включено.'");
	Иначе
		Текст = НСтр("ru = 'Адресное хранение по складу ""%1"" отключено.'");
	КонецЕсли;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(Текст, Строка(Склад));
	Сообщение.Сообщить();
	
	Возврат "";
	
КонецФункции

&НаСервере
Процедура ОбновитьИндикаторРежимаНаСервере()
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		ТекущийРежим = "";
		Возврат;
	КонецЕсли;
	
	ТекущийРежим = ?(АдресноеХранение.Используется(Склад),
		НСтр("ru = 'Адресное хранение включено'"),
		НСтр("ru = 'Адресное хранение не включено'"));
	
КонецПроцедуры

&НаСервере
Функция СгенерироватьЯчейкиНаСервере()
	
	РезультатГенерации = Новый Структура;
	РезультатГенерации.Вставить("ТекстОшибки", "");
	
	Если ЗначениеЗаполнено(Зона) Тогда
		ЗонаГенерации = Зона;
	Иначе
		ЗонаГенерации = СокрЛП(КодЗоны);
	КонецЕсли;
	
	ПараметрыГенерации = Новый Структура;
	ПараметрыГенерации.Вставить("Склад", Склад);
	ПараметрыГенерации.Вставить("Зона", ЗонаГенерации);
	ПараметрыГенерации.Вставить("РядыОт", РядыОт);
	ПараметрыГенерации.Вставить("РядыПо", РядыПо);
	ПараметрыГенерации.Вставить("СекцииОт", СекцииОт);
	ПараметрыГенерации.Вставить("СекцииПо", СекцииПо);
	ПараметрыГенерации.Вставить("ЯрусыОт", ЯрусыОт);
	ПараметрыГенерации.Вставить("ЯрусыПо", ЯрусыПо);
	
	Попытка
		Итог = АдресноеХранение.СгенерироватьЯчейки(ПараметрыГенерации);
	Исключение
		РезультатГенерации.ТекстОшибки = ОписаниеОшибки();
		Возврат РезультатГенерации;
	КонецПопытки;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(
		НСтр("ru = 'Создано ячеек: %1, пропущено: %2.'"),
		Итог.Создано, Итог.Пропущено);
	Сообщение.Сообщить();
	
	Возврат РезультатГенерации;
	
КонецФункции

#КонецОбласти
