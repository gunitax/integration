#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоНовый() Тогда
		ЗапретИзмененияАдресныхРеквизитов(Отказ);
		Если Не Отказ И ПометкаУдаления Тогда
			КонтрольОстатковПриУдалении(Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроверкаПринадлежностиЗоныСкладу(Отказ);
	
	Если Не Отказ И ЭтоНовый() И ЗначениеЗаполнено(Склад) Тогда
		ПроверкаАдресногоХраненияСклада(Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПересобратьАдрес(Отказ);
	
	Если Не Отказ Тогда
		КонтрольУникальностиАдреса(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	КонтрольОстатковПриУдалении(Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запрещает изменение адресных реквизитов (Зона, Ряд, Секция, Ярус)
// у существующей ячейки - адрес неизменен после записи (FR-018).
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина при изменении адресных реквизитов.
//
Процедура ЗапретИзмененияАдресныхРеквизитов(Отказ)
	
	ПрежниеЗначения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Зона, Ряд, Секция, Ярус");
	
	Если ПрежниеЗначения.Зона <> Зона
		Или ПрежниеЗначения.Ряд <> Ряд
		Или ПрежниеЗначения.Секция <> Секция
		Или ПрежниеЗначения.Ярус <> Ярус Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Адресные реквизиты существующей ячейки изменять запрещено.'"), ,
			"Объект.Адрес");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Запрещает пометку удаления и удаление ячейки при наличии остатков товара (FR-011).
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина при наличии остатков.
//
Процедура КонтрольОстатковПриУдалении(Отказ)
	
	Если Не ОстаткиОтсутствуют() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Ячейка не может быть помечена на удаление или удалена: по ней есть остатки товара.'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, что зона ячейки принадлежит складу ячейки.
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина при несоответствии склада зоны.
//
Процедура ПроверкаПринадлежностиЗоныСкладу(Отказ)
	
	Если Не ЗначениеЗаполнено(Зона) Или Не ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	Если Зона.Склад <> Склад Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Зона не принадлежит складу ячейки.'"), ,
			"Объект.Зона");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// При записи новой ячейки проверяет, что склад включен в адресное хранение (US1-5).
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина, если адресное хранение не включено.
//
Процедура ПроверкаАдресногоХраненияСклада(Отказ)
	
	Если Не АдресноеХранение.Используется(Склад) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Для склада не включено адресное хранение.'"), ,
			"Объект.Склад");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Пересобирает адрес ячейки из компонентов и заполняет наименование адресом (FR-003).
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина, если адрес собрать невозможно.
//
Процедура ПересобратьАдрес(Отказ)
	
	Если Не ЗначениеЗаполнено(Зона) Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = АдресноеХранение.СоставитьАдрес(Зона.КодЗоны, Ряд, Секция, Ярус);
	Наименование = Адрес;
	
КонецПроцедуры

// Проверяет уникальность адреса в пределах склада запросом (FR-003).
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина при существующем адресе.
//
Процедура КонтрольУникальностиАдреса(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ячейки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЯчейкиХранения КАК Ячейки
		|ГДЕ
		|	Ячейки.Склад = &Склад
		|	И Ячейки.Адрес = &Адрес
		|	И Ячейки.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Адрес", Адрес);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Ячейка с таким адресом уже существует на этом складе.'"), ,
			"Объект.Адрес");
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает Истина, если остатков товара в ячейке нет.
//
// Возвращаемое значение:
//   Булево - остатков в регистре ОстаткиТоваровПоЯчейкам нет.
//
Функция ОстаткиОтсутствуют()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиТоваровПоЯчейкам.Остатки(, Ячейка = &Ячейка) КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0";
	Запрос.УстановитьПараметр("Ячейка", Ссылка);

	Возврат Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
