#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	КодЗоны = СокрЛП(КодЗоны);

	Если Не АдресноеХранение.ПроверитьКодЗоны(КодЗоны) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Код зоны должен состоять из одного символа: буква А-Я, A-Z или цифра.'"), ,
			"Объект.КодЗоны");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ПометкаУдаления Тогда
		КонтрольЯчеекПриУдалении(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	КонтрольУникальностиКодаЗоны(Отказ);

	Если Не Отказ Тогда
		Наименование = КодЗоны;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	КонтрольЯчеекПриУдалении(Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запрещает пометку удаления и удаление зоны при наличии ячеек зоны,
// не помеченных на удаление (FR-016).
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина при наличии активных ячеек.
//
Процедура КонтрольЯчеекПриУдалении(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ячейки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЯчейкиХранения КАК Ячейки
		|ГДЕ
		|	Ячейки.Зона = &Зона
		|	И Ячейки.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Зона", Ссылка);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Зона не может быть помечена на удаление или удалена: в ней есть ячейки, не помеченные на удаление.'"));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Проверяет уникальность кода зоны в пределах склада запросом (FR-002).
//
// Параметры:
//   Отказ - Булево - устанавливается в Истина при дублирующем коде зоны.
//
Процедура КонтрольУникальностиКодаЗоны(Отказ)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат; // обязательность склада проверяется платформой
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Зоны.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗоныХранения КАК Зоны
		|ГДЕ
		|	Зоны.Склад = &Склад
		|	И Зоны.КодЗоны = &КодЗоны
		|	И Зоны.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("КодЗоны", КодЗоны);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Зона с таким кодом уже существует на этом складе.'"), ,
			"Объект.КодЗоны");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
