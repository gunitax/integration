
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ЭтоНовый() Тогда
		ссУзел = ПолучитьСсылкуНового();
		Если Не ЗначениеЗаполнено(ссУзел) Тогда
			ссУзел = СервиснаяШинаПредприятия.Менеджер().ПолучитьСсылку(); 
			УстановитьСсылкуНового(ссУзел);
		КонецЕсли;
	Иначе
		ссУзел = Ссылка;
	КонецЕсли;
		
	Для Каждого Топик Из Топики Цикл
		Если Не ЗначениеЗаполнено(Топик.УИДПотока) Тогда
			Топик.УИДПотока = СервиснаяШинаПредприятия.ВычислитьУИДПотока(ссУзел, Топик);
		КонецЕсли;
	КонецЦикла;
	
	УИДыБыли = Ссылка.Топики.ВыгрузитьКолонку("УИДПотока");
	УИДыСтали = Топики.ВыгрузитьКолонку("УИДПотока");
	
	УдаленныеУИДы = ОбщегоНазначенияКлиентСервер.РазностьМассивов(УИДыБыли, УИДыСтали);
	ДополнительныеСвойства.Вставить("УдаленныеУИДы", УдаленныеУИДы);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	УдаленныеУИДы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "УдаленныеУИДы", Новый Массив); 
	
    Если УдаленныеУИДы.Количество() > 0 Тогда
		Для Каждого УдаленныйУИД Из УдаленныеУИДы Цикл
			Если Не ЗначениеЗаполнено(УдаленныйУИД) Тогда Продолжить; КонецЕсли;
			СсылкаНаУдаляемыйУзел = СервиснаяШинаПредприятия.Менеджер().ПолучитьСсылку(УдаленныйУИД);
			ПланыОбмена.УдалитьРегистрациюИзменений(СсылкаНаУдаляемыйУзел);
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.';
						|en = 'Invalid object call on the client.'");
#КонецЕсли
