#КонецОбласти

#Область ВыполнениеДействий

// Точка входа для выполнения обмена данными регламентным заданием.
//
// Для каждого узла сервисной шины запускается задание на выгрузку изменений
// изменения выгружаются по топикам последовательно..
// и задания на получение для каждого топика узла в указаное количество потоков чтения
// указывать количество потоков чтения больше чем разделов топика не имеет смысла..
//
Процедура ВыполнитьОбменДаннымиПоРегламентномуЗаданию() Экспорт
		
	УзлыОбмена = СервиснаяШинаПредприятия.Менеджер().Выбрать();
	
	ОтборВходящих = Новый Структура("НаправлениеОбмена");
	ОтборВходящих.Направлениеобмена = ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Входящий");
		
	Пока УзлыОбмена.Следующий() Цикл
		Узел = УзлыОбмена.Ссылка;
		Если Узел.ЭтотУзел ИЛИ Узел.ПометкаУдаления Тогда Продолжить; КонецЕсли;
		
		// Запуск потоков отправки
		ЗапуститьПотокиВыгрузкиИзмененийПоТопикам(Узел);
		
		// Создание контролирующего задания на отправку
		КлючФонового = "Сервисная шина: Отправка """ + Узел.Код + """ (менеджер потоков)";
		Если Не ЕстьАктивноеФоновоеЗадание(КлючФонового) Тогда 
			
			ПараметрыФоновогоЗадания = Новый Массив;
			ПараметрыФоновогоЗадания.Добавить(Узел);
			
			ИмяМетода = "СервиснаяШинаПредприятия.ОтправитьИзмененияВШинуПредприятия";
			
			ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыФоновогоЗадания, КлючФонового, КлючФонового);
			
		КонецЕсли;
		
		// Создание заданий чтения
		Если НЕ ЗначениеЗаполнено(Узел.ИмяГруппыПолучателей) Тогда Продолжить; КонецЕсли;
			
		ТопикиНаПрием = Узел.Топики.НайтиСтроки(ОтборВходящих); 
		
		Для Каждого Топик Из ТопикиНаПрием Цикл
			
			ПараметрыТопика = ПолучитьПараметрыТопика(Топик);		
			КоличествоПотоковЧтения = ПараметрыТопика.ПараметрыЧтения.ПотоковЧтения;
			
			Для сч = 1 По КоличествоПотоковЧтения Цикл
				
				КлючФонового = "Сервисная шина: Прием """ + Узел.Код + """ " + ПараметрыТопика.ИмяТопика + " поток " + сч;
				Если ЕстьАктивноеФоновоеЗадание(КлючФонового) Тогда Продолжить; КонецЕсли;
				
				ПараметрыФоновогоЗадания = Новый Массив;
				ПараметрыФоновогоЗадания.Добавить(Узел);
				ПараметрыФоновогоЗадания.Добавить(ПараметрыТопика);
				ПараметрыФоновогоЗадания.Добавить(сч);
				
				ИмяМетода = "СервиснаяШинаПредприятия.ПолучитьИзмененияИзШиныПредприятия";
				
				ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыФоновогоЗадания, КлючФонового, КлючФонового);
			КонецЦикла;
		КонецЦикла;
			
	КонецЦикла;

КонецПроцедуры

// Процедура - Отправить изменения в шину предприятия
//
// Параметры:
//  Узел - ПланОменаСсылка - Ссылка на узел плана обмена сервисной шины предприятия
//
Процедура ОтправитьИзмененияВШинуПредприятия(ОсновнойУзел) Экспорт    
	
	// выключение через час работы перезапустится регламентным заданием   
	ВремяПрерывания = ТекущаяДатаСеанса() + 3600;
	
	УдалитьРегистрациюМетаданныхНеВключенныхВОбмен(ОсновнойУзел);
	ПеререгистрироватьВыбранныеНоНеотправленныеИзменения(ОсновнойУзел);
	
	ПотокиПоМетаданным = ЗапуститьПотокиВыгрузкиИзмененийПоТопикам(ОсновнойУзел);
	
	Если ПотокиПоМетаданным.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	// Накидываем изменения из основного узла в узлы потоков
	
	// *** ЗаписьXML-документов.
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	// *** Инфраструктура сообщений.
	ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
	ЗаписьСообщения.НачатьЗапись(ЗаписьXML, ОсновнойУзел);
	НомерСообщения = ЗаписьСообщения.НомерСообщения;
	
	Пока Не ТребуетсяПрерываниеОбмена(ВремяПрерывания) Цикл
		Для Каждого КлючИЗначение Из ПотокиПоМетаданным Цикл
			МетаданныеОбъекта = КлючИЗначение.Ключ;
			ПолноеИмяМетаданных = МетаданныеОбъекта.ПолноеИмя();
			
			УзлыПотоковВыгрузки = КлючИЗначение.Значение;
			
			Если ЕстьИзмененияНаОтправку(ОсновнойУзел, ПолноеИмяМетаданных)
				И НЕ ЕстьИзмененияНаОтправку(УзлыПотоковВыгрузки, ПолноеИмяМетаданных) Тогда
				
				ДанныеНаПеререгистрацию = Новый Массив;
				ВыборкаИзменений = ПолучитьПорциюНаОтправку(ОсновнойУзел, ПолноеИмяМетаданных, НомерСообщения, 3000);
				Пока ВыборкаИзменений.Следующий() Цикл
					ДанныеНаПеререгистрацию.Добавить(ВыборкаИзменений.Получить());		
				КонецЦикла;
				ПланыОбмена.ЗарегистрироватьИзменения(УзлыПотоковВыгрузки, ДанныеНаПеререгистрацию);
				ПланыОбмена.УдалитьРегистрациюИзменений(ОсновнойУзел, НомерСообщения);
			КонецЕсли;
		КонецЦикла;
		ОжиданиеИсполнения();
	КонецЦикла;	
	
	Если ЗаписьСообщения <> Неопределено Тогда
		ЗаписьСообщения.ЗакончитьЗапись();
	КонецЕсли;
	
КонецПроцедуры

Функция ЗапуститьПотокиВыгрузкиИзмененийПоТопикам(Узел)
	
	ЗначенияРеквизитовОсновногоУзла = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Узел, "Наименование, BootstrapServers");
	
	ПотокиПоМетаданным = Новый Соответствие;
	
	Отбор = Новый Структура("НаправлениеОбмена", ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Исходящий"));
	Для Каждого ТопикНаОтправку Из Узел.Топики.НайтиСтроки(Отбор) Цикл
		ПараметрыТопика = ПолучитьПараметрыТопика(ТопикНаОтправку);
		
		ПолноеИмяМетаданных = ПараметрыТопика.ПолноеИмяМетаданных;
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмяМетаданных);
		Если Не Метаданные().Состав.Содержит(МетаданныеОбъекта) Тогда Продолжить; КонецЕсли;
	
		ПараметрыУзлаПотока = СервиснаяШинаПредприятияКлиентСервер.ПараметрыУзла();	
		ЗаполнитьЗначенияСвойств(ПараметрыУзлаПотока, ЗначенияРеквизитовОсновногоУзла);
		
		Если ЗначениеЗаполнено(ТопикНаОтправку.УИДПотока) Тогда
			УИДПотока = ТопикНаОтправку.УИДПотока;
		Иначе
			УИДПотока = ВычислитьУИДПотока(Узел, ТопикНаОтправку);
		КонецЕсли;
		
		ПараметрыУзлаПотока.Ссылка = Менеджер().ПолучитьСсылку(УИДПотока);	
		
		Потоки = ПотокиПоМетаданным[МетаданныеОбъекта];
		Если Потоки = Неопределено Тогда
			Потоки = Новый Массив;
			ПотокиПоМетаданным.Вставить(МетаданныеОбъекта, Потоки);
		КонецЕсли;
		Потоки.Добавить(ПараметрыУзлаПотока.Ссылка);
		
		Если ЕстьИзмененияНаОтправку(Узел, ПолноеИмяМетаданных) 
			Или ЕстьИзмененияНаОтправку(ПараметрыУзлаПотока.Ссылка, ПолноеИмяМетаданных) Тогда
			
			КлючФонового = "Сервисная шина: Отправка """ + Узел.Код + """ " + ПараметрыТопика.ИмяТопика;
			Если Не ЕстьАктивноеФоновоеЗадание(КлючФонового) Тогда 
				
				ПараметрыФоновогоЗадания = Новый Массив;
				ПараметрыФоновогоЗадания.Добавить(ПараметрыУзлаПотока);
				ПараметрыФоновогоЗадания.Добавить(ПараметрыТопика);
				
				ИмяМетода = "СервиснаяШинаПредприятия.ОтправитьИзмененияПоТопикуВШинуПредприятия";
				
				ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыФоновогоЗадания, КлючФонового, КлючФонового);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПотокиПоМетаданным;

КонецФункции

Процедура ОтправитьИзмененияПоТопикуВШинуПредприятия(ПараметрыУзла, ПараметрыТопика) Экспорт
	
	НомерСообщения = 1;
	Отправитель = СервиснаяШинаПредприятия.СоздатьОтправителя();

	ПараметрыИнициализации = СервиснаяШинаПредприятияКлиентСервер.ПараметрыИнициализацииОтправителя();
	ПараметрыИнициализации.Адрес = ПараметрыУзла.BootstrapServers;
	ПараметрыИнициализации.Топик = ПараметрыТопика.ИмяТопика;
	
	Для Каждого ГлобальныйПараметр Из ПараметрыТопика.ГлобальныеПараметрыОтправителя Цикл
		Отправитель.УстановитьПараметрГлобальный(ГлобальныйПараметр.Ключ, ГлобальныйПараметр.Значение);
	КонецЦикла;	
	
	Для Каждого Параметр Из ПараметрыТопика.ПараметрыОтправителя Цикл
		Отправитель.УстановитьПараметрТопика(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	Отправитель.Инициализировать(ПараметрыИнициализации);				
		
	// выключение через час работы перезапустится регламентным заданием   
	ВремяПрерывания = ТекущаяДатаСеанса() + 3600;
	
	ПолноеИмяМетаданных = ПараметрыТопика.ПолноеИмяМетаданных;
	
	Если СервиснаяШинаПредприятияПовтИсп.МетодМенеджераОбъектаРеализован(ПолноеИмяМетаданных, "СообщениеДляОтправкиВУзел") 
		Или СервиснаяШинаПредприятияПовтИсп.МетодМенеджераОбъектаРеализован(ПолноеИмяМетаданных, "ПолучитьСообщенияДляСервиснойШиныПредприятия") Тогда
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяМетаданных);
	Иначе 
		МенеджерОбъекта = ОбщегоНазначения.ОбщийМодуль("СервиснаяШинаПредприятия");
	КонецЕсли;
	
	//ПутьКМетрике = ПутьКМетрикеОтправки(ПараметрыУзла, ПараметрыТопика);	
	
	Пока НЕ ТребуетсяПрерываниеОбмена(ВремяПрерывания) Цикл
		
		Если СервиснаяШинаПредприятияПовтИсп.МетодМенеджераОбъектаРеализован(ПолноеИмяМетаданных, "ПолучитьСообщенияДляСервиснойШиныПредприятия") Тогда
			Сообщения = МенеджерОбъекта.ПолучитьСообщенияДляСервиснойШиныПредприятия(ПараметрыУзла, ПараметрыТопика, НомерСообщения);
		Иначе
			ВыборкаИзменений = ПолучитьПорциюНаОтправку(ПараметрыУзла.Ссылка, ПолноеИмяМетаданных, НомерСообщения);
			
			Сообщения = Новый Массив;
			Пока ВыборкаИзменений.Следующий() Цикл
				
				ОбъектИзменений = ВыборкаИзменений.Получить();
				
				Сообщение = СервиснаяШинаПредприятияКлиентСервер.Сообщение();
				
				ОтправкаЭлемента = ОтправкаЭлементаДанных.Авто;
				
				МенеджерОбъекта.СообщениеДляОтправкиВУзел(Сообщение, ОбъектИзменений, ОтправкаЭлемента);
				Если ОтправкаЭлемента <> ОтправкаЭлементаДанных.Авто Тогда
					ПланыОбмена.УдалитьРегистрациюИзменений(ПараметрыУзла.Ссылка, ОбъектИзменений);	
				Иначе
					Сообщения.Добавить(Сообщение);
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		
		Если Сообщения.Количество() Тогда
			Если Не Отправитель.ОтправитьДанные(Сообщения) Тогда 
				ТекстСообщения = "Не удалось отправить сообщения в сервисную шину: Узел - %1, Топик - %2";
				ВызватьИсключение СтрШаблон(ТекстСообщения, ПараметрыУзла.Наименование, ПараметрыТопика.ИмяТопика);
			КонецЕсли;
			ПланыОбмена.УдалитьРегистрациюИзменений(ПараметрыУзла.Ссылка, НомерСообщения);
		КонецЕсли;
		
		//МетрикиGraphite.Метрика(ПутьКМетрике, Сообщения.Количество());
		
		Если Сообщения.Количество() = 0 Тогда
			ОжиданиеИсполнения();
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отправитель <> Неопределено Тогда
		Отправитель.Уничтожить();
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Получить изменения из шины предприятия
//
// Параметры:
//  Узел - ПланОменаСсылка - Ссылка на узел плана обмена сервисной шины предприятия
//  ПараметрыТопика	 - Структура - см.СервиснаяШинаПредприятияКлиентСервер.ПараметрыТопика()
//
Процедура ПолучитьИзмененияИзШиныПредприятия(Узел, ПараметрыТопика, НомерПотока) Экспорт
	
	//ПутьКМетрике = ПутьКМетрикеПолучения(Узел, ПараметрыТопика, НомерПотока);
	
	ПолноеИмяМетаданных = ПараметрыТопика.ПолноеИмяМетаданных;
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяМетаданных);
	
	Получатель = СервиснаяШинаПредприятия.СоздатьПолучателя();
	
	ПараметрыИнициализации = СервиснаяШинаПредприятияКлиентСервер.ПараметрыИнициализацииПолучателя();
	ПараметрыИнициализации.Адрес = Узел.BootstrapServers;
	ПараметрыИнициализации.ИмяГруппыПолучателей = Узел.ИмяГруппыПолучателей;
	
	Для Каждого ГлобальныйПараметрПолучателя Из ПараметрыТопика.ГлобальныеПараметрыПолучателя Цикл
		Получатель.УстановитьПараметрГлобальный(ГлобальныйПараметрПолучателя.Ключ, ГлобальныйПараметрПолучателя.Значение);
	КонецЦикла;	
	
	Для Каждого ПараметрПолучателя Из ПараметрыТопика.ПараметрыПолучателя Цикл
		Получатель.УстановитьПараметрТопика(ПараметрПолучателя.Ключ, ПараметрПолучателя.Значение);
	КонецЦикла;
	
	Получатель.Инициализировать(ПараметрыИнициализации);
	Получатель.Подписаться(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрыТопика.ИмяТопика));
		
	ПараметрыЧтения = СервиснаяШинаПредприятияКлиентСервер.ПараметрыЧтенияСообщений();
	ЗаполнитьЗначенияСвойств(ПараметрыЧтения, ПараметрыТопика.ПараметрыЧтения);
	
	// выключение через час работы перезапустится регламентным заданием 
	ВремяПрерывания = ТекущаяДатаСеанса() + 3600;
	
	Пока Не ТребуетсяПрерываниеОбмена(ВремяПрерывания) Цикл
		
		// Постоянно опрашивается брокер на наличие новых сообщений, таймаут в параметрах чтения
		Если Получатель.ПрочитатьСписокСообщенийВПул(ПараметрыЧтения) = 0 Тогда   
			//МетрикиGraphite.Метрика(ПутьКМетрике, 0);
			Продолжить; 
		КонецЕсли;
		
		СообщенияJSON = Получатель.ПолучитьСообщенияИзПулаJSON(Ложь);
		Сообщения = СервиснаяШинаПредприятияКлиентСервер.JSONВСтруктуру(СообщенияJSON);
		
		Если СервиснаяШинаПредприятияПовтИсп.МетодМенеджераОбъектаРеализован(ПолноеИмяМетаданных, "РазобратьВходящиеСообщенияСервиснойШины") Тогда
			РезультатРазбора = МенеджерОбъекта.РазобратьВходящиеСообщенияСервиснойШины(Сообщения, Узел);
		Иначе
			
			Если СервиснаяШинаПредприятияПовтИсп.МетодМенеджераОбъектаРеализован(ПолноеИмяМетаданных, "РазобратьВходящиеСообщенияСервиснойШины") Тогда
				Менеджер = МенеджерОбъекта;
			Иначе
				Менеджер = ОбщегоНазначения.ОбщийМодуль("СервиснаяШинаПредприятия");
			КонецЕсли;
			
			Для Каждого Сообщение Из Сообщения Цикл
				РезультатРазбора = Менеджер.РазобратьВходящееСообщение(Сообщение, Узел);
				Если РезультатРазбора <> Истина Тогда Прервать; КонецЕсли;			
			КонецЦикла;
		КонецЕсли;
		
		Если РезультатРазбора <> Истина Тогда
			ТекстСообщения = НСтр(
			"ru = 'Ошибка разбора сообщений';
			|en = 'Messages parsing error'");
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	
		//МетрикиGraphite.Метрика(ПутьКМетрике, Сообщения.Количество());
		Получатель.ЗафиксироватьСмещения();
		
	КонецЦикла;
	
	Если Получатель <> Неопределено Тогда
		Получатель.Уничтожить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограмныйИнтерфейс

// Получает параметры топика узла
//
// Параметры:
//  Топик - СтрокаТабличнойЧасти - Топик узла
// 
// Возвращаемое значение:
//	Структура - см.СервиснаяШинаПредприятияКлиентСервер.ПараметрыТопика()
//
Функция ПолучитьПараметрыТопика(Топик) Экспорт

	ПараметрыТопика = СервиснаяШинаПредприятияКлиентСервер.ПараметрыТопика();
	СохраненныеПараметры = Топик.ПараметрыТопика.Получить(); 
	Если СохраненныеПараметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыТопика, СохраненныеПараметры);	
	КонецЕсли;
	
	ПараметрыТопика.Вставить("ИмяТопика"			, Топик.ИмяТопика); 
	ПараметрыТопика.Вставить("ПолноеИмяМетаданных"	, Топик.Метаданные.ПолноеИмя); // Для БСП Справочник.ИдентификаторыОбъектовМетаданных иначе Строка
	
	Возврат ПараметрыТопика;
	
КонецФункции

// Проверяет есть ли активное фоновое задание с заданным ключем
//
// Параметры:
//  КлючФонового - Строка - Ключ фонового задания
// 
// Возвращаемое значение:
//	Булево - Истина если есть активное задание с указаным ключем
//
Функция ЕстьАктивноеФоновоеЗадание(КлючФонового) Экспорт
	
	ОтборФоновых = Новый Структура("Ключ, Состояние", КлючФонового, СостояниеФоновогоЗадания.Активно);
	Возврат ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборФоновых).Количество() > 0;
	
КонецФункции

// Процедура - Сообщение для отправки в узел
//
// Параметры:
//  Сообщение		 - Структура	- Сообщение для отправки в сервисную шину предприятия см. СервиснаяШинаПредприятияКлиентСервер.Сообщение() 
//  ОбъектИзменений	 - СправочникОбъект - Объект справочника изменения которого отправляются 
//	ОтправкаЭлемента - ОтправкаЭлементаДанных - Значение по умолчанию "Авто", отличное от "Авто" значение удаляет регистрацию из узла и исключает отправку
//  Узел			 - ПланОбменаОбъект - Узел для которого формируется сообщение
//
Процедура СообщениеДляОтправкиВУзел(Сообщение, ОбъектИзменений, ОтправкаЭлемента, Узел = Неопределено) Экспорт
	
	// Стандартное формирование сообщения для отправки в сервисную шину предприятия.
	// Для переопределения поведения функции следует скопировать её в модуль менеджера объекта метаданных изменив содержимое обработчика
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектИзменений, "Ссылка") Тогда
		КлючСообщения = XMLСтрока(ОбъектИзменений.Ссылка);
	Иначе // Не ссылочная сущность
		МетаданныеОбъекта = ОбъектИзменений.Метаданные();
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(МетаданныеОбъекта, "РежимЗаписи") 
			И Строка(МетаданныеОбъекта.РежимЗаписи) = "Независимый" Тогда
			
			Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
			Для Каждого Измерение Из МетаданныеОбъекта.Измерения Цикл
				Если Измерение.ОсновнойОтбор Тогда
					Хеш.Добавить(XMLСтрока(ОбъектИзменений.Отбор[Измерение.Имя].Значение));
				КонецЕсли;
			КонецЦикла;		
			КлючСообщения = Нрег(Строка(СтрЗаменить(Хеш.ХешСумма, " ", "")));
		Иначе
			КлючСообщения = XMLСтрока(ОбъектИзменений.Отбор.Регистратор.Значение);	
		КонецЕсли;	
	КонецЕсли;
			
	Сообщение.Key = КлючСообщения;	
		
	Если ТипЗнч(ОбъектИзменений) <> Тип("УдалениеОбъекта") Тогда
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, ОбъектИзменений, НазначениеТипаXML.Явное);
		
		Сообщение.Value = ЗаписьXML.Закрыть();
		
	КонецЕсли;
		
КонецПроцедуры 

// Функция - Разобрать входящее сообщение
//
// Параметры:
//  Сообщение	 - Структура - Входящее сообщение из сервисной шины предприятия (Apache Kafka)
//		* Headers - Массив из Структур:
//			** Ключ - Строка - Ключ заголовка 
//			** Значение - Произвольный - Значение заголовка
//		* Key - Строка - Ключ сообщения
//		* Offset - Число - Смещение сообщения
//		* Partition - Число - Номер раздела
//		* Timestamp - Число - Отпечаток времени
//		* Topic - Строка - Имя топика
//		* Value - Строка - Тело сообщения
// 
// Возвращаемое значение:
//	Булево - Истина при успешном результате разбора сообщения
//
Функция РазобратьВходящееСообщение(Сообщение, Узел = Неопределено) Экспорт
	
	// Стандартный разбор входящего сообщения сервисной шины предприятия.
	// Для переопределения поведения функции следует скопировать её в модуль менеджера объекта метаданных изменив содержимое обработчика
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Сообщение.Value);
	
	Попытка
		ПолученныйОбъект = СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
		
		ПолученныйОбъект.ОбменДанными.Загрузка = Истина;
		ПолученныйОбъект.Записать();
		Возврат Истина;
	Исключение
		// Обработка ошибки
	КонецПопытки;
	
КонецФункции

// Функция - Есть изменения на отправку
//
// Параметры:
//  Узел				 - ПланОбменаСсылка, Массив - Узел плана обмена сервисной шины или массив из таких узлов
//  ПолноеИмяМетаданных	 - Строка - Полное имя метаданных
//  НомерСообщения		 - Число - Номер исходящего сообщения сервисной шины
// 
// Возвращаемое значение:
//	Булево - Истина если есть неотправленные именения метаданных в узел плана обмена
//
Функция ЕстьИзмененияНаОтправку(Узел, ПолноеИмяМетаданных, НомерСообщения = Неопределено) Экспорт
	
	Если НЕ СервиснаяШинаПредприятияПовтИсп.МетаданныеВСоставеПланаОбмена(ПолноеИмяМетаданных) Тогда Возврат Ложь; КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1
	|ИЗ
	|	#ОбъектМетаданных КАК Изменения
	|ГДЕ
	|	Изменения.Узел В (&Узел)
	|	И (&НомерСообщения = НЕОПРЕДЕЛЕНО
	|			ИЛИ Изменения.НомерСообщения <= &НомерСообщения)";
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#ОбъектМетаданных", ПолноеИмяМетаданных + ".Изменения");
	
	Возврат НЕ Запрос.Выполнить().Пустой(); 
	
КонецФункции

Функция ПолучитьПорциюНаОтправку(Узел, ПолноеИмяМетаданных, НомерСообщенияОбмена, РазмерПорции = 1000) Экспорт
	
	ОсновнойОтбор = Новый Массив;

	Если СтрНачинаетсяС(ПолноеИмяМетаданных, "Справочник") 
		Или СтрНачинаетсяС(ПолноеИмяМетаданных, "ПланВидовХарактеристик")
		Или СтрНачинаетсяС(ПолноеИмяМетаданных, "БизнесПроцесс")
		Или СтрНачинаетсяС(ПолноеИмяМетаданных, "Задача") Тогда
		ОсновнойОтбор.Добавить("Ссылка");			
	ИначеЕсли СтрНачинаетсяС(ПолноеИмяМетаданных, "РегистрСведений")
		И Строка(Метаданные.НайтиПоПолномуИмени(ПолноеИмяМетаданных).РежимЗаписи) = "Независимый" Тогда
		Для Каждого Измерение Из Метаданные.НайтиПоПолномуИмени(ПолноеИмяМетаданных).Измерения Цикл
			Если Измерение.ОсновнойОтбор Тогда
				ОсновнойОтбор.Добавить(Измерение.Имя);
			КонецЕсли;
		КонецЦикла;		
	Иначе
		ОсновнойОтбор.Добавить("Регистратор");	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("НомерСообщенияОбмена", НомерСообщенияОбмена);
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&ВыбираемыеПоля КАК ВыбираемыеПоля
	|ИЗ
	|	#ОбъектМетаданных КАК Изменения
	|ГДЕ
	|	Изменения.Узел = &Узел
	|	И Изменения.НомерСообщения <= &НомерСообщенияОбмена";
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#ОбъектМетаданных", ПолноеИмяМетаданных + ".Изменения");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыбираемыеПоля КАК ВыбираемыеПоля", СтрСоединить(ОсновнойОтбор, ", "));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		// Нет неотправленных изменений по текущему номеру сообщения
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 99999
		|	&ВыбираемыеПоля КАК ВыбираемыеПоля
		|ИЗ
		|	#ОбъектМетаданных КАК Изменения
		|ГДЕ
		|	Изменения.Узел = &Узел";
		
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#ОбъектМетаданных", ПолноеИмяМетаданных + ".Изменения");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ВыбираемыеПоля КАК ВыбираемыеПоля", СтрСоединить(ОсновнойОтбор, ", "));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПЕРВЫЕ 99999", "ПЕРВЫЕ " + Формат(РазмерПорции, "ЧГ="));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
	КонецЕсли;
	
	Измененные = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если СтрНачинаетсяС(ПолноеИмяМетаданных, "РегистрСведений") Тогда
			нз = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяМетаданных).СоздатьНаборЗаписей();
			Для Каждого ПолеОтбора Из ОсновнойОтбор Цикл
				нз.Отбор[ПолеОтбора].Установить(Выборка[ПолеОтбора]);
			КонецЦикла;
			Измененные.Добавить(нз);
		Иначе
			Измененные.Добавить(Выборка.Ссылка); 
		КонецЕсли;
	КонецЦикла;
	
	// Получить выборку измененных данных
	// *** Механизм регистрации изменений.
	Если Измененные.Количество() > 0 Тогда
		Возврат ПланыОбмена.ВыбратьИзменения(Узел, НомерСообщенияОбмена, Измененные);
	Иначе
		Возврат Выборка;
	КонецЕсли;
	
КонецФункции

// Функция - Требуется прерывание обмена
//
// Параметры:
//  ВремяПрерывания	 - Дата - Время прерывания
// 
// Возвращаемое значение:
//	Булево - Истина если требуется прервать обмен данными с сервисной шиной
//
Функция ТребуетсяПрерываниеОбмена(ВремяПрерывания = Неопределено) Экспорт
	
	Возврат СоединенияИБ.УстановленаБлокировкаСоединений() 
		ИЛИ НЕ РегламентныеЗадания.НайтиПредопределенное("СервиснаяШинаПредприятияОбменДанными").Использование
		ИЛИ (ВремяПрерывания <> Неопределено И ТекущаяДатаСеанса() > ВремяПрерывания);
		
КонецФункции

// Процедура - Ожидание исполнения
//
// Параметры:
//  Таймаут	 - Число - Количество секунд ожидания
//
// Ожидание в пределах исполнения фонового задания, некий sleep
//
Процедура ОжиданиеИсполнения(Таймаут = 5) Экспорт
	
	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ФоновоеЗадание <> Неопределено Тогда
		ФоновоеЗадание.ОжидатьЗавершенияВыполнения(5);
	КонецЕсли;
	
КонецПроцедуры

Функция ВычислитьУИДПотока(Узел, Топик) Экспорт
	
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(XMLСтрока(Узел.Ссылка));
	Хеш.Добавить(XMLСтрока(Топик.НаправлениеОбмена));
	Хеш.Добавить(XMLСтрока(Топик.ИмяТопика));
	Хеш.Добавить(XMLСтрока(Топик.Метаданные));
	
	ХешСтрока = СтрЗаменить(Строка(Хеш.ХешСумма), " ", "");
	ЧастиУИД = Новый Массив;
	ЧастиУИД.Добавить(Лев(ХешСтрока, 8));
	ЧастиУИД.Добавить(Сред(ХешСтрока, 8, 4));
	ЧастиУИД.Добавить(Сред(ХешСтрока, 12, 4));
	ЧастиУИД.Добавить(Сред(ХешСтрока, 16, 4));
	ЧастиУИД.Добавить(Прав(ХешСтрока, 12));
	
	Возврат Новый УникальныйИдентификатор(СтрСоединить(ЧастиУИД, "-"));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьПодключениеВнешнейКомпоненты()
		
	СистемнаяИнформация = Новый СистемнаяИнформация;

	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда	
		МакетКомпоненты = "ОбщийМакет.librdkafka_win32";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_win64";    
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда     
		МакетКомпоненты = "ОбщийМакет.librdkafka_linux32";	          
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_linux64";
	Иначе
		ТекстСообщения = НСтр(
			"ru = 'Не поддерживаемая архитектура платформы';
			|en = 'Unsupported platform architecture'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Попытка
		РезультатПодключенияВнешнейКомпоненты = ПодключитьВнешнююКомпоненту(МакетКомпоненты, "librdkafka", ТипВнешнейКомпоненты.Native);
		Если НЕ РезультатПодключенияВнешнейКомпоненты Тогда
			ТекстСообщения = НСтр(
			"ru = 'Ошибка подключения внешней компоненты';
			|en = 'External component connection error'");
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат РезультатПодключенияВнешнейКомпоненты;
	
КонецФункции

