// Процедура - Удалить регистрацию метаданных не включенных в обмен
//
// Параметры:
//  Узел - ПланОбменаСсылка	 - Узел плана обмена сервисной шины
//
// Производит удаление зарегистрированных изменений метаданных отсутствующих в составе узла с направлением "Исходящий"
// Изменения регистрируются во все узлы сервисной шины но не во все действительно выгружаются.
//
Процедура УдалитьРегистрациюМетаданныхНеВключенныхВОбмен(Узел)
	
	Для Каждого ЭлементСостава Из Узел.Метаданные().Состав Цикл
		МетаданныеЭлементаСостава = ЭлементСостава.Метаданные;
		
		ПолноеИмяМетаданных = МетаданныеЭлементаСостава.ПолноеИмя();
		
		ИдентификаторМетаданного = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеЭлементаСостава);
		ТопикиСМетаданными = Узел.Топики.НайтиСтроки(Новый Структура("Метаданные", ИдентификаторМетаданного));
		ВключенВОбмен = Ложь;
		Для Каждого Топик Из ТопикиСМетаданными Цикл
			Если Топик.НаправлениеОбмена = Перечисления.НаправленияОбменаССервиснойШиной.Исходящий Тогда
				ВключенВОбмен = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ВключенВОбмен И ЕстьИзмененияНаОтправку(Узел, ПолноеИмяМетаданных) Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, МетаданныеЭлементаСостава);
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Процедура ПеререгистрироватьВыбранныеНоНеотправленныеИзменения(Узел)
	
	НомерСообщения = Узел.НомерОтправленного + 1;
	
	Отбор = Новый Структура("НаправлениеОбмена");
	Отбор.Направлениеобмена = ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Исходящий");
	ТопикиНаОтправку = Узел.Топики.НайтиСтроки(Отбор); 
	
	Если ТопикиНаОтправку.Количество() = 0 Тогда Возврат; КонецЕсли;

	// Могут быть Топики в которые данные выбраны с номером сообщения, но по какой то причине не отправлены, нужно их перерегистрировать 
	ТопикиСНеотправленнымиСообщениями = ПроверитьТопикиНаНаличиеСообщений(Узел, НомерСообщения, ТопикиНаОтправку);
	Для Каждого Топик Из ТопикиСНеотправленнымиСообщениями Цикл
		ПараметрыТопика = ПолучитьПараметрыТопика(Топик);
		ВыборкаИзменений = ПолучитьПорциюНаОтправку(Узел, ПараметрыТопика.ПолноеИмяМетаданных, НомерСообщения);
		МассивИзменений = Новый Массив;
		Пока ВыборкаИзменений.Следующий() Цикл
			МассивИзменений.Добавить(ВыборкаИзменений.Получить());
		КонецЦикла;                                               
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, МассивИзменений);
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьТопикиНаНаличиеСообщений(Узел, НомерСообщения, Знач ТопикиНаОтправку)
	
	ТопикиССообщениями = Новый Массив;
	
	Для Каждого Топик Из ТопикиНаОтправку Цикл
		ПараметрыТопика = ПолучитьПараметрыТопика(Топик);
		Если ЕстьИзмененияНаОтправку(Узел, ПараметрыТопика.ПолноеИмяМетаданных, НомерСообщения) Тогда
			ТопикиССообщениями.Добавить(Топик);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТопикиССообщениями;
	
КонецФункции

