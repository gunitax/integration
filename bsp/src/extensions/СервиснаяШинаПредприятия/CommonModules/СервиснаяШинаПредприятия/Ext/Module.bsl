 
#Область ПрограмныйИнтерфейс

// Функция - Создать отправителя
// 
// Возвращаемое значение:
//  ОбщийМодуль - общий модуль для раборты с объектом внешней компоненты KafkaProducer см. СервиснаяШинаПредприятияОтправитель
//
Функция СоздатьОтправителя() Экспорт

	ОбъектыСервиснойШиныПредприятия = ПолучитьИзВременногоХранилища(ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	ИмяПараметра = "ВнешняяКомпонентаПодключена";
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] <> Истина Тогда
    	ОбъектыСервиснойШиныПредприятия.Вставить(ИмяПараметра, ВыполнитьПодключениеВнешнейКомпоненты());
	КонецЕсли;
	
	ИмяПараметра = "ОтправительСообщенийВШину";
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] = Неопределено Тогда
		ОбъектыСервиснойШиныПредприятия.Вставить(ИмяПараметра, Новый("AddIn.librdkafka.KafkaProducer"));
	КонецЕсли;
	
	ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия = ПоместитьВоВременноеХранилище(ОбъектыСервиснойШиныПредприятия, ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	Возврат ОбщегоНазначения.ОбщийМодуль("СервиснаяШинаПредприятияОтправитель");	
	
КонецФункции

// Функция - Создать получателя
// 
// Возвращаемое значение:
//  ОбщийМодуль - общий модуль для раборты с объектом внешней компоненты KafkaConsumer см. СервиснаяШинаПредприятияПолучатель
//
Функция СоздатьПолучателя() Экспорт
	
	ОбъектыСервиснойШиныПредприятия = ПолучитьИзВременногоХранилища(ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	ИмяПараметра = "ВнешняяКомпонентаПодключена";
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] <> Истина Тогда
    	ОбъектыСервиснойШиныПредприятия.Вставить(ИмяПараметра, ВыполнитьПодключениеВнешнейКомпоненты());
	КонецЕсли;
	
	ИмяПараметра = "ПолучательСообщенийИзШины";
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] = Неопределено Тогда
		ОбъектыСервиснойШиныПредприятия.Вставить(ИмяПараметра, Новый("AddIn.librdkafka.KafkaConsumer"));
	КонецЕсли;
	
	ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия = ПоместитьВоВременноеХранилище(ОбъектыСервиснойШиныПредприятия, ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	Возврат ОбщегоНазначения.ОбщийМодуль("СервиснаяШинаПредприятияПолучатель");
	
КонецФункции

