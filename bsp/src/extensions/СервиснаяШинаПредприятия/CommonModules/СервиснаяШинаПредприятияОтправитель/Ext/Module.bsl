
#Область ПрограммныйИнтерфейс

// Отправитель установить параметр глобальный
//
// Параметры:
//  Ключ		 - 	Строка - Имя параметра
//  Значение	 - 	Строка - Значение параметра
// 
// Устанавливает параметр глабольного контекста для отправителя (глProducer)
//	Пример: Ключ = socket.timeout.ms Значение = 30000  
//!!Для применения установленных параметров - необходимка поторная инициализация получателя с помощью функции "Отправитель.Инициализировать()"
//
Процедура УстановитьПараметрГлобальный(Знач Ключ, Знач Значение) Экспорт
	
	Если Отправитель().SetGlobalConf(Ключ, Значение) <> Истина Тогда 
		ТекстСообщения = НСтр(
		"ru = 'Не удалось установить глобальный параметр отправителя %1=%2, возникла ошибка. %3';
		|en = 'Failed to set global producer parameter %1=%2, an error occurred. %3'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Ключ, Значение, Отправитель().ErrorDescription);
	КонецЕсли;
		
КонецПроцедуры

// Отправитель установить параметр топика
//
// Параметры:
//  Ключ		 - 	Строка - Имя параметра
//  Значение	 - 	Строка - Значение параметра
// 
// Устанавливает параметр топика для отправителя (глProducer) 
//	Пример: Ключ = auto.offset.reset Значение = smallest  
//!!Для применения установленных параметров - необходимка поторная инициализация получателя с помощью функции "Отправитель.Инициализировать()"
//
Процедура УстановитьПараметрТопика(Знач Ключ, Знач Значение) Экспорт
	
	Если Отправитель().SetTopicConf(Ключ, Значение) <> Истина Тогда 
		ТекстСообщения = НСтр(
		"ru = 'Не удалось установить параметр топика %1=%2, возникла ошибка. %3'; 
		|en = 'Failed to set topic parameter %1=%2, an error occurred. %3'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Ключ, Значение, Отправитель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Отправитель сбросить параметры
// 
// Сбрасывает установенные параметры топика и параметры глобального контекста (установленные функциями Отправитель.УстановитьПараметрГлобальный, Отправитель.УстановитьПараметрТопика)
//!!Для применения - необходимка поторная инициализация получателя с помощью функции "Отправитель.Инициализировать()"
//
Процедура СброситьПараметры() Экспорт
	
	Если Отправитель().ConfReset() <> Истина Тогда 
		ТекстСообщения = НСтр(
		"ru = 'Не удалось сбросить парамеры отправителя, возникла ошибка. %1';
		|en = 'Failed to reset producer parameters, an error occurred. %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Отправитель().ErrorDescription);
	КонецЕсли;
		
КонецПроцедуры

// Процедура - Инициализировать отправителя
//
// Параметры:
// 	ПараметрыИнициализации	 - Структура		- см. СервиснаяШинаПредприятияКлиентСервер.ПараметрыИнициализацииОтправителя()
//
Процедура Инициализировать(ПараметрыИнициализации) Экспорт
		
	Адрес	= ПараметрыИнициализации.Адрес;
	Топик	= ПараметрыИнициализации.Топик;
	Раздел	= ПараметрыИнициализации.Раздел;
	
	Если Отправитель().Initialize(Адрес, Топик, Раздел) <> Истина Тогда 
		ТекстСообщения = НСтр(
		"ru = 'Не удалось выполнить инициализацию для топика ""%1"" возникла ошибка. %2';
		|en = 'Failed to initialize producer for topic ""%1"" with an error. %2'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Топик, Отправитель().ErrorDescription);
	КонецЕсли;
		
КонецПроцедуры

// Функция - Отправить данные
//
// Параметры:
//  Сообщения	 - Массив - Массив сообщений см.СервиснаяШинаПредприятияКлиентСервер.Сообщение() 
// 
// Возвращаемое значение:
//  Булево - Истина в случае успешной отправки
//
Функция ОтправитьДанные(Сообщения) Экспорт
	
	ЗагрузитьСообщенияВСписокНаОтправку(Сообщения);
	
	Отправить();
	
	Если ВсеСообщенияДоставлены() Тогда
		Возврат Истина;
	КонецЕсли;
	
	ОтчетОДоставке = ПолучитьОтчетОДоставке();
	Для Каждого Данные из ОтчетОДоставке Цикл
		Если Данные.Error <> "Success" Тогда
			ТекстСообщения = НСтр(
				"ru = 'Не удалось доставить данные по причине - %1';
				|en = 'Failed to deliver data due to - %1'");
			ВызватьИсключение СтрШаблон(ТекстСообщения, Данные.Error);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура Уничтожить() Экспорт
	
	ОбъектыСервиснойШиныПредприятия = ПолучитьИзВременногоХранилища(ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	ИмяПараметра = "ОтправительСообщенийВШину";
	ОбъектыСервиснойШиныПредприятия[ИмяПараметра] = Неопределено;
	
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] = Неопределено Тогда
		ОбъектыСервиснойШиныПредприятия.Вставить(ИмяПараметра, Неопределено);
	КонецЕсли;
	
	ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия = ПоместитьВоВременноеХранилище(ОбъектыСервиснойШиныПредприятия, ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
КонецПроцедуры

#КонецОбласти

Функция Отправитель()
	
	ОбъектыСервиснойШиныПредприятия = ПолучитьИзВременногоХранилища(ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	ИмяПараметра = "ВнешняяКомпонентаПодключена";
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] <> Истина Тогда
		ТекстСообщения = НСтр(
		"ru = 'Не подключена внешняя компонента'
		|en = 'External component not connected'");
		ВызватьИсключение ТекстСообщения;;
	КонецЕсли;
	
	ИмяПараметра = "ОтправительСообщенийВШину";
	Отправитель = ОбъектыСервиснойШиныПредприятия[ИмяПараметра];
	
	Если Отправитель = Неопределено Тогда
		ТекстСообщения = НСтр(
		"ru = 'Не инициализирован отправитель kafka'
		|en = 'Producer kafka not initialized'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Возврат Отправитель;
	
КонецФункции

Процедура ЗагрузитьСообщенияВСписокНаОтправку(Знач Сообщения)
		
	СообщенияJSON = СервиснаяШинаПредприятияКлиентСервер.СтруктуруВJSON(Сообщения);
	
	Если Отправитель().SetJSONMessageList(СообщенияJSON) <> Истина Тогда 
		ТекстСообщения = НСтр(
		"ru = 'Ошибка загрузки сообщений в пул отправителя kafka по причине - %1';
		|en = 'Failed to upload messages to kafka sender pool due to - %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Отправитель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

Процедура Отправить()
	
	Если Отправитель().Produce() <> Истина Тогда
		ТекстСообщения = НСтр(
		"ru = 'Ошибка при отправке данных в Kafka по причине - %1';
		|en = 'Error sending data to Kafka due to reason - %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Отправитель().ErrorDescription);	
	КонецЕсли;
	
КонецПроцедуры

Функция ВсеСообщенияДоставлены()
		
	Возврат Отправитель().IsDelivered();
	
КонецФункции

Функция ПолучитьОтчетОДоставке()
	
	ОтчетОДоставкеJSON = Отправитель().GetJSONDeliveryReport();	
	
	Если ОтчетОДоставкеJSON = Неопределено Тогда
		ТекстСообщения = НСтр(
		"ru = 'Ошибка получения отчета о доставке сообщений отправителем kafka по причине - %1';
		|en = 'Failed to receive message delivery report by kafka producer due to - %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Отправитель().ErrorDescription);	
	КонецЕсли;
	
	ОтчетОДоставке = СервиснаяШинаПредприятияКлиентСервер.JSONВСтруктуру(ОтчетОДоставкеJSON);
	
	Возврат ОтчетОДоставке;
	
КонецФункции