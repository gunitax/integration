
Процедура УстановкаПараметровСеанса(ИмяПараметра, УстановленныеПараметры) Экспорт
	
	Если ИмяПараметра = "ОбъектыСервиснойШиныПредприятия" Тогда                            
		
		ОбъектыСервиснойШиныПредприятия = Новый Структура();
		ОбъектыСервиснойШиныПредприятия.Вставить("ВнешняяКомпонентаПодключена"	, Ложь);
		ОбъектыСервиснойШиныПредприятия.Вставить("ОтправительСообщенийВШину"	, Неопределено);
		ОбъектыСервиснойШиныПредприятия.Вставить("ПолучательСообщенийИзШины"	, Неопределено);
		
		ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия = ПоместитьВоВременноеХранилище(ОбъектыСервиснойШиныПредприятия, Новый УникальныйИдентификатор);
		УстановленныеПараметры.Добавить("ОбъектыСервиснойШиныПредприятия");
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик Подписок на события "ИсключитьУзлыСервиснойШиныПередЗаписьюОбъекта" и "ИсключитьУзлыСервиснойШиныПередЗаписьюНабораЗаписей" 
//
// Параметры:
//  Источник - Объект, НаборЗаписей	 - 
//  Отказ	 - Булево	 - 
//  Замещать - Булево	 - Для НаборовЗаписей регистров
//
Процедура ПередЗаписьюОбъектаСервиснойШины(Источник, Отказ, Замещать = Истина) Экспорт
	
	// Регистрируем только в те узлы где присутствуют метаданные в составе топиков
	// Точнее удаляем из тех узлов где они отсутствуют
	МетаданныеИсточника = Источник.Метаданные();
	
	МетаданныеВСоставеСШ = СервиснаяШинаПредприятияПовтИсп.МетаданныеВСоставеПланаОбмена(МетаданныеИсточника.ПолноеИмя());
	
	Получатели = Источник.ОбменДанными.Получатели;
	Если Не МетаданныеВСоставеСШ Или Получатели.Количество() = 0 Тогда Возврат; КонецЕсли;
	
	Для Каждого Узел Из ИсключаемыеИзРегистрацииУзлы(МетаданныеИсточника) Цикл 
		Если Получатели.Содержит(Узел) Тогда 
			Получатели.Удалить(Узел);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область СлужебныйПрограммныйИнтерфейс

Функция ИсключаемыеИзРегистрацииУзлы(МетаданныеИсточника) Экспорт
	
	ИсключаемыеУзлы = Новый Массив;

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.БазоваяФункциональность") Тогда
		ИдентификаторМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(МетаданныеИсточника);
		
		ОтборТопиков = Новый Структура("Метаданные", ИдентификаторМетаданных);
			
		УзелСервиснойШины = СервиснаяШинаПредприятия.Менеджер().Выбрать();
		Пока УзелСервиснойШины.Следующий() Цикл
			Если УзелСервиснойШины.ЭтотУзел 
				Или УзелСервиснойШины.ПометкаУдаления Тогда
				ИсключаемыеУзлы.Добавить(УзелСервиснойШины.Ссылка);
				Продолжить;
			КонецЕсли;
			
			ТопикиСМетаданными = УзелСервиснойШины.Топики.НайтиСтроки(ОтборТопиков);
			УчавствуетВОбмене = Ложь;
			
			Для Каждого Топик Из ТопикиСМетаданными Цикл
				Если Топик.НаправлениеОбмена = Перечисления.НаправленияОбменаССервиснойШиной.Исходящий Тогда
					УчавствуетВОбмене = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не УчавствуетВОбмене Тогда
				ИсключаемыеУзлы.Добавить(УзелСервиснойШины.Ссылка);	
			КонецЕсли;
			
		КонецЦикла;
			
	Иначе
		// Не основанная на бсп система	
	КонецЕсли; 	
	
	Возврат Новый ФиксированныйМассив(ИсключаемыеУзлы);
	
КонецФункции

#КонецОбласти