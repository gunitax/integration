 
#Область ПрограммныйИнтерфейс

Функция СтруктуруВJSON(Данные) Экспорт
	
	ЗаписьJSON                = Новый ЗаписьJSON();
	НастройкиСериализацииJSON = Новый НастройкиСериализацииJSON();
	
	ЗаписьJSON.УстановитьСтроку();
	
	НастройкиСериализацииJSON.ВариантЗаписиДаты      = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	НастройкиСериализацииJSON.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	
	Попытка
		ЗаписатьJSON(ЗаписьJSON, Данные, НастройкиСериализацииJSON);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		ТекстСообщения = НСтр(""
			+ "ru = 'Ошибка преобразования в JSON по причине - %1';"
			+ "en = 'Error converting to JSON due to - %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, ОписаниеОшибки());	
	КонецПопытки;
		
КонецФункции

Функция JSONВСтруктуру(СтрокаJSON)   Экспорт
		
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Попытка
		_Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		
		Если ТипЗнч(_Данные) = Тип("Структура") Тогда
			Данные = Новый Массив();	
			Данные.Добавить(_Данные);
		ИначеЕсли ТипЗнч(_Данные) = Тип("Массив") Тогда
			Данные = _Данные;				
		Иначе
			ТекстСообщения = НСтр(""
				+ "ru = 'Не верный тип данных!';"
				+ "en = 'Invalid data type!'");
			ВызватьИсключение ТекстСообщения;	
		КонецЕсли;
		
	Исключение
		ВызватьИсключение;
	КонецПопытки;	
	
	ЧтениеJSON.Закрыть();
	
	Возврат Данные;
	
КонецФункции

// Параметры инициализации отправителя
// 
// Возвращаемое значение:
// Структура - инициализации отправителя:
//	* Адрес - Строка - Адреса брокеров в формате "10.0.5.187:9092,10.0.5.85:9092,10.0.5.86:9092"	
//	* Топик - Строка - Имя топика
//	* Раздел - Число - Номер раздела, (-1 на усмотрение брокера)
//
Функция ПараметрыИнициализацииОтправителя() Экспорт
	
	ПараметрыИнициализацииОтправителя = Новый Структура;
	ПараметрыИнициализацииОтправителя.Вставить("Адрес"	, "");
	ПараметрыИнициализацииОтправителя.Вставить("Топик"	, "");
	ПараметрыИнициализацииОтправителя.Вставить("Раздел"	, -1);
	
	Возврат ПараметрыИнициализацииОтправителя;
	
КонецФункции

// Параметры инициализации получателя
// 
// Возвращаемое значение:
// Структура - Параметры инициализации получателя:
//	* Адрес - Строка - Адреса брокеров в формате "10.0.5.187:9092,10.0.5.85:9092,10.0.5.86:9092"	
//	* ИмяГруппыПолучателей - Строка - Идентификаотр группы получателей
//
Функция ПараметрыИнициализацииПолучателя() Экспорт

	ПараметрыИнициализацииПолучателя = Новый Структура;
	ПараметрыИнициализацииПолучателя.Вставить("Адрес"				, "");
	ПараметрыИнициализацииПолучателя.Вставить("ИмяГруппыПолучателей", "");
	
	Возврат ПараметрыИнициализацииПолучателя;
	
КонецФункции

// Параметры назначения получателя
// 
// Возвращаемое значение:
// 	Структура - Параметры назначения получателя:
//	* Топик		- Строка 				- Имя топика, который необходимо добавить в список назначений
//	* Раздел	- Число	 				- Номер раздела топика
//	* Смещение	- Число, Неопределено	- Смещение с которого необходимо начать чтение, если Неопределено - будут получено последнее смещение, закоммиченное в брокер
//                   
Функция ПараметрыНазначенияПолучателя() Экспорт

	ПараметрыНазначенияПолучателя = Новый Структура;
	ПараметрыНазначенияПолучателя.Вставить("Топик"	, "");
	ПараметрыНазначенияПолучателя.Вставить("Раздел"	, "");
	ПараметрыНазначенияПолучателя.Вставить("Смещение", Неопределено);
	
	Возврат ПараметрыНазначенияПолучателя;
	
КонецФункции

// Параметры чтения сообщений
// 
// Возвращаемое значение:
//	Структура - Параметры чтения сообщений:
//	* Количество - Число - Количество сообщений, которые необходимо получить
//	* ТаймаутНаОдно - Число - Ожидание одного сообщения
//	* ОшибокДоПрерывания - Число - Количество ошибок, в том числе таймаутов, после которого получение будет прервано
//
Функция ПараметрыЧтенияСообщений() Экспорт
	
	ПараметрыЧтенияСообщений = Новый Структура;
	ПараметрыЧтенияСообщений.Вставить("Количество"			, 1000);
	ПараметрыЧтенияСообщений.Вставить("Таймаут"				, 5000);
	ПараметрыЧтенияСообщений.Вставить("ОшибокДоПрерывания"	, 1);
	
	Возврат ПараметрыЧтенияСообщений;
	
КонецФункции

Функция ПараметрыТопика() Экспорт

	ПараметрыТопика = Новый Структура;
	ПараметрыТопика.Вставить("ИмяТопика", "");
	ПараметрыТопика.Вставить("ПолноеИмяМетаданных", ""); 
	
	ПараметрыТопика.Вставить("ПараметрыЧтения", ПараметрыЧтенияСообщений());
	ПараметрыТопика.ПараметрыЧтения.Вставить("ПотоковЧтения", 1);
	
	ПараметрыТопика.Вставить("ГлобальныеПараметрыПолучателя", Новый Соответствие);
	// Коммит после успешного разбора
	ПараметрыТопика.ГлобальныеПараметрыПолучателя.Вставить("enable.auto.commit", "false");
	
	ПараметрыТопика.Вставить("ПараметрыПолучателя", Новый Соответствие);
	// По умолчанию чтение с начала топика
	ПараметрыТопика.ПараметрыПолучателя.Вставить("auto.offset.reset", "earliest");
	
	ПараметрыТопика.Вставить("ГлобальныеПараметрыОтправителя"	, Новый Соответствие);
	ПараметрыТопика.Вставить("ПараметрыОтправителя"				, Новый Соответствие);
	
	Возврат ПараметрыТопика;
	
КонецФункции

Функция ПараметрыУзла() Экспорт

	ПараметрыУзла = Новый Структура;
	ПараметрыУзла.Вставить("Ссылка");
	ПараметрыУзла.Вставить("Наименование", "");
	ПараметрыУзла.Вставить("BootstrapServers", "");
	
	Возврат ПараметрыУзла;
	
КонецФункции

Функция Сообщение() Экспорт
	
	Сообщение = Новый Структура;
	Сообщение.Вставить("Headers", Новый Массив); 
	Сообщение.Вставить("Key"	, Строка(Новый УникальныйИдентификатор));
	Сообщение.Вставить("Value"	, Неопределено);
	
	Возврат Сообщение;
	
КонецФункции

