#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Новому документу создаем одну строку расшифровки платежа, как в образце формы.
	Если Объект.Ссылка.Пустая() И Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
		Объект.РасшифровкаПлатежа.Добавить();
	КонецЕсли;

	ОбновитьЗаголовокРасшифровки();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ОбновитьЗаголовокРасшифровки();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ОбновитьЗаголовокРасшифровки();

КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)

	СинхронизироватьРасшифровкуССуммой();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЗаголовокРасшифровки()

	Элементы.СтраницаРасшифровка.Заголовок = СтрШаблон(
		НСтр("ru = 'Расшифровка платежа (%1)'"),
		Объект.РасшифровкаПлатежа.Количество());

КонецПроцедуры

&НаСервере
Процедура СинхронизироватьРасшифровкуССуммой()

	// Расшифровка платежа ведется одной строкой на всю сумму документа.
	Если Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
		Объект.РасшифровкаПлатежа.Добавить();
	КонецЕсли;
	Объект.РасшифровкаПлатежа[0].Сумма = Объект.СуммаДокумента;
	ОбновитьЗаголовокРасшифровки();

КонецПроцедуры

&НаСервере
Функция СформироватьПечатнуюФорму()

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КД_ПриходныйКассовыйОрдер";
	ТабличныйДокумент.ПолеСлева = 20;
	ТабличныйДокумент.ПолеСправа = 10;
	ТабличныйДокумент.ПолеСверху = 10;
	ТабличныйДокумент.ПолеСнизу = 10;

	ЗаголовокДокумента = ТабличныйДокумент.Область("R1C1:R2C6");
	ЗаголовокДокумента.Объединить();
	ЗаголовокДокумента.Текст = НСтр("ru = 'ПРИХОДНЫЙ КАССОВЫЙ ОРДЕР'");
	ЗаголовокДокумента.Шрифт = Новый Шрифт(, 14, Истина);
	ЗаголовокДокумента.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ЗаголовокДокумента.ВертикальноеПоложение = ВертикальноеПоложение.Центр;

	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 4, НСтр("ru = 'Номер'"), Объект.Номер);
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 5, НСтр("ru = 'Дата'"), Формат(Объект.Дата, "ДЛФ=DT"));
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 6, НСтр("ru = 'Касса'"), Строка(Объект.Касса));
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 7, НСтр("ru = 'Принято от'"), Объект.ПринятоОт);
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 8, НСтр("ru = 'Основание'"), Объект.Основание);
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 9, НСтр("ru = 'Сумма'"), Формат(Объект.СуммаДокумента, "ЧЦ=15; ЧДЦ=2; ЧН=0,00") + " руб.");
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 10, НСтр("ru = 'В т. ч. НДС'"), Строка(Объект.СтавкаНДС));
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 11, НСтр("ru = 'Приложение'"), Объект.Приложение);
	ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, 13, НСтр("ru = 'Автор'"), Строка(Объект.Ответственный));

	Возврат ТабличныйДокумент;

КонецФункции

&НаСервере
Процедура ВывестиРеквизитПечатнойФормы(ТабличныйДокумент, НомерСтроки, ИмяРеквизита, ЗначениеРеквизита)

	ЗначениеСтрокой = ?(ПустаяСтрока(Строка(ЗначениеРеквизита)), "—", Строка(ЗначениеРеквизита));

	// На 8.5 у области ячеек нет свойства Ширина — реквизит выводится одной объединенной строкой.
	ОбластьРеквизита = ТабличныйДокумент.Область("R" + НомерСтроки + "C1:R" + НомерСтроки + "C6");
	ОбластьРеквизита.Объединить();
	ОбластьРеквизита.Текст = ИмяРеквизита + ": " + ЗначениеСтрокой;
	ОбластьРеквизита.Шрифт = Новый Шрифт(, 11);

КонецПроцедуры

#КонецОбласти

