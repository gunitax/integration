
// Экспорт справочника _ДемоНоменклатура в топик Kafka.
// Внешняя компонента librdkafka подключается из общих макетов расширения
// СервиснаяШинаПредприятия (используются только её бинарные макеты, без вызова модулей).
// Формат сообщения: Key - артикул (или наименование), Value - JSON с полями товара.
//
#Область ПрограммныйИнтерфейс

// Выгружает все элементы справочника _ДемоНоменклатура в топик Kafka.
//
// Параметры:
//  Адрес - Строка - адреса брокеров Kafka, например "localhost:9092"
//  Топик - Строка - имя топика, например "goods"
//
// Возвращаемое значение:
//  Число - количество отправленных сообщений
//
Функция ВыгрузитьВсеТовары(Знач Адрес, Знач Топик) Экспорт

	Отправитель = СоздатьОтправителя(Адрес, Топик);

	Возврат ОтправитьТоварыПорциями(Отправитель);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьОтправителя(Знач Адрес, Знач Топик)

	ПодключитьВнешнююКомпонентуШины();

	Отправитель = Новый("AddIn.librdkafka.KafkaProducer");

	Если Отправитель.Initialize(Адрес, Топик, -1) <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Отправитель, "инициализации отправителя");
	КонецЕсли;

	Возврат Отправитель;

КонецФункции

Функция ОтправитьТоварыПорциями(Знач Отправитель)

	РазмерПорции = 100;
	Отправлено = 0;
	Сообщения = Новый Массив;

	Выборка = Справочники._ДемоНоменклатура.Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.ЭтоГруппа Или Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		Сообщения.Добавить(СообщениеОТоваре(Выборка.Ссылка));
		Если Сообщения.Количество() >= РазмерПорции Тогда
			ОтправитьПорцию(Отправитель, Сообщения);
			Отправлено = Отправлено + Сообщения.Количество();
			Сообщения.Очистить();
		КонецЕсли;

	КонецЦикла;

	Если Сообщения.Количество() > 0 Тогда
		ОтправитьПорцию(Отправитель, Сообщения);
		Отправлено = Отправлено + Сообщения.Количество();
	КонецЕсли;

	Возврат Отправлено;

КонецФункции

Процедура ОтправитьПорцию(Знач Отправитель, Знач Сообщения)

	СообщенияJSON = СтруктуруВJSON(Сообщения);

	Если Отправитель.SetJSONMessageList(СообщенияJSON) <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Отправитель, "загрузки сообщений в пул отправителя");
	КонецЕсли;

	Если Отправитель.Produce() <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Отправитель, "отправки данных");
	КонецЕсли;

	Если Не Отправитель.IsDelivered() Тогда
		ВызватьИсключение ОтчетОбОшибкахДоставки(Отправитель);
	КонецЕсли;

КонецПроцедуры

Функция ОтчетОбОшибкахДоставки(Знач Отправитель)

	ТекстОшибок = "";
	ОтчетJSON = Отправитель.GetJSONDeliveryReport();
	Если ОтчетJSON <> Неопределено Тогда
		Отчет = JSONВМассив(ОтчетJSON);
		Для Каждого Доставка Из Отчет Цикл
			Если Доставка.Error <> "Success" Тогда
				ТекстОшибок = ТекстОшибок + Символы.ПС + Доставка.Error;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СтрШаблон("Ошибка доставки сообщений Kafka:%1", ТекстОшибок);

КонецФункции

Функция СообщениеОТоваре(Знач Товар)

	ДанныеТовара = Новый Структура;
	ДанныеТовара.Вставить("Артикул", Товар.Артикул);
	ДанныеТовара.Вставить("Наименование", Товар.Наименование);
	ДанныеТовара.Вставить("Штрихкод", Товар.Штрихкод);
	ДанныеТовара.Вставить("Описание", Товар.Комментарий);

	Если ЗначениеЗаполнено(ДанныеТовара.Артикул) Тогда
		Ключ = ДанныеТовара.Артикул;
	Иначе
		Ключ = ДанныеТовара.Наименование;
	КонецЕсли;

	Сообщение = Новый Структура;
	Сообщение.Вставить("Headers", Новый Массив);
	Сообщение.Вставить("Key", Ключ);
	Сообщение.Вставить("Value", СтруктуруВJSON(ДанныеТовара));

	Возврат Сообщение;

КонецФункции

Процедура ПодключитьВнешнююКомпонентуШины()

	// Внешняя компонента может быть уже подключена в сеансе (например, во внешнем соединении)
	Если ВнешняяКомпонентаДоступна() Тогда
		Возврат;
	КонецЕсли;

	СистемнаяИнформация = Новый СистемнаяИнформация;

	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_win32";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_win64";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_linux32";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_linux64";
	Иначе
		ВызватьИсключение "Не поддерживаемая архитектура платформы";
	КонецЕсли;

	Если Не ПодключитьВнешнююКомпоненту(МакетКомпоненты, "librdkafka", ТипВнешнейКомпоненты.Native) Тогда
		ВызватьИсключение "Ошибка подключения внешней компоненты librdkafka";
	КонецЕсли;

КонецПроцедуры

Функция ВнешняяКомпонентаДоступна()

	Попытка
		Проба = Новый("AddIn.librdkafka.KafkaProducer");
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ТекстОшибкиВК(Знач Отправитель, Знач Действие)

	Возврат СтрШаблон("Ошибка %1: %2", Действие, Отправитель.ErrorDescription);

КонецФункции

Функция СтруктуруВJSON(Знач Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция JSONВМассив(Знач СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Обертка = Новый Массив;
		Обертка.Добавить(Результат);
		Результат = Обертка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
