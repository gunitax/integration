
// Сверка справочника _ДемоНоменклатура с состоянием товаров приёмной базы.
// Состояние приёмника читается HTTP-запросом к сервису ИТШ_Товары приёмной базы
// и сохраняется в регистр сведений СС_СостояниеТоваровПриемника для отчёта СКД.
//
#Область ПрограммныйИнтерфейс

// Загружает срез товаров приёмной базы по HTTP в регистр сведений.
//
// Параметры:
//  АдресСервиса - Строка - полный URL, например "http://localhost/uf-demo-test/hs/itsh-goods/v1/goods"
//
// Возвращаемое значение:
//  Число - количество товаров приёмника, записанных в срез
//
Функция ЗагрузитьСрез(Знач АдресСервиса) Экспорт

	ТоварыПриемника = ТоварыПоHTTP(АдресСервиса);

	Возврат ЗагрузитьСрезИзМассива(ТоварыПриемника);

КонецФункции

// Записывает в регистр сведений срез товаров приёмника из JSON-строки
// в формате HTTP-сервиса ИТШ_Товары. Загрузку по HTTP можно выполнить
// вне расширения (например, внешним скриптом) и передать тело ответа сюда.
//
// Параметры:
//  СтрокаJSON - Строка - JSON-массив товаров {Артикул, Наименование, Штрихкод, Описание}
//
// Возвращаемое значение:
//  Число - количество товаров приёмника, записанных в срез
//
Функция ЗагрузитьСрезИзJSON(Знач СтрокаJSON) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	ТоварыПриемника = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(ТоварыПриемника) <> Тип("Массив") Тогда
		ВызватьИсключение "Неверный формат JSON: ожидается массив товаров";
	КонецЕсли;

	Возврат ЗагрузитьСрезИзМассива(ТоварыПриемника);

КонецФункции

Функция ЗагрузитьСрезИзМассива(Знач ТоварыПриемника)

	// Набор без отбора с Замена = Истина заменяет всё содержимое регистра
	НаборЗаписей = РегистрыСведений.СС_СостояниеТоваровПриемника.СоздатьНаборЗаписей();

	ДатаЗагрузки = ТекущаяДатаСеанса();

	Для Каждого Товар Из ТоварыПриемника Цикл
		Запись = НаборЗаписей.Добавить();
		Запись.Ключ = КлючТовара(Товар.Артикул, Товар.Штрихкод, Товар.Наименование);
		Запись.АртикулПриемника = Товар.Артикул;
		Запись.ШтрихкодПриемника = Товар.Штрихкод;
		Запись.НаименованиеПриемника = Товар.Наименование;
		Запись.ОписаниеПриемника = Товар.Описание;
		Запись.ДатаЗагрузки = ДатаЗагрузки;
	КонецЦикла;

	НаборЗаписей.Записать(Истина);

	Возврат ТоварыПриемника.Количество();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТоварыПоHTTP(Знач АдресСервиса)

	Соединение = Новый HTTPСоединение(ХостИзURL(АдресСервиса), ПортИзURL(АдресСервиса));
	Запрос = Новый HTTPЗапрос(ПутьИзURL(АдресСервиса));
	Ответ = Соединение.Получить(Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("HTTP-сервис приёмника ответил кодом %1", Ответ.КодСостояния);
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Товары = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Товары) <> Тип("Массив") Тогда
		ВызватьИсключение "Неверный формат ответа HTTP-сервиса: ожидается массив";
	КонецЕсли;

	Возврат Товары;

КонецФункции

Функция КлючТовара(Знач Артикул, Знач Штрихкод, Знач Наименование)

	Если Не ПустаяСтрока(Артикул) Тогда
		Возврат "А:" + Артикул;
	ИначеЕсли Не ПустаяСтрока(Штрихкод) Тогда
		Возврат "Ш:" + Штрихкод;
	КонецЕсли;

	Возврат "Н:" + Наименование;

КонецФункции

Функция ХостИзURL(Знач URL)

	Остаток = СтрЗаменить(URL, "http://", "");
	Остаток = СтрЗаменить(Остаток, "https://", "");
	КонецХоста = СтрНайти(Остаток, "/");
	Если КонецХоста > 0 Тогда
		Остаток = Лев(Остаток, КонецХоста - 1);
	КонецЕсли;
	// отделить порт
	ПозицияПорта = СтрНайти(Остаток, ":");
	Если ПозицияПорта > 0 Тогда
		Остаток = Лев(Остаток, ПозицияПорта - 1);
	КонецЕсли;

	Возврат Остаток;

КонецФункции

Функция ПортИзURL(Знач URL)

	Если СтрНайти(URL, "https://") = 1 Тогда
		ПортПоУмолчанию = 443;
	Иначе
		ПортПоУмолчанию = 80;
	КонецЕсли;

	Остаток = СтрЗаменить(URL, "http://", "");
	Остаток = СтрЗаменить(Остаток, "https://", "");
	КонецХоста = СтрНайти(Остаток, "/");
	Если КонецХоста > 0 Тогда
		Остаток = Лев(Остаток, КонецХоста - 1);
	КонецЕсли;

	ПозицияПорта = СтрНайти(Остаток, ":");
	Если ПозицияПорта = 0 Тогда
		Возврат ПортПоУмолчанию;
	КонецЕсли;

	Возврат Число(Сред(Остаток, ПозицияПорта + 1));

КонецФункции

Функция ПутьИзURL(Знач URL)

	Остаток = СтрЗаменить(URL, "http://", "");
	Остаток = СтрЗаменить(Остаток, "https://", "");
	НачалоПути = СтрНайти(Остаток, "/");
	Если НачалоПути = 0 Тогда
		Возврат "/";
	КонецЕсли;

	Возврат Сред(Остаток, НачалоПути);

КонецФункции

#КонецОбласти
