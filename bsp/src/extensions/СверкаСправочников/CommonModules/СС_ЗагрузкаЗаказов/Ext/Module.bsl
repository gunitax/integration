
// Срез состояния заказов приёмной базы для отчёта СС_СверкаЗаказов.
// Состояние читается HTTP-запросом к сервису ИТШ_Товары приёмной базы
// (шаблон /v1/orders) и сохраняется в регистр СС_СостояниеЗаказовПриемника.
//
#Область ПрограммныйИнтерфейс

// Загружает срез заказов приёмной базы по HTTP в регистр сведений.
//
// Параметры:
//  АдресСервиса - Строка - полный URL, например
//               "http://localhost/uf-demo-test/hs/itsh-goods/v1/orders"
//
// Возвращаемое значение:
//  Число - количество записей среза, сохранённых в регистр
//
Функция ЗагрузитьСрезЗаказов(Знач АдресСервиса) Экспорт

	Записи = ЗаписиПоHTTP(АдресСервиса);

	Возврат ЗагрузитьСрезИзJSON(ЗаписиВJSON(Записи));

КонецФункции

// Записывает в регистр сведений срез заказов приёмника из JSON-строки
// в формате HTTP-сервиса ИТШ_Товары (/v1/orders). Загрузку по HTTP можно
// выполнить вне расширения и передать тело ответа сюда (headless-прогон).
//
// Параметры:
//  СтрокаJSON - Строка - JSON-массив записей {Номер, Дата (ISO), Организация,
//             Покупатель, ВалютаКод, СуммаДокумента, НомерСтроки, Номенклатура,
//             Артикул, Количество, Цена, СуммаСтроки}
//
// Возвращаемое значение:
//  Число - количество записей среза, сохранённых в регистр
//
Функция ЗагрузитьСрезИзJSON(Знач СтрокаJSON) Экспорт

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Записи = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		ВызватьИсключение "Неверный формат JSON: ожидается массив записей заказов";
	КонецЕсли;

	// Набор без отбора с Замена = Истина заменяет всё содержимое регистра
	НаборЗаписей = РегистрыСведений.СС_СостояниеЗаказовПриемника.СоздатьНаборЗаписей();

	ДатаЗагрузки = ТекущаяДатаСеанса();

	Для Каждого ЗаписьДанные Из Записи Цикл

		ДатаЗаказа = ДатаИзСтроки(ЗаписьДанные.Дата);
		Если Не ЗначениеЗаполнено(ДатаЗаказа) Тогда
			ВызватьИсключение СтрШаблон("Неверная дата заказа в записи среза: %1", ЗаписьДанные.Дата);
		КонецЕсли;

		Запись = НаборЗаписей.Добавить();
		Запись.Номер = ЗаписьДанные.Номер;
		Запись.Дата = ДатаЗаказа;
		Запись.СтрокаЗаказа = ЗаписьДанные.НомерСтроки;
		Запись.Организация = ЗаписьДанные.Организация;
		Запись.Покупатель = ЗаписьДанные.Покупатель;
		Запись.ВалютаКод = ЗаписьДанные.ВалютаКод;
		Запись.СуммаДокумента = ЗаписьДанные.СуммаДокумента;
		Запись.Номенклатура = ЗаписьДанные.Номенклатура;
		Запись.Артикул = ЗаписьДанные.Артикул;
		Запись.Количество = ЗаписьДанные.Количество;
		Запись.Цена = ЗаписьДанные.Цена;
		Запись.СуммаСтроки = ЗаписьДанные.СуммаСтроки;
		Запись.ДатаЗагрузки = ДатаЗагрузки;

	КонецЦикла;

	НаборЗаписей.Записать(Истина);

	Возврат Записи.Количество();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписиПоHTTP(Знач АдресСервиса)

	Соединение = Новый HTTPСоединение(ХостИзURL(АдресСервиса), ПортИзURL(АдресСервиса));
	Запрос = Новый HTTPЗапрос(ПутьИзURL(АдресСервиса));
	Ответ = Соединение.Получить(Запрос);

	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("HTTP-сервис приёмника ответил кодом %1", Ответ.КодСостояния);
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Записи = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		ВызватьИсключение "Неверный формат ответа HTTP-сервиса: ожидается массив";
	КонецЕсли;

	Возврат Записи;

КонецФункции

Функция ЗаписиВJSON(Знач Записи)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Записи);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ДатаИзСтроки(Знач СтрокаДата)

	Попытка
		Возврат XMLЗначение(Тип("Дата"), СтрокаДата);
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

Функция ХостИзURL(Знач URL)

	Остаток = СтрЗаменить(URL, "http://", "");
	Остаток = СтрЗаменить(Остаток, "https://", "");
	КонецХоста = СтрНайти(Остаток, "/");
	Если КонецХоста > 0 Тогда
		Остаток = Лев(Остаток, КонецХоста - 1);
	КонецЕсли;
	// отделить порт
	ПозицияПорта = СтрНайти(Остаток, ":");
	Если ПозицияПорта > 0 Тогда
		Остаток = Лев(Остаток, ПозицияПорта - 1);
	КонецЕсли;

	Возврат Остаток;

КонецФункции

Функция ПортИзURL(Знач URL)

	Если СтрНайти(URL, "https://") = 1 Тогда
		ПортПоУмолчанию = 443;
	Иначе
		ПортПоУмолчанию = 80;
	КонецЕсли;

	Остаток = СтрЗаменить(URL, "http://", "");
	Остаток = СтрЗаменить(Остаток, "https://", "");
	КонецХоста = СтрНайти(Остаток, "/");
	Если КонецХоста > 0 Тогда
		Остаток = Лев(Остаток, КонецХоста - 1);
	КонецЕсли;

	ПозицияПорта = СтрНайти(Остаток, ":");
	Если ПозицияПорта = 0 Тогда
		Возврат ПортПоУмолчанию;
	КонецЕсли;

	Возврат Число(Сред(Остаток, ПозицияПорта + 1));

КонецФункции

Функция ПутьИзURL(Знач URL)

	Остаток = СтрЗаменить(URL, "http://", "");
	Остаток = СтрЗаменить(Остаток, "https://", "");
	НачалоПути = СтрНайти(Остаток, "/");
	Если НачалоПути = 0 Тогда
		Возврат "/";
	КонецЕсли;

	Возврат Сред(Остаток, НачалоПути);

КонецФункции

#КонецОбласти
