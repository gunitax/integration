
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Адрес = "localhost:9092";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Топик) Тогда
		Топик = "invoices";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = НачалоГода(ТекущаяДатаСеанса());
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ДатаОкончания = КонецГода(ТекущаяДатаСеанса());
	КонецЕсли;

	ЗаполнитьСписокНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)

	Итоги = ВыгрузитьНаСервере();

	Если Итоги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сообщить(СтрШаблон("Выгружено счетов: %1, ошибок: %2", Итоги.Отправлено, Итоги.Ошибок));

	Для Каждого СтрокаПротокола Из Итоги.Протокол Цикл
		Сообщить(СтрокаПротокола);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)

	ОбновитьСписокНаСервере();

КонецПроцедуры

&НаСервере
Функция ВыгрузитьНаСервере()

	Отмеченные = Новый Соответствие;
	Для Каждого СтрокаСписка Из СписокСчетов Цикл
		Если СтрокаСписка.Отметка Тогда
			Отмеченные.Вставить(СтрокаСписка.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;

	Если Отмеченные.Количество() = 0 Тогда
		Отмеченные = Неопределено;
	КонецЕсли;

	Попытка
		Возврат ЭСВ_ЭкспортСчетов.ВыгрузитьСчета(Адрес, Топик, ДатаНачала, ДатаОкончания, Отмеченные);
	Исключение
		Сообщить("Ошибка выгрузки: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаСервере
Процедура ОбновитьСписокНаСервере()

	ЗаполнитьСписокНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокНаСервере()

	СписокСчетов.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Ссылка,
	|	Счета.Номер КАК Номер,
	|	Счета.Дата КАК Дата,
	|	Счета.Организация.Наименование КАК Организация,
	|	Счета.Контрагент.Наименование КАК Покупатель,
	|	Счета.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ._ДемоСчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|УПОРЯДОЧИТЬ ПО
	|	Счета.Дата
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	СУММА(Товары.Сумма) КАК Сумма
	|ИЗ
	|	Документ._ДемоСчетНаОплатуПокупателю.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|СГРУППИРОВАТЬ ПО
	|	Товары.Ссылка";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Результат = Запрос.ВыполнитьПакет();

	Суммы = Результат[1].Выгрузить();
	Суммы.Индексы.Добавить("Ссылка");

	Выборка = Результат[0].Выбрать();
	Пока Выборка.Следующий() Цикл

		СтрокаСумма = Суммы.Найти(Выборка.Ссылка, "Ссылка");
		СуммаДокумента = ?(СтрокаСумма = Неопределено, 0, СтрокаСумма.Сумма);

		Строка = СписокСчетов.Добавить();
		Строка.Номер = Выборка.Номер;
		Строка.Дата = Выборка.Дата;
		Строка.Организация = Выборка.Организация;
		Строка.Покупатель = Выборка.Покупатель;
		Строка.Сумма = СуммаДокумента;
		Строка.ПометкаУдаления = Выборка.ПометкаУдаления;
		Строка.Ключ = Выборка.Номер + "|" + XMLСтрока(Выборка.Дата);

	КонецЦикла;

КонецПроцедуры
