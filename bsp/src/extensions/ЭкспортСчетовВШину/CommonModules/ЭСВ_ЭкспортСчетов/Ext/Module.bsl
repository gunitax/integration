
// Экспорт счетов на оплату покупателю в топик Kafka.
// Внешняя компонента librdkafka подключается из общих макетов расширения
// СервиснаяШинаПредприятия (только её бинарные макеты, без вызова модулей).
// Формат сообщения: Key - "Номер|ДатаИСО", Value - JSON с шапкой и товарными строками.
//
#Область ПрограммныйИнтерфейс

// Выгружает счета за период в топик Kafka порциями по 100 сообщений.
//
// Параметры:
//  Адрес          - Строка - адреса брокеров Kafka, например "localhost:9092"
//  Топик          - Строка - имя топика, например "invoices"
//  ДатаНачала     - Дата   - начало периода по дате документа
//  ДатаОкончания  - Дата   - конец периода по дате документа
//  Отмеченные     - Соответствие - ключ "Номер|ДатаИСО" - Истина; отмеченные
//                   в форме счёта. Не задано или пустое - выгружаются все счёта
//                   за период (кроме пропускаемых по правилам).
//
// Возвращаемое значение:
//  Структура - Отправлено (Число), Ошибок (Число), Протокол (Массив строк)
//
Функция ВыгрузитьСчета(Знач Адрес, Знач Топик, Знач ДатаНачала, Знач ДатаОкончания, Знач Отмеченные = Неопределено) Экспорт

	Итоги = Новый Структура("Отправлено, Ошибок, Протокол", 0, 0, Новый Массив);

	Отправитель = СоздатьОтправителя(Адрес, Топик);

	ДанныеСчетов = СчетаЗаПериод(ДатаНачала, ДатаОкончания);

	Сообщения = Новый Массив;

	Для Каждого Шапка Из ДанныеСчетов.Шапки Цикл

		Ключ = КлючСчета(Шапка.Номер, Шапка.Дата);

		Если Шапка.ПометкаУдаления Тогда
			Итоги.Протокол.Добавить(СтрШаблон("Счёт %1 от %2 пропущен: помечен на удаление",
				Шапка.Номер, Формат(Шапка.Дата, "ДЛ=DD.MM.YYYY")));
			Продолжить;
		КонецЕсли;

		Если Отмеченные <> Неопределено И Отмеченные.Количество() > 0 И Отмеченные[Ключ] = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокиТоваров = ДанныеСчетов.Строки.НайтиСтроки(Новый Структура("Ссылка", Шапка.Ссылка));
		Если СтрокиТоваров.Количество() = 0 Тогда
			Итоги.Протокол.Добавить(СтрШаблон("Счёт %1 от %2 пропущен: нет товарных строк",
				Шапка.Номер, Формат(Шапка.Дата, "ДЛ=DD.MM.YYYY")));
			Продолжить;
		КонецЕсли;

		Сообщения.Добавить(СообщениеОСчете(Шапка, СтрокиТоваров));
		Если Сообщения.Количество() >= РазмерПорции() Тогда
			ОтправитьПорциюСПротоколом(Отправитель, Сообщения, Адрес, Итоги);
			Сообщения.Очистить();
		КонецЕсли;

	КонецЦикла;

	Если Сообщения.Количество() > 0 Тогда
		ОтправитьПорциюСПротоколом(Отправитель, Сообщения, Адрес, Итоги);
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ЭкспортСчетовВШину.ВыгрузкаСчетов",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Выгружено счетов: %1, записей протокола: %2", Итоги.Отправлено, Итоги.Протокол.Количество()));

	Возврат Итоги;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазмерПорции()

	Возврат 100;

КонецФункции

Функция КлючСчета(Знач Номер, Знач Дата)

	Возврат Номер + "|" + XMLСтрока(Дата);

КонецФункции

Функция СоздатьОтправителя(Знач Адрес, Знач Топик)

	ПодключитьВнешнююКомпонентуШины();

	Отправитель = Новый("AddIn.librdkafka.KafkaProducer");

	Если Отправитель.Initialize(Адрес, Топик, -1) <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Отправитель, "инициализации отправителя");
	КонецЕсли;

	Возврат Отправитель;

КонецФункции

// Возвращает пакет: шапки счетов за период и строки ТЧ Товары всех счетов периода.
//
Функция СчетаЗаПериод(Знач ДатаНачала, Знач ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Ссылка,
	|	Счета.Номер КАК Номер,
	|	Счета.Дата КАК Дата,
	|	Счета.Организация.Наименование КАК Организация,
	|	Счета.Контрагент.Наименование КАК Покупатель,
	|	Счета.ВалютаДокумента.Код КАК ВалютаКод,
	|	Счета.ВалютаДокумента.Наименование КАК ВалютаНаименование,
	|	Счета.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ._ДемоСчетНаОплатуПокупателю КАК Счета
	|ГДЕ
	|	Счета.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|УПОРЯДОЧИТЬ ПО
	|	Счета.Дата
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.Номенклатура.Артикул КАК Артикул,
	|	Товары.Номенклатура.Наименование КАК Наименование,
	|	Товары.Номенклатура.Штрихкод КАК Штрихкод,
	|	Товары.Количество КАК Количество,
	|	Товары.Цена КАК Цена,
	|	Товары.Сумма КАК Сумма
	|ИЗ
	|	Документ._ДемоСчетНаОплатуПокупателю.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|УПОРЯДОЧИТЬ ПО
	|	Товары.Ссылка.Дата,
	|	Товары.НомерСтроки";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Результат = Запрос.ВыполнитьПакет();

	// Обе выборки обходятся по индексу/поиску - выгружаем в таблицы значений
	Шапки = Результат[0].Выгрузить();
	Шапки.Индексы.Добавить("Ссылка");
	Строки = Результат[1].Выгрузить();
	Строки.Индексы.Добавить("Ссылка");

	Возврат Новый Структура("Шапки, Строки", Шапки, Строки);

КонецФункции

Функция СообщениеОСчете(Знач Шапка, Знач СтрокиТоваров)

	СуммаДокумента = 0;
	Товары = Новый Массив;

	Для Каждого СтрокаТовары Из СтрокиТоваров Цикл
		СуммаДокумента = СуммаДокумента + СтрокаТовары.Сумма;
		Товар = Новый Структура;
		Товар.Вставить("Артикул", СтрокаТовары.Артикул);
		Товар.Вставить("Наименование", СтрокаТовары.Наименование);
		Товар.Вставить("Штрихкод", СтрокаТовары.Штрихкод);
		Товар.Вставить("Количество", СтрокаТовары.Количество);
		Товар.Вставить("Цена", СтрокаТовары.Цена);
		Товар.Вставить("Сумма", СтрокаТовары.Сумма);
		Товары.Добавить(Товар);
	КонецЦикла;

	ДанныеСчета = Новый Структура;
	ДанныеСчета.Вставить("Номер", Шапка.Номер);
	ДанныеСчета.Вставить("Дата", XMLСтрока(Шапка.Дата));
	ДанныеСчета.Вставить("Организация", Новый Структура("Наименование", Шапка.Организация));
	ДанныеСчета.Вставить("Покупатель", Новый Структура("Наименование", Шапка.Покупатель));
	ДанныеСчета.Вставить("Валюта", Новый Структура("Код, Наименование", Шапка.ВалютаКод, Шапка.ВалютаНаименование));
	ДанныеСчета.Вставить("Сумма", СуммаДокумента);
	ДанныеСчета.Вставить("Товары", Товары);

	Сообщение = Новый Структура;
	Сообщение.Вставить("Headers", Новый Массив);
	Сообщение.Вставить("Key", КлючСчета(Шапка.Номер, Шапка.Дата));
	Сообщение.Вставить("Value", СтруктуруВJSON(ДанныеСчета));

	Возврат Сообщение;

КонецФункции

Процедура ОтправитьПорцию(Знач Отправитель, Знач Сообщения)

	СообщенияJSON = СтруктуруВJSON(Сообщения);

	Если Отправитель.SetJSONMessageList(СообщенияJSON) <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Отправитель, "загрузки сообщений в пул отправителя");
	КонецЕсли;

	Если Отправитель.Produce() <> Истина Тогда
		ВызватьИсключение ТекстОшибкиВК(Отправитель, "отправки данных");
	КонецЕсли;

	Если Не Отправитель.IsDelivered() Тогда
		ВызватьИсключение ОтчетОбОшибкахДоставки(Отправитель);
	КонецЕсли;

КонецПроцедуры

// Отправляет порцию и учитывает неудачу доставки в итогах: сообщения порции
// попадают в счётчик ошибок и в протокол с адресом брокера, выгрузка продолжается.
//
Процедура ОтправитьПорциюСПротоколом(Знач Отправитель, Знач Сообщения, Знач Адрес, Знач Итоги)

	Попытка
		ОтправитьПорцию(Отправитель, Сообщения);
		Итоги.Отправлено = Итоги.Отправлено + Сообщения.Количество();
	Исключение
		Итоги.Ошибок = Итоги.Ошибок + Сообщения.Количество();
		Итоги.Протокол.Добавить(СтрШаблон("порция из %1 сообщений не доставлена на %2: %3",
			Сообщения.Количество(), Адрес, ОписаниеОшибки()));
	КонецПопытки;

КонецПроцедуры

Функция ОтчетОбОшибкахДоставки(Знач Отправитель)

	ТекстОшибок = "";
	ОтчетJSON = Отправитель.GetJSONDeliveryReport();
	Если ОтчетJSON <> Неопределено Тогда
		Отчет = JSONВМассив(ОтчетJSON);
		Для Каждого Доставка Из Отчет Цикл
			Если Доставка.Error <> "Success" Тогда
				ТекстОшибок = ТекстОшибок + Символы.ПС + Доставка.Error;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат СтрШаблон("Ошибка доставки сообщений Kafka:%1", ТекстОшибок);

КонецФункции

Процедура ПодключитьВнешнююКомпонентуШины()

	// Внешняя компонента может быть уже подключена в сеансе (например, во внешнем соединении)
	Если ВнешняяКомпонентаДоступна() Тогда
		Возврат;
	КонецЕсли;

	СистемнаяИнформация = Новый СистемнаяИнформация;

	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_win32";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_win64";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_linux32";
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86_64 Тогда
		МакетКомпоненты = "ОбщийМакет.librdkafka_linux64";
	Иначе
		ВызватьИсключение "Не поддерживаемая архитектура платформы";
	КонецЕсли;

	Если Не ПодключитьВнешнююКомпоненту(МакетКомпоненты, "librdkafka", ТипВнешнейКомпоненты.Native) Тогда
		ВызватьИсключение "Ошибка подключения внешней компоненты librdkafka";
	КонецЕсли;

КонецПроцедуры

Функция ВнешняяКомпонентаДоступна()

	Попытка
		Проба = Новый("AddIn.librdkafka.KafkaProducer");
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ТекстОшибкиВК(Знач Отправитель, Знач Действие)

	Возврат СтрШаблон("Ошибка %1: %2", Действие, Отправитель.ErrorDescription);

КонецФункции

Функция СтруктуруВJSON(Знач Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция JSONВМассив(Знач СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Обертка = Новый Массив;
		Обертка.Добавить(Результат);
		Результат = Обертка;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
