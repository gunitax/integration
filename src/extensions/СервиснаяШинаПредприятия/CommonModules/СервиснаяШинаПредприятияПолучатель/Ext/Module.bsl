
#Область ПрограммныйИнтерфейс

// Процедура - Установить параметр глобальный
//
// Параметры:
//  КлючПараметра		 - Строка - Имя параметра 
//  ЗначениеПараметра	 - Строка - Значение параметра
//
//Устанавливает параметр глабольного контекста для получателя
//	Пример: КлючПараметра = socket.timeout.ms ЗначениеПараметра = 30000  
//!!Для применения установленных параметров - необходимка поторная инициализация получателя с помощью процедуры "Инициализировать"
//
Процедура УстановитьПараметрГлобальный(Знач КлючПараметра, Знач ЗначениеПараметра) Экспорт
	
	Если Получатель().SetGlobalConf(КлючПараметра, ЗначениеПараметра) <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Ошибка установки глобального параметра отправителя - %1';
			|en = 'Error setting global sender parameter - %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Установить параметр топика
//
// Параметры:
//  КлючПараметра		 - Строка - Имя параметра 
//  ЗначениеПараметра	 - Строка - Значение параметра
//
//Устанавливает параметр топика для получателя (Получатель) 
//	Пример: стрКлюч = auto.offset.reset стрЗначение = smallest  
//!!Для применения установленных параметров - необходимка поторная инициализация получателя с помощью процедуры "Инициализировать"
//
Процедура УстановитьПараметрТопика(Знач КлючПараметра, Знач ЗначениеПараметра) Экспорт
	
	Если Получатель().SetTopicConf(КлючПараметра, ЗначениеПараметра) <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Ошибка установки параметра топика - %1';
			|en = 'Error setting topic parameter - %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Сбросить параметры
//
//Сбрасывает установенные параметры топика и параметры глобального контекста (установленные процедурами УстановитьПараметрГлобальный, УстановитьПараметрТопика)
//!!Для применения - необходимка поторная инициализация получателя с помощью процедуры "Инициализировать"
//
Процедура СброситьПараметры() Экспорт
	
	Если Получатель().ConfReset() <> Истина Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка сброса параметров получателя - %1';
			|en = 'Receiver Reset Error - %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Инициализировать
//
// Параметры:
//  ПараметрыИнициализации	 - Структура - см. СервиснаяШинаПредприятияКлиентСервер.ПараметрыИнициализацииПолучателя()
//
Процедура Инициализировать(ПараметрыИнициализации) Экспорт
	
	Адрес					= ПараметрыИнициализации.Адрес;
	ИмяГруппыПолучателей	= ПараметрыИнициализации.ИмяГруппыПолучателей;
	
	Если Получатель().Initialize(Адрес, ИмяГруппыПолучателей) <> Истина Тогда
		ТекстСообщения = НСтр(
			"ru = 'Не удалось выполнить инициализацию получателя, возникла ошибка. %1';
			|en = 'Failed to initialize consumer, with an error. %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Подписаться
//
// Параметры:
//  Топики		 - Массив	 		- Массив строк, содержащих имена топиков, на которые необходимо подписаться 
//
//Выполняет подписку на список переданных топиков
//Необходимо вызывать после инициализации
//Предполагает автоматическое распределение партиций топиков на получателей внутри группы
// (т.е. если подписано на топик несколько получателей, с одной и той же группой - партиции будут распределены между ними брокером автоматически)
//
Процедура Подписаться(Знач Топики) Экспорт
	
	Получатель = Получатель();
	
	Если Получатель.ClearSubscribeList() <> Истина Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка очистки списка топиков: %1';
			|en = 'Topic list clearing error: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель.ErrorDescription);
	КонецЕсли;
	
	Для Каждого Топик Из Топики Цикл 
		Если Получатель.AddTopicToSubscribeList(Топик) <> Истина Тогда
			ТекстСообщения = НСтр(
				"ru = 'Ошибка добавления топика в список: %1';
				|en = 'Error adding topic to the list: %1'");
			ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель.ErrorDescription);
		КонецЕсли;	
	КонецЦикла;
	
	Если Получатель.Subscribe() <> Истина Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка подписания на топики: %1';
			|en = 'Error subscribing to topics: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель.ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Отписаться
//
//Отписывается от всех топиков, на которые ранее была выполнена подписка с помощью функции "Получатель_Подписаться"
//
Процедура Отписаться() Экспорт
	
	Если Получатель().Unsubscribe() <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Не удалось отписаться от топиков: %1';
			|en = 'Failed to unfollow topics: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Добавить назначение
//
// Параметры:
//  ПараметрыНазначения	 - Структура - см. СервиснаяШинаПредприятияКлиентСервер.ПараметрыНазначенияПолучателя() 
//
//Добавляет назначение в специальный список, внутри ВК
//Метод не назначает, а только добавляет назначение в специальный список внуутри ВК
//Непосредственное назначение выполняется процедурой "Назначить"
//   
Процедура ДобавитьНазначение(ПараметрыНазначения) Экспорт
	
	Топик		= ПараметрыНазначения.Топик;
	Раздел		= ПараметрыНазначения.Раздел;
	Смещение	= ПараметрыНазначения.Смещение;
	
	Если Получатель().AddRecordToTopicPartitionList(Топик, Раздел, Смещение) <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Ошибка добавления назначения: %1';
			|en = 'Error adding destination: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Очистить список назначений
//
//Очищает список назначений внутри ВК, сформированный посредствам вызова функции "ДобавитьНазначение"
//Прощедура не выполняет сброс назначений, а только очищает список внутри ВК, назначения сбрасываются процедурой "СброситьНазначения"
//
Процедура ОчиститьСписокНазначений() Экспорт
	
	Если Получатель().ClearTopicPartitionList() <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Ошибка очистки списка назначений: %1';
			|en = 'Destination List Clearing Error: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Назначить
//
//Выполняет назначения "марштрутов", для чтения из них данных
//Берет маршруты из внутреннего списка ВК, сформированного вызовами процедуры "ДобавитьНазначение"
//
Процедура Назначить() Экспорт
	
	Если Получатель().Assign() <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Ошибка назначения маршрутов: %1';
			|en = 'Route Assignment Error: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Сбросить назначения
//
//Выполняет сброс назначений, сделанных процедурой "Назначить"
//
Процедура СброситьНазначения() Экспорт
	
	Если Получатель().Unassign() <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Ошибка сброса назначений маршрутов: %1';
			|en = 'Error Resetting Route Assignments: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
		
КонецПроцедуры

// Прочитать список сообщений в пул
//	Читает список сообщений из брокера - цикл получения организован внутри ВК, что быстрее чем использование метода "ПрочитатьСообщенияВПул" 
//
// Параметры:
//  ПараметрыЧтения	 - Структура - см. СервиснаяШинаПредприятияКлиентСервер.ПараметрыЧтенияСообщений() 
// 
// Возвращаемое значение:
//	Число - Количество прочитанных сообщений
//
//Получает сообщения из брокера и помещает их во внутренний пул ВК, получение выполняется из "маршрутов", которые назначены получателю (c помощью фунцкии "Назначить") 
//или из разделов назначенных получателю брокером (для топиков, на которые выполнялась подписка с помощью функции "Подписаться")
//
//
//При подписании на топик - мы читаем из всех его партиций, и в какой-либо могут закочиться сообщения,
// а в любой другой - нет, при этом при чтении из той, где сообщения закончились - мы получим таймаут
// поэтому если мы подписывались на топик, а не назначали партицию для чтения - имеет смысл после первого таймаута
// - делать еще попытки, также таймауты могут быть при перебалансировке нагрузки брокером - RebalanceCb 
// - при подписке на топик еще одного получателя с такой же группой, как у текущего - партиции будут перераспределены
// брокером между получателями
//
Функция ПрочитатьСписокСообщенийВПул(ПараметрыЧтения) Экспорт
	
	Перем ОписаниеОшибки;
	
	Получатель = Получатель();
	Количество			= ПараметрыЧтения.Количество;
	ТаймаутЧтения		= ПараметрыЧтения.Таймаут;
	ОшибокДоПрерывания	= ПараметрыЧтения.ОшибокДоПрерывания;
	
	ЧтениеУспешно = (Получатель.ConsumePool(ТаймаутЧтения, Количество, ОшибокДоПрерывания) = 1);
	Если НЕ ЧтениеУспешно Тогда
		ОписаниеОшибки = Получатель.ОписанниеОшибки;
	КонецЕсли;
	
	Таймаут = (ОписаниеОшибки = "Local: Timed out") ИЛИ (ОписаниеОшибки = "Local queue is full");
	Успешно = (Таймаут ИЛИ ЧтениеУспешно) И НЕ Получатель.FatalError;
	
	Если НЕ Успешно Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка чтения сообщений в пул: %1';
			|en = 'Error reading messages to the pool: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, ОписаниеОшибки);	
	КонецЕсли;
	
	КоличествоПрочитано = Получатель.GetMessagePoolLength();		
	Возврат КоличествоПрочитано;
	
КонецФункции

// Получить сообщения из пула JSON
//
// Параметры:
//  ПолучатьBase64	 - Булево	 - Если ИСТИНА - тело сообщения, ключи и значения заголовков -  будут содержать строки в формате Base64 
// 
// Возвращаемое значение:
//	Строка - Сообщения в формате JSON
//
//Получает сообщения из внутреннего пула ВК в формате JSON
//Если сообщения содержат двоичные данные - необходимо вызывать функцию с флагом ПолучатьBase64 = ИСТИНА, иначе JSON сформировать не удастся
//
Функция ПолучитьСообщенияИзПулаJSON(Знач ПолучатьBase64) Экспорт
	
	Перем Сообщения;
	
	Получатель = Получатель();
	
	//Читаем из пула компоненты	
	Сообщения = Получатель.ReceiveJSONMessages(ПолучатьBase64);
	Если Сообщения = Неопределено Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка чтения сообщений из пула: %1';
			|en = 'Error reading messages from the pool: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель.ErrorDescription);
	КонецЕсли;	

	//Очищаем пул компоненты	
	Если Получатель.ClearMessagePool() <> Истина Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка очистки пула сообщений: %1';
			|en = 'Message pool cleanup error: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель.ErrorDescription);
	КонецЕсли;
	
	Возврат Сообщения;
	
КонецФункции

// Функция - Получить смещения раздела
//
// Параметры:
//  Топик		 - Строка - Имя топика
//  Раздел		 - Число - Номер раздела
//  Таймаут		 - Число - Время в миллисекундах после которого выполнение будет прервано
// 
// Возвращаемое значение:
//	Структура:
//	* Минимальное - Число - Минимальное смещение раздела
//	* Максимальное - Число - Максимальное смещение раздела
//           
//Возвращает минимальное и максимальное смещение раздела
//
Функция ПолучитьСмещенияРаздела(Знач Топик, Знач Раздел, Знач Таймаут) Экспорт
	
	Результат = Новый Структура();
	Результат.Вставить("Минимальное", -1);
	Результат.Вставить("Максимальное", -1);
	
	Результат = Получатель().QueryWatermarkOffsets(Топик, Раздел, Таймаут);
	Если Результат = Неопределено Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка получения смещения раздела топика: %1';
			|en = 'Error getting topic partition offset: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;	

	ДанныеРазбора = СервиснаяШинаПредприятияКлиентСервер.JSONВСтруктуру(Результат);
	
	Попытка 
		Результат.Минимальное = ДанныеРазбора.Low;
		Результат.Максимальное = ДанныеРазбора.Hight;
	Исключение
		ТекстСообщения = НСтр(
			"ru = 'Ошибка разбора сообщения';
			|en = 'Message parsing error'");
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;

	Возврат Результат;	

КонецФУнкции

// Функция - Получить текущее смещение раздела
//
// Параметры:
//  Топик		 - Строка - Имя топика
//  Раздел		 - Число - Номер раздела
//  Таймаут		 - Число - Время в миллисекундах после которого выполнение будет прервано 
// 
// Возвращаемое значение:
//	Число - Текущее смещение для группы 
//
//Получает текущее смещение раздела для группы
//
Функция ПолучитьТекущееСмещениеРаздела(Знач Топик, Знач Раздел, Знач Таймаут) Экспорт
	
	Смещение = Получатель().CommittedOffset(Топик, Раздел, Таймаут);
	Если Смещение = Неопределено Тогда
		ТекстСообщения = НСтр(
			"ru = 'Ошибка получения смещения раздела топика: %1';
			|en = 'Error getting topic partition offset: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;	

	Возврат Смещение;	

КонецФУнкции

// Процедура - Зафиксировать смещения
//
//Записывает в брокер последние прочитанные смещения разделов
//Нужно вызывать после вызовов функций чтения "ПолучитьСообщения", "ПрочитатьСписокСообщений", "ПолучитьСообщенияJSON"
//
Процедура ЗафиксироватьСмещения() Экспорт
	
	Если Получатель().Commit() <> Истина Тогда 
		ТекстСообщения = НСтр(
			"ru = 'Ошибка фиксации прочитанных смещений разделов: %1';
			|en = 'Error committing read partition offsets: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, Получатель().ErrorDescription);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Установить путь лог файла
//
// Путь к файлу лога указывается на сервере 1С слэш экранируется
// путь должен содержать имя конечного файла
// Пример: "C:\\Temp\\KafkaLOG\\" + ИмяТопика
//
// Для включения отладки нужно указать глобальный параметр получателя "debug"
//
Процедура УстановитьПутьЛогФайла(Путь) Экспорт
	
	Попытка
		Получатель().SetLogFilePath(Путь);
	Исключение
		ТекстСообщения = НСтр(
			"ru = 'Ошибка установки пути лог файла: %1';
			|en = 'Error setting log file path: %1'");
		ВызватьИсключение СтрШаблон(ТекстСообщения, ОписаниеОшибки());
	КонецПопытки;
		
КонецПроцедуры

Процедура Уничтожить() Экспорт

	ОбъектыСервиснойШиныПредприятия = ПолучитьИзВременногоХранилища(ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	ИмяПараметра = "ПолучательСообщенийИзШины";
	ОбъектыСервиснойШиныПредприятия[ИмяПараметра] = Неопределено;
	
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] = Неопределено Тогда
		ОбъектыСервиснойШиныПредприятия.Вставить(ИмяПараметра, Неопределено);
	КонецЕсли;
	
	ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия = ПоместитьВоВременноеХранилище(ОбъектыСервиснойШиныПредприятия, ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
КонецПроцедуры

#КонецОбласти

Функция Получатель()
	
	ОбъектыСервиснойШиныПредприятия = ПолучитьИзВременногоХранилища(ПараметрыСеанса.ОбъектыСервиснойШиныПредприятия);
	
	ИмяПараметра = "ВнешняяКомпонентаПодключена";
	Если ОбъектыСервиснойШиныПредприятия[ИмяПараметра] <> Истина Тогда
		ТекстСообщения = НСтр(
		"ru = 'Не подключена внешняя компонента'
		|en = 'External component not connected'");
		ВызватьИсключение ТекстСообщения;;
	КонецЕсли;
	
	ИмяПараметра = "ПолучательСообщенийИзШины";
	Получатель = ОбъектыСервиснойШиныПредприятия[ИмяПараметра];
	
	Если Получатель = Неопределено Тогда
		ТекстСообщения = НСтр(
		"ru = 'Не инициализирован получатель kafka'
		|en = 'Consumer kafka not initialized'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Возврат Получатель;
	
КонецФункции
