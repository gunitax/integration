
Функция МетодМенеджераОбъектаРеализован(ПолноеИмяОбъекта, ИмяМетода) Экспорт
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъекта);
	Если МенеджерОбъекта = Неопределено Тогда
        Возврат Ложь;
	КонецЕсли;
	
	Выражение = "МенеджерОбъекта." + ИмяМетода + "(,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,)";
	
	Попытка
        Выполнить(Выражение);
    Исключение
        Инфо = ИнформацияОбОшибке();
        Описание = Инфо.Описание;
    КонецПопытки;
	
	Результат = СтрНайти(НРег(Описание), "(" + НРег(ИмяМетода) + ")") = 0;
    Возврат Результат;

КонецФункции

// Функция - Метаданные в составе плана обмена
//
// Параметры:
//  ПолноеИмяМетаданных	 - Строка - Полное имя метаданных
// 
// Возвращаемое значение:
//	Булево - Истина если присутствует в составе обмена
//
Функция МетаданныеВСоставеПланаОбмена(ПолноеИмяМетаданных) Экспорт

	Метаданные_ = Метаданные.НайтиПоПолномуИмени(ПолноеИмяМетаданных);
	
	Возврат СервиснаяШинаПредприятия.Метаданные().Состав.Содержит(Метаданные_);

КонецФункции