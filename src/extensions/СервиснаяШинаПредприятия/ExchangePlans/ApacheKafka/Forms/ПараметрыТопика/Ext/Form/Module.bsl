
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыТопика = СервиснаяШинаПредприятияКлиентСервер.ПараметрыТопика();
	Если Параметры.ПараметрыТопика <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыТопика, Параметры.ПараметрыТопика);	
	КонецЕсли;
	
	Если Параметры.НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Входящий") Тогда
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыТопика.ПараметрыЧтения);	
		КоличествоВПорции = ПараметрыТопика.ПараметрыЧтения.Количество;
		
		Для Каждого ГлобальныйПараметр Из ПараметрыТопика.ГлобальныеПараметрыПолучателя Цикл
			ЗаполнитьЗначенияСвойств(ГлобальныеПараметрыПолучателя.Добавить(), ГлобальныйПараметр);	
		КонецЦикла;
		ГлобальныеПараметрыПолучателя.Сортировать("Ключ");
		
		Для Каждого Параметр Из ПараметрыТопика.ПараметрыПолучателя Цикл
			ЗаполнитьЗначенияСвойств(ПараметрыПолучателя.Добавить(), Параметр);	
		КонецЦикла;
		ПараметрыПолучателя.Сортировать("Ключ");
		
		Элементы.НастройкиОтправителя.Видимость = Ложь;
		
	ИначеЕсли Параметры.НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Исходящий") Тогда 
		
		Для Каждого ГлобальныйПараметр Из ПараметрыТопика.ГлобальныеПараметрыОтправителя Цикл
			ЗаполнитьЗначенияСвойств(ГлобальныеПараметрыОтправителя.Добавить(), ГлобальныйПараметр);	
		КонецЦикла;
		ГлобальныеПараметрыОтправителя.Сортировать("Ключ");		
		
		Для Каждого Параметр Из ПараметрыТопика.ПараметрыОтправителя Цикл
			ЗаполнитьЗначенияСвойств(ПараметрыОтправителя.Добавить(), Параметр);	
		КонецЦикла;
		ПараметрыОтправителя.Сортировать("Ключ");
		
		Элементы.НатройкиПолучателя.Видимость = Ложь;	
		
	Иначе
		Отказ = Истина;
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;    
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Модифицированность И Не ЗавершениеРаботы Тогда
		Отказ = Истина;
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаОтветаНаВопросПередЗакрытием", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, "Изменения не сохранены! Закрыть форму?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;		
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаНаВопросПередЗакрытием(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ГлобальныеПараметрыОтправителяЗначениеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ГлобальныеПараметрыОтправителя.ТекущиеДанные;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановкаГлобальногоПараметраОтправителя", ЭтотОбъект, Новый Структура("ИдентификаторПараметра", ТекущиеДанные.ПолучитьИдентификатор()));
    ПоказатьВводСтроки(ОписаниеОповещения, ТекущиеДанные.Значение,,, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаГлобальногоПараметраОтправителя(Строка, ДополнительныеПараметры) Экспорт
	
	Если Строка = Неопределено Тогда Возврат; КонецЕсли;
	
	ГлобальныйПараметр = ГлобальныеПараметрыОтправителя.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторПараметра);
	Если ГлобальныйПараметр <> Неопределено Тогда
		ГлобальныйПараметр.Значение = Строка;
		Модифицированность = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГлобальныеПараметрыПолучателяЗначениеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ГлобальныеПараметрыПолучателя.ТекущиеДанные;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановкаГлобальногоПараметраПолучателя", ЭтотОбъект, Новый Структура("ИдентификаторПараметра", ТекущиеДанные.ПолучитьИдентификатор()));
    ПоказатьВводСтроки(ОписаниеОповещения, ТекущиеДанные.Значение,,, Истина);

КонецПроцедуры

&НаКлиенте
Процедура УстановкаГлобальногоПараметраПолучателя(Строка, ДополнительныеПараметры) Экспорт
	
	Если Строка = Неопределено Тогда Возврат; КонецЕсли;
	
	ГлобальныйПараметр = ГлобальныеПараметрыПолучателя.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторПараметра);
	Если ГлобальныйПараметр <> Неопределено Тогда
		ГлобальныйПараметр.Значение = Строка;
		Модифицированность = Истина;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда) 
	
	ПараметрыТопика = СервиснаяШинаПредприятияКлиентСервер.ПараметрыТопика();
	ЗаполнитьЗначенияСвойств(ПараметрыТопика.ПараметрыЧтения, ЭтотОбъект);
	
	ПараметрыТопика.ПараметрыЧтения.Количество = КоличествоВПорции;
	
	ПараметрыТопика.ГлобальныеПараметрыПолучателя.Очистить();
	Для Каждого ГлобальныйПараметр Из ГлобальныеПараметрыПолучателя Цикл
		ПараметрыТопика.ГлобальныеПараметрыПолучателя.Вставить(ГлобальныйПараметр.Ключ, ГлобальныйПараметр.Значение);	
	КонецЦикла;
	
	ПараметрыТопика.ПараметрыПолучателя.Очистить();
	Для Каждого Параметр Из ПараметрыПолучателя Цикл
		ПараметрыТопика.ПараметрыПолучателя.Вставить(Параметр.Ключ, Параметр.Значение);	
	КонецЦикла;
	
	ПараметрыТопика.ГлобальныеПараметрыОтправителя.Очистить();
	Для Каждого ГлобальныйПараметр Из ГлобальныеПараметрыОтправителя Цикл
		ПараметрыТопика.ГлобальныеПараметрыОтправителя.Вставить(ГлобальныйПараметр.Ключ, ГлобальныйПараметр.Значение);	
	КонецЦикла;
	
	ПараметрыТопика.ПараметрыОтправителя.Очистить();
	Для Каждого Параметр Из ПараметрыОтправителя Цикл
		ПараметрыТопика.ПараметрыОтправителя.Вставить(Параметр.Ключ, Параметр.Значение);	
	КонецЦикла;
	
	Модифицированность = Ложь;

	ОповеститьОВыборе(ПараметрыТопика);
		
КонецПроцедуры 

#КонецОбласти