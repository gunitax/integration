
#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТопикиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Объект.Топики.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

	Если Поле.Имя = "ТопикиНаправлениеОбмена" Тогда
		СтандартнаяОбработка = Ложь;
		
		СледующееНаправление = Новый Соответствие;
		СледующееНаправление.Вставить(ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.ПустаяСсылка"), ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Исходящий")); 
		СледующееНаправление.Вставить(ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Исходящий"), ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Входящий")); 
		СледующееНаправление.Вставить(ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Входящий"), ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.ПустаяСсылка")); 
		
		ТекущиеДанные.НаправлениеОбмена = СледующееНаправление.Получить(ТекущиеДанные.НаправлениеОбмена);
		Модифицированность = Истина;
	ИначеЕсли Поле.Имя = "ПараметрыТопика" Тогда
		СтандартнаяОбработка = Ложь;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуРедактированияПараметровТопика", ЭтотОбъект, Новый Структура("НомерСтроки", ТекущиеДанные.НомерСтроки));
		Если Модифицированность Тогда
			ПоказатьВопрос(ОписаниеОповещения, "Требуется сохранить изменения перед открытием параметров топика. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Иначе
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да)
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТопикиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	Если НоваяСтрока Тогда  
		Элемент.ТекущиеДанные.УИДПотока = Неопределено;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьОбмен(Команда)
	ЗапуститьОбменНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗапуститьОбменНаСервере()

	ТекущиеДанные = Объект.Топики.НайтиПоИдентификатору(Элементы.Топики.ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ТекущиеДанные.Метаданные.ПолноеИмя);
	Если МетаданныеОбъекта = Неопределено Тогда Возврат; КонецЕсли;

	Если ТекущиеДанные.НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Входящий") Тогда
		ПараметрыТопика = ПолучитьПараметрыТопика(ТекущиеДанные.НомерСтроки);
		ПараметрыТопика.ИмяТопика = ТекущиеДанные.ИмяТопика;
		ПараметрыТопика.ПолноеИмяМетаданных = ТекущиеДанные.Метаданные.ПолноеИмя;
		
		ПолноеИмяМетаданных = ПараметрыТопика.ПолноеИмяМетаданных;
		
		Если Не (СервиснаяШинаПредприятияПовтИсп.МетодМенеджераОбъектаРеализован(ПолноеИмяМетаданных, "РазобратьВходящееСообщение")
			Или СервиснаяШинаПредприятияПовтИсп.МетодМенеджераОбъектаРеализован(ПолноеИмяМетаданных, "РазобратьВходящиеСообщенияСервиснойШины")) Тогда
			Возврат;
		КонецЕсли;
		
		КоличествоПотоковЧтения = ПараметрыТопика.ПараметрыЧтения.ПотоковЧтения;
		
		Для сч = 1 По КоличествоПотоковЧтения Цикл
			
			КлючФонового = "Сервисная шина: Прием """ + Объект.Код + """ " + ТекущиеДанные.ИмяТопика + " поток " + сч;
			Если СервиснаяШинаПредприятия.ЕстьАктивноеФоновоеЗадание(КлючФонового) Тогда Продолжить; КонецЕсли;
			
			ПараметрыФоновогоЗадания = Новый Массив;
			ПараметрыФоновогоЗадания.Добавить(Объект.Ссылка);
			ПараметрыФоновогоЗадания.Добавить(ПараметрыТопика);  
			ПараметрыФоновогоЗадания.Добавить(сч);
			
			ИмяМетода = "СервиснаяШинаПредприятия.ПолучитьИзмененияИзШиныПредприятия";
			
			ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыФоновогоЗадания, КлючФонового, КлючФонового);
		КонецЦикла;
		
	ИначеЕсли ТекущиеДанные.НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.НаправленияОбменаССервиснойШиной.Исходящий") Тогда
		
		// Создание контролирующего задания на отправку
		КлючФонового = "Сервисная шина: Отправка """ + Объект.Код + """ (менеджер потоков)";
		Если Не СервиснаяШинаПредприятия.ЕстьАктивноеФоновоеЗадание(КлючФонового) Тогда 
			
			ПараметрыФоновогоЗадания = Новый Массив;
			ПараметрыФоновогоЗадания.Добавить(Объект.Ссылка);
			
			ИмяМетода = "СервиснаяШинаПредприятия.ОтправитьИзмененияВШинуПредприятия";
			
			ФоновыеЗадания.Выполнить(ИмяМетода, ПараметрыФоновогоЗадания, КлючФонового, КлючФонового);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьИзменения(Команда)
	ЗарегистрироватьИзмененияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьИзмененияНаСервере()
	
	ТекущиеДанные = Объект.Топики.НайтиПоИдентификатору(Элементы.Топики.ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ТекущиеДанные.Метаданные.ПолноеИмя);
	Если МетаданныеОбъекта = Неопределено Тогда Возврат; КонецЕсли;

	ПланыОбмена.ЗарегистрироватьИзменения(Объект.Ссылка, МетаданныеОбъекта);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРегистрацию(Команда)
	УдалитьРегистрациюНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьРегистрациюНаСервере()
	ТекущиеДанные = Объект.Топики.НайтиПоИдентификатору(Элементы.Топики.ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ТекущиеДанные.Метаданные.ПолноеИмя);
	Если МетаданныеОбъекта = Неопределено Тогда Возврат; КонецЕсли;

	ПланыОбмена.УдалитьРегистрациюИзменений(Объект.Ссылка, МетаданныеОбъекта);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьФормуРедактированияПараметровТопика(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда Возврат; КонецЕсли;
	
	Если Модифицированность Тогда Записать(); КонецЕсли;
	
	ТекущиеДанные = Элементы.Топики.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;
	
	НомерСтроки = ДополнительныеПараметры.НомерСтроки;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПараметрыТопика", ПолучитьПараметрыТопика(НомерСтроки));
	ПараметрыФормы.Вставить("НаправлениеОбмена", ТекущиеДанные.НаправлениеОбмена);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьНовыеПараметрыТопика", ЭтотОбъект, Новый Структура("НомерСтроки", НомерСтроки));
	ОткрытьФорму("ПланОбмена.ApacheKafka.Форма.ПараметрыТопика", ПараметрыФормы, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыТопика(НомерСтроки)
	
	об = РеквизитФормыВЗначение("Объект");
	Топик = об.Топики.Получить(НомерСтроки - 1);
	
	Возврат СервиснаяШинаПредприятия.ПолучитьПараметрыТопика(Топик);	

КонецФункции

&НаКлиенте
Процедура УстановитьНовыеПараметрыТопика(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	УстановитьНовыеПараметрыТопикаНаСервере(Результат, ДополнительныеПараметры.НомерСтроки);
КонецПроцедуры

&НаСервере
Процедура УстановитьНовыеПараметрыТопикаНаСервере(ПараметрыТопика, НомерСтроки)
	
    об = РеквизитФормыВЗначение("Объект");
	ТекущаяСтрока = Элементы.Топики.ТекущаяСтрока;
	Топик = об.Топики.Получить(НомерСтроки - 1);
	
	Топик.ПараметрыТопика = Новый ХранилищеЗначения(ПараметрыТопика);
	об.Записать();
	Прочитать();
	
КонецПроцедуры

#КонецОбласти


